{
  "jobs": {
    "ci-plan": {
      "if": "github.event_name == 'workflow_dispatch' || github.event.pull_request.draft != true"
    },
    "docker-checks": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.docker_checks_required == 'true' && (needs.ci-plan.outputs.suite_depth == 'full'\n    || (needs.ci-plan.outputs.suite_depth == 'fast'\n        && needs.ci-plan.outputs.docker_checks_pr_required == 'true'))\n) ) )"
    },
    "parser-version-guard": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (\n  needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch'\n) && needs.ci-plan.outputs.package_checks_required == 'true' )"
    },
    "ci-generated-sources": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (needs.ci-plan.outputs.trusted == 'true' || github.event_name == 'workflow_dispatch') && needs.ci-plan.outputs.package_checks_required == 'true' )"
    },
    "ci-checks-docs": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && needs.ci-plan.outputs.trusted == 'true' && needs.ci-plan.outputs.docs_checks_required == 'true' )"
    },
    "ci-checks-generated": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (\n  needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch'\n) && needs.ci-plan.outputs.package_checks_required == 'true' )"
    },
    "ci-checks-policy": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (\n  needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch'\n) && needs.ci-plan.outputs.package_checks_required == 'true' )"
    },
    "ci-checks-rest": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (\n  needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch'\n) && needs.ci-plan.outputs.package_checks_required == 'true' )"
    },
    "ci-tests": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( (github.event_name != 'merge_group'\n || needs.ci-plan.outputs.queue_depth != 'thin')\n&& (\n  needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch'\n) && needs.ci-plan.outputs.package_checks_required == 'true' )"
    },
    "ci-browser": {
      "if": "needs.ci-plan.outputs.ci_browser_required == 'true'"
    },
    "code-quality-api": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (\n  needs.ci-plan.outputs.package_checks_required == 'true'\n  && (needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch')\n) )"
    },
    "code-quality-web": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (\n  needs.ci-plan.outputs.package_checks_required == 'true'\n  && (needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch')\n) )"
    },
    "code-quality-rest": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (\n  needs.ci-plan.outputs.package_checks_required == 'true'\n  && (needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch')\n) )"
    },
    "service-suites": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && (needs.ci-plan.outputs.service_suites_required == 'true' && (needs.ci-plan.outputs.trusted == 'true'\n    || github.event_name == 'workflow_dispatch')\n&& (needs.ci-plan.outputs.suite_depth == 'full'\n    || (needs.ci-plan.outputs.suite_depth == 'fast'\n        && needs.ci-plan.outputs.service_suites_pr_required == 'true'))\n) ) )"
    },
    "migration-upgrade-rehearsal": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.migration_rehearsal_required == 'true' && needs.ci-plan.outputs.suite_depth == 'full' ) ) )"
    },
    "release-typecheck": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((github.event_name == 'pull_request'\n || github.event_name == 'merge_group'\n || inputs.heavy_only == true)\n&& needs.ci-plan.outputs.release_typecheck_required == 'true' && needs.ci-plan.outputs.trusted == 'true' ) ) )"
    },
    "fix-tests-on-base": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name == 'pull_request' && contains(github.event.pull_request.labels.*.name, 'prove-fix') && needs.ci-plan.outputs.fix_tests_on_base_required == 'true' && needs.ci-plan.outputs.trusted == 'true' )"
    },
    "typecheck-baseline": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( inputs.heavy_only != true && (\n  needs.ci-plan.outputs.package_checks_required == 'true'\n  && (needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch')\n) )"
    },
    "web-build": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( inputs.heavy_only != true && (\n  (needs.ci-plan.outputs.trusted == 'true'\n  || github.event_name == 'workflow_dispatch')\n  && needs.ci-plan.outputs.web_build_required == 'true'\n) ) )"
    },
    "web-image-smoke": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.web_image_smoke_required == 'true' ) ) )"
    },
    "mobile-build": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.mobile_build_required == 'true' && needs.ci-plan.outputs.suite_depth == 'full' ) ) )"
    },
    "landing-build": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.landing_build_required == 'true' ) ) )"
    },
    "heavy-web-build": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && (needs.ci-plan.outputs.trusted == 'true' && needs.ci-plan.outputs.heavy_web_build_required == 'true' ) ) )"
    },
    "route-smoke": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && (always() && (github.event_name != 'merge_group' || !cancelled()) && needs.ci-plan.outputs.trusted == 'true' && needs.ci-plan.outputs.route_smoke_required == 'true' && (needs.web-build.result == 'success' || needs.heavy-web-build.result == 'success') && (github.event_name == 'merge_group' || inputs.heavy_only == true) ) ) )"
    },
    "e2e-production-shard": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && (always() && (github.event_name != 'merge_group' || !cancelled()) && (needs.ci-plan.outputs.trusted == 'true'\n    || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.e2e_production_required == 'true' && (needs.web-build.result == 'success' || needs.heavy-web-build.result == 'success') ) ) )"
    },
    "stack-redaction-browsers": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.stack_redaction_browsers_required == 'true' && needs.ci-plan.outputs.suite_depth == 'full' ) ) )"
    },
    "e2e-vite-canary": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.e2e_core_required == 'true' && needs.ci-plan.outputs.suite_depth == 'full' ) ) )"
    },
    "e2e-landing": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.e2e_landing_required == 'true' && needs.ci-plan.outputs.suite_depth == 'full' ) ) )"
    },
    "marketing-screenshots": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && (always() && (github.event_name != 'merge_group' || !cancelled()) && (needs.ci-plan.outputs.trusted == 'true'\n    || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.marketing_screenshots_required == 'true' && (needs.ci-plan.outputs.web_build_required != 'true'\n    || (needs.web-build.result == 'success' || needs.heavy-web-build.result == 'success'))\n) ) )"
    },
    "marketing-screenshots-cancel": {
      "if": "failure() && github.event_name == 'merge_group'"
    },
    "e2e-report": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( !cancelled() && needs.ci-plan.outputs.e2e_core_required == 'true' && (needs.e2e-production-shard.result == 'failure'\n    || needs.e2e-vite-canary.result == 'failure')\n) )"
    },
    "api-image-smoke": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.api_image_smoke_required == 'true' ) ) )"
    },
    "legal-atlas-image": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.legal_atlas_image_required == 'true' && (needs.ci-plan.outputs.suite_depth == 'full'\n    || (needs.ci-plan.outputs.suite_depth == 'fast'\n        && needs.ci-plan.outputs.legal_atlas_image_pr_required == 'true'))\n) ) )"
    },
    "windows-scripts": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.windows_scripts_required == 'true' ) ) )"
    },
    "desktop-clippy": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( github.event_name != 'pull_request' && ( needs.ci-plan.outputs.queue_depth != 'thin' && ((needs.ci-plan.outputs.trusted == 'true'\n || github.event_name == 'workflow_dispatch')\n&& needs.ci-plan.outputs.desktop_rust_checks_required == 'true' ) ) )"
    },
    "dependency-malware": {
      "if": "needs.ci-plan.outputs.run_required != 'false' && ( needs.ci-plan.outputs.queue_depth != 'thin' && (needs.ci-plan.outputs.trusted == 'true' && needs.ci-plan.outputs.dependency_malware_required == 'true') )"
    },
    "ci-result": {
      "if": "always()"
    }
  }
