{
  "name": "@stll/catalogue",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./install-payloads": {
      "types": "./src/install-payloads.ts",
      "import": "./src/install-payloads.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    },
    "./pinned-facts": {
      "types": "./scripts/pinned-content-facts.ts",
      "import": "./scripts/pinned-content-facts.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "generate": "bun scripts/generate-manifest.ts",
    "validate": "bun scripts/validate.ts",
    "check-upstream": "bun scripts/check-upstream.ts",
    "check-pinned": "bun --preload ../../scripts/offline-network-preload.ts scripts/check-pinned-content.ts --check",
    "test": "bun scripts/generate-manifest.ts --check && bun scripts/validate.ts && bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/catalogue",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/catalogue",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "refresh-pinned": "bun scripts/check-pinned-content.ts --refresh"
  },
  "dependencies": {
    "better-result": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@stll/concurrency": "workspace:*",
    "@stll/sha256": "workspace:*",
    "@stll/skills": "workspace:*",
    "@stll/stable-stringify": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
