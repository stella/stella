{
  "name": "@stll/legal-atlas",
  "version": "0.0.0",
  "private": true,
  "description": "Legal corpus runner registry, corpus document kinds, and provision-citation grammars",
  "keywords": [
    "case-law",
    "corpus",
    "legal",
    "legislation",
    "parser"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/legal-atlas",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/legal-atlas"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./corpus": {
      "types": "./src/corpus.ts",
      "import": "./src/corpus.ts"
    },
    "./cz-provision-citation-profile": {
      "types": "./src/cz-provision-citation-profile.ts",
      "import": "./src/cz-provision-citation-profile.ts"
    },
    "./provision-citation-grammars": {
      "types": "./src/provision-citation-grammars.ts",
      "import": "./src/provision-citation-grammars.ts"
    },
    "./provision-citation-profile": {
      "types": "./src/provision-citation-profile.ts",
      "import": "./src/provision-citation-profile.ts"
    },
    "./provision-key": {
      "types": "./src/provision-key.ts",
      "import": "./src/provision-key.ts"
    },
    "./provision-citation-profiles": {
      "types": "./src/provision-citation-profiles.ts",
      "import": "./src/provision-citation-profiles.ts"
    },
    "./provision-extraction-admission": {
      "types": "./src/provision-extraction-admission.ts",
      "import": "./src/provision-extraction-admission.ts"
    },
    "./runners/registry": {
      "types": "./src/runners/registry.ts",
      "import": "./src/runners/registry.ts"
    },
    "./sk-provision-citation-profile": {
      "types": "./src/sk-provision-citation-profile.ts",
      "import": "./src/sk-provision-citation-profile.ts"
    },
    "./document-fetch-diagnostics": {
      "types": "./src/document-fetch-diagnostics.ts",
      "import": "./src/document-fetch-diagnostics.ts"
    },
    "./document-stage-observer": {
      "types": "./src/document-stage-observer.ts",
      "import": "./src/document-stage-observer.ts"
    },
    "./sk-document-fetch-diagnostics": {
      "types": "./src/sk-document-fetch-diagnostics.ts",
      "import": "./src/sk-document-fetch-diagnostics.ts"
    },
    "./ingestion-cycle": {
      "types": "./src/ingestion-cycle.ts",
      "import": "./src/ingestion-cycle.ts"
    },
    "./provision-version-grammar": {
      "types": "./src/provision-version-grammar.ts",
      "import": "./src/provision-version-grammar.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/legal-atlas",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/legal-atlas",
    "format": "bun ../../scripts/run-oxfmt.ts ."
  },
  "dependencies": {
    "@stll/api-contract": "workspace:*",
    "@stll/concurrency": "workspace:*",
    "@stll/legal-ast": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "better-result": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/sha256": "workspace:^",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  }
}
