{
  "name": "@stll/user-agent",
  "version": "0.0.0",
  "private": true,
  "description": "browser and OS names parsed from a user-agent string for session and device lists",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
