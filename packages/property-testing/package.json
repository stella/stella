{
  "name": "@stll/property-testing",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./src/preload.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./commonmark-code-oracle": "./src/commonmark-code-oracle.ts",
    "./preload": "./src/preload.ts",
    "./rejection": "./src/rejection.ts",
    "./response-order": "./src/response-order.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/property-testing",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/property-testing"
  },
  "dependencies": {
    "@stll/portable-path": "workspace:*",
    "@stll/sha256": "workspace:*",
    "better-result": "catalog:",
    "fast-check": "catalog:"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "oxc-parser": "catalog:"
  }
}
