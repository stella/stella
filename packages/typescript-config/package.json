{
  "name": "@stll/typescript-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared strict TypeScript configuration for stella packages.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "exports": {
    "./base.json": "./base.json",
    "./library.json": "./library.json",
    "./published.json": "./published.json",
    "./node.json": "./node.json",
    "./bun.json": "./bun.json",
    "./react-library.json": "./react-library.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/typescript-config",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/typescript-config",
    "format": "bun ../../scripts/run-oxfmt.ts ."
  },
  "devDependencies": {
    "bun-types": "catalog:"
  }
}
