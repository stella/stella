{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "stella base",
  "compilerOptions": {
    // One checker per project, not the default four. Parallel checkers hold
    // independent type caches and are assigned files by position, so each one
    // re-instantiates the Eden treaty surface cold; TypeScript abandons any
    // statement that instantiates more than five million types and yields
    // `any`, flooding blameless files with `any`/`unknown` errors that move
    // whenever a file is added. `packages/scripts/src/tsc-native.ts` documents
    // the mechanics and passes `--singleThreaded` for the `typecheck` scripts;
    // oxlint-tsgolint runs the same checker with no such flag, so the option
    // has to live in the config both drivers read. One checker is also cheaper
    // in time and memory: parallel checkers duplicate the instantiations.
    "checkers": 1,
    "allowJs": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "checkJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "lib": ["ESNext"],
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "preserveSymlinks": true,
    "incremental": true,
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.json",
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true
  }
}
