{
  "name": "@stll/docx-utils",
  "version": "0.1.5",
  "description": "Low-level helpers for reading and writing DOCX/OOXML zip packages: text and binary extraction, relationship and content-type management, and namespace constants.",
  "keywords": [
    "docx",
    "ooxml",
    "openxml",
    "relationships",
    "word",
    "zip"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/docx-utils",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/docx-utils"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./office-formats": "./src/office-formats.ts",
    "./office-metadata": "./src/office-metadata.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "build": "tsdown",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun test src",
    "check:office-fixture-metadata": "bun scripts/check-office-fixture-metadata.ts",
    "test:office-fixture-metadata": "bun test scripts/check-office-fixture-metadata.test.ts",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/docx-utils",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/docx-utils",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "prepack": "bun run build",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')"
  },
  "dependencies": {
    "better-result": "catalog:",
    "jszip": "catalog:",
    "slimdom": "^4.3.5"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:",
    "tsdown": "catalog:"
  }
}
