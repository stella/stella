{
  "name": "@stll/invoicing",
  "version": "0.1.0",
  "private": true,
  "description": "Invoice document totals and Czech payment payloads.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./pay-by-square": "./src/pay-by-square.ts",
    "./ksef": "./src/ksef/client.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/invoicing",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/invoicing"
  },
  "dependencies": {
    "@stll/agent-input": "workspace:*",
    "@stll/api-contract": "workspace:*",
    "@stll/money": "workspace:*",
    "@stll/sha256": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "better-result": "catalog:",
    "lzma1": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "bysquare": "4.1.0",
    "fast-check": "catalog:",
    "xmllint-wasm": "catalog:"
  }
}
