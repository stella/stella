{
  "name": "@stll/scan-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Document scan cleanup engine (Rust, WebAssembly)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf pkg target .cache .turbo node_modules",
    "test": "bun test src && cargo test",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/scan-engine",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/scan-engine",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "format:rust": "cargo fmt",
    "build:wasm": "bash scripts/build-wasm.sh"
  },
  "dependencies": {
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
