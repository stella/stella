{
  "name": "@stll/scan-engine",
  "version": "0.1.0",
  "description": "Document scan cleanup engine (Rust, WebAssembly): deskew, content crop and binarization off the main thread, plus a per-page review state machine",
  "keywords": [
    "binarization",
    "deskew",
    "document",
    "scan",
    "wasm",
    "webassembly",
    "worker"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/scan-engine",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/scan-engine"
  },
  "files": [
    "dist",
    "src",
    "generated",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/scan-engine.ts",
    "./review": "./src/review.ts",
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist target .cache .turbo node_modules",
    "build": "tsdown",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun run test:bun && cargo test",
    "test:bun": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/scan-engine",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/scan-engine",
    "format:rust": "cargo fmt",
    "build:wasm": "bash scripts/build-wasm.sh",
    "check:wasm": "bun --preload ../../scripts/offline-network-preload.ts scripts/check-wasm.ts",
    "generate:fixtures": "bun scripts/generate-fixtures.ts",
    "check:fixtures": "bun scripts/generate-fixtures.ts --check",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@stll/fetch": "workspace:^",
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "tsdown": "catalog:"
  }
}
