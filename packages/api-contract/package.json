{
  "name": "@stll/api-contract",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser-control": "./src/browser-control.ts",
    "./browser-control-json-schema": "./src/browser-control-json-schema.ts",
    "./chat": "./src/chat.ts",
    "./json-schema-regex": "./src/json-schema-regex.ts",
    "./chat-docx-suggestions": "./src/chat-docx-suggestions.ts",
    "./chat-file-types": "./src/chat-file-types.ts",
    "./case-law-court-tiers": "./src/case-law-court-tiers.ts",
    "./case-law-decision-resolution": "./src/case-law-decision-resolution.ts",
    "./case-law-decision-route": "./src/case-law-decision-route.ts",
    "./case-law-launch-readiness": "./src/case-law-launch-readiness.ts",
    "./case-law-judges": "./src/case-law-judges.ts",
    "./case-law-jurisdictions": "./src/case-law-jurisdictions.ts",
    "./case-law-text-field": "./src/case-law-text-field.ts",
    "./decision-docket-grammar": "./src/decision-docket-grammar.ts",
    "./decision-query-intent": "./src/decision-query-intent.ts",
    "./desktop-registry": "./src/desktop-registry.ts",
    "./desktop-rpc": "./src/desktop-rpc.gen.ts",
    "./document-translation": "./src/document-translation.ts",
    "./email-mime-types": "./src/email-mime-types.ts",
    "./entity-views": "./src/entity-views.ts",
    "./feedback": "./src/feedback.ts",
    "./entity-options": "./src/entity-options.ts",
    "./folio-collab": "./src/folio-collab.ts",
    "./legal-reader-annotations": "./src/legal-reader-annotations.ts",
    "./legislation-status": "./src/legislation-status.ts",
    "./legislation-publication": "./src/legislation-publication.ts",
    "./matter-activity": "./src/matter-activity.ts",
    "./notifications": "./src/notifications.ts",
    "./safe-id": "./src/safe-id.ts",
    "./search": "./src/search.ts",
    "./time-entry-types": "./src/time-entry-types.ts",
    "./us-courts": "./src/us-courts.ts",
    "./time-entries": "./src/time-entries.ts",
    "./us-reporter-citation": "./src/us-reporter-citation.ts",
    "./user-file-url": "./src/user-file-url.ts",
    "./signals": "./src/signals.ts",
    "./sse-heartbeat": "./src/sse-heartbeat.ts",
    "./statute-route": "./src/statute-route.ts",
    "./workflow-status": "./src/workflow-status.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlF 'fc.assert' src --include='*.test.ts')",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware packages/api-contract",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/api-contract",
    "format": "bun ../../scripts/run-oxfmt.ts ."
  },
  "dependencies": {
    "@stll/anonymize-chat": "workspace:*",
    "@stll/template-conditions": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "@stll/time": "workspace:*",
    "@stll/uuid-codec": "workspace:*",
    "@valibot/to-json-schema": "^1.8.0",
    "better-result": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  }
}
