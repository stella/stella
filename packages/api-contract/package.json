{
  "name": "@stll/api-contract",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat.ts",
    "./chat-file-types": "./src/chat-file-types.ts",
    "./document-translation": "./src/document-translation.ts",
    "./entity-options": "./src/entity-options.ts",
    "./legislation-status": "./src/legislation-status.ts",
    "./matter-activity": "./src/matter-activity.ts",
    "./safe-id": "./src/safe-id.ts",
    "./time-entry-types": "./src/time-entry-types.ts",
    "./time-entries": "./src/time-entries.ts",
    "./workflow-status": "./src/workflow-status.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlF 'fc.assert' src --include='*.test.ts')",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware packages/api-contract",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/api-contract",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@stll/anonymize-chat": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  }
}
