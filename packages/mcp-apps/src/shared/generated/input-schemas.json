{
  "search_case_law": {
    "type": "object",
    "required": ["queries", "country"],
    "additionalProperties": false,
    "properties": {
      "queries": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "minItems": 1,
        "maxItems": 5
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12450
      },
      "court": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "courts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "minItems": 1,
        "maxItems": 16
      },
      "category": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "has_legal_sentence": {
        "type": "boolean"
      },
      "country": {
        "type": "string",
        "maxLength": 64
      },
      "language": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8
      },
      "decision_type": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "source_id": {
        "type": "string",
        "format": "uuid"
      },
      "date_from": {
        "type": "string",
        "format": "date",
        "maxLength": 10
      },
      "date_to": {
        "type": "string",
        "format": "date",
        "maxLength": 10
      },
      "sort": {
        "enum": ["relevance", "newest"],
        "type": "string"
      },
      "strict": {
        "type": "boolean"
      }
    }
  },
  "resolve_case_law_decision": {
    "type": "object",
    "required": ["country", "identifier"],
    "additionalProperties": false,
    "properties": {
      "country": {
        "type": "string",
        "maxLength": 64
      },
      "identifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "open_case_law_decision": {
    "type": "object",
    "required": ["decision_id"],
    "additionalProperties": false,
    "properties": {
      "decision_id": {
        "type": "string",
        "format": "uuid"
      },
      "paragraphs": {
        "type": "string",
        "maxLength": 33,
        "pattern": "^\\d+(?:[-\\u2013]\\d+)?$"
      }
    }
  },
  "read_case_law_decision_blocks": {
    "type": "object",
    "required": ["decision_id"],
    "additionalProperties": false,
    "properties": {
      "decision_id": {
        "type": "string",
        "format": "uuid"
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  },
  "preview_cited_provision": {
    "type": "object",
    "required": ["provision"],
    "additionalProperties": false,
    "properties": {
      "provision": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "cited_anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": ["document_id", "anchor"],
        "additionalProperties": false
      }
    }
  },
  "read_provision_history": {
    "type": "object",
    "required": ["eli", "anchor"],
    "additionalProperties": false,
    "properties": {
      "eli": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "anchor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "language": {
        "type": "string",
        "minLength": 2,
        "maxLength": 8
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "text_cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}
