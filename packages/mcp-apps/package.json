{
  "name": "@stll/mcp-apps",
  "version": "0.0.0",
  "private": true,
  "description": "MCP app frontends served by the API",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./manifest": "./src/manifest.ts",
    "./resource-uri": "./src/resource-uri.ts",
    "./shared/contracts": "./src/shared/generated/contracts.js",
    "./shared/input-schemas": "./src/shared/generated/input-schemas.json",
    "./document-upload/upload-target": "./src/document-upload/upload-target.ts",
    "./bundles": "./src/generated/bundles.ts",
    "./case-law-results/model": "./src/case-law-results/model.ts",
    "./case-law-results/parse": "./src/case-law-results/parse.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun ../../scripts/prepare-mcp-apps.ts && bun test",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts' --include='*.test.tsx')",
    "typecheck": "bun ../../scripts/prepare-mcp-apps.ts && bun check --no-pretty --all --project=tsconfig.json && bun check --no-pretty --all --project=src/shared/generated/tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/mcp-apps",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/mcp-apps",
    "prepack": "bun run build",
    "build": "bun ../../scripts/prepare-mcp-apps.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@stll/agent-input": "workspace:*",
    "@stll/api-contract": "workspace:*",
    "@stll/collation": "workspace:*",
    "@stll/decision-reader": "workspace:*",
    "@stll/errors": "workspace:*",
    "@stll/fetch": "workspace:*",
    "@stll/legal-ast": "workspace:*",
    "@stll/locales": "workspace:*",
    "@stll/sha256": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "@stll/time": "0.4.1",
    "@stll/ui": "workspace:*",
    "@tanstack/charts": "catalog:",
    "better-result": "catalog:",
    "d3-scale": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "use-intl": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@stll/portable-path": "workspace:*",
    "@stll/property-testing": "workspace:*",
    "@stll/scripts": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/d3-scale": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "bun-types": "catalog:",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "fast-check": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:"
  }
}
