{
  "name": "@stll/sha256",
  "private": true,
  "description": "Private SHA-256 hashing for Bun, Node, and browser runtimes",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/encoding.ts",
    "./bun": "./src/bun.ts",
    "./node": "./src/node.ts",
    "./browser": "./src/browser.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/sha256",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/sha256",
    "format": "bun ../../scripts/run-oxfmt.ts ."
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
