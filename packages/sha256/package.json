{
  "name": "@stll/sha256",
  "version": "0.0.0",
  "private": true,
  "description": "Private SHA-256 hashing for Bun, Node, and browser runtimes",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/encoding.ts",
    "./bun": "./src/bun.ts",
    "./node": "./src/node.ts",
    "./browser": "./src/browser.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun scripts/lint.ts packages/sha256",
    "lint:fix": "cd ../.. && bun scripts/lint.ts --fix packages/sha256"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
