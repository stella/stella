{
  "name": "@stll/anonymize-benchmark",
  "version": "0.0.0",
  "description": "Reproducible comparison of stella/anonymize against open-source PII redaction libraries across public development and held-out evaluation corpora",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "bun ../../scripts/tsc-native.ts --noEmit -p tsconfig.json",
    "test": "bun test",
    "format": "oxfmt . \"!results/**\" \"!vendor/**\"",
    "bench:compare": "bun src/bench.ts",
    "bench:blind": "bun src/blind.ts",
    "bench:sealed:tab": "bun src/blind.ts --full",
    "bench:sealed:redactionbench": "bun src/redactionbench.ts",
    "bench:sealed:meddocan": "bun src/meddocan.ts",
    "bench:sealed:multigrassco": "bun src/multigrassco.ts",
    "bench:sealed:german-ler": "bun src/german-ler.ts",
    "bench:sealed:german-ler:assisted": "bun src/german-ler.ts --assisted",
    "bench:sealed": "bun src/suite.ts",
    "bench:dev-gap": "bun src/dev-gap.ts",
    "bench:redactionbench": "bun src/redactionbench.ts",
    "bench:meddocan": "bun src/meddocan.ts",
    "bench:multigrassco": "bun src/multigrassco.ts",
    "bench:german-ler": "bun src/german-ler.ts",
    "bench:german-ler:assisted": "bun src/german-ler.ts --assisted",
    "bench:dev:nym-assisted": "bun src/nym-assisted-dev.ts",
    "bench:suite": "bun src/suite.ts",
    "bench:performance": "bun src/performance/run.ts",
    "bench:performance:providers": "bun src/performance/providers/run.ts"
  },
  "dependencies": {
    "@openredaction/core": "1.1.5",
    "@stll/anonymize": "workspace:^",
    "@stll/anonymize-data": "^0.0.10",
    "fflate": "0.8.3",
    "hyparquet": "1.29.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "bun-types": "1.4.0",
    "typescript": "7.0.2"
  }
}
