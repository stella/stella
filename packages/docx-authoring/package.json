{
  "name": "@stll/docx-authoring",
  "version": "0.0.0",
  "private": true,
  "description": "stella-styled Word documents from Markdown, a document model or a transcript, for the API and the desktop",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./document": "./src/document.ts",
    "./markdown": "./src/markdown.ts",
    "./transcript": "./src/transcript.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun scripts/lint.ts packages/docx-authoring",
    "lint:fix": "cd ../.. && bun scripts/lint.ts --fix packages/docx-authoring"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  },
  "dependencies": {
    "@stll/docx-core": "catalog:",
    "@stll/folio-core": "catalog:",
    "better-result": "catalog:"
  }
}
