{"access":"write","consumesServices":false,"description":"Create an issuer profile for the active organization. The first active profile becomes the default; later profiles can be made default explicitly. vatPayer (default false) says whether invoices from this issuer charge VAT; it requires a vatId.","destructive":false,"feature":"FEATURE_TIME_BILLING","featureAccess":"required","featureId":"time-billing","handlerKind":"root","id":"seller-profiles.create","inputSchema":{"body":{"properties":{"accountNumber":{"maxLength":64,"type":"string"},"addressLine1":{"maxLength":512,"type":"string"},"addressLine2":{"maxLength":512,"type":"string"},"barRegistration":{"maxLength":10000,"type":"string"},"bic":{"maxLength":11,"pattern":"^[A-Za-z]{6}[A-Za-z0-9]{2}([A-Za-z0-9]{3})?$","type":"string"},"city":{"maxLength":256,"type":"string"},"country":{"maxLength":128,"type":"string"},"defaultCurrency":{"maxLength":3,"minLength":3,"pattern":"^[A-Z]{3}$","type":"string"},"email":{"description":"Where replies to invoices sent by email go; without it, they go to the member who sent the invoice.","format":"email","maxLength":320,"type":"string"},"footerNotes":{"maxLength":10000,"type":"string"},"iban":{"maxLength":42,"minLength":15,"type":"string"},"legalName":{"maxLength":512,"minLength":1,"type":"string"},"postalCode":{"maxLength":32,"type":"string"},"registerEntry":{"maxLength":10000,"type":"string"},"registrationId":{"maxLength":64,"type":"string"},"taxId":{"maxLength":64,"type":"string"},"vatId":{"maxLength":64,"type":"string"},"vatPayer":{"description":"Whether the issuer charges VAT. Requires a VAT ID; a registered person who is not a VAT payer has a VAT ID but sets this to false.","type":"boolean"}},"required":["legalName","defaultCurrency"],"type":"object"}},"mcp":{"reason":"billing_admin","type":"capability"},"permissions":{"organizationSettings":["update"]},"scope":"stella:billing_write","transport":{"type":"json"}}
