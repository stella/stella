{"access":"write","consumesServices":false,"description":"Detach time entries and expenses from a draft invoice, removing their invoice lines, returning them to approved, unbilled status, and recomputing the invoice totals. Reversible: the same entries can be attached again with invoices.entries.add, and the entries themselves are kept. Only draft invoices may be changed, and ids that are not on this invoice are skipped without an error.","destructive":false,"feature":"FEATURE_TIME_BILLING","featureAccess":"required","featureId":"time-billing","handlerKind":"workspace","id":"invoices.entries.remove","inputSchema":{"body":{"properties":{"expenseIds":{"items":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"expense","x-stella-resource-usage":"reference"},"maxItems":500,"minItems":1,"type":"array"},"timeEntryIds":{"items":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"timeEntry","x-stella-resource-usage":"reference"},"maxItems":500,"minItems":1,"type":"array"}},"type":"object"},"params":{"properties":{"invoiceId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"invoice","x-stella-resource-usage":"reference"},"matterId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"workspace","x-stella-resource-usage":"reference"}},"required":["matterId","invoiceId"],"type":"object"}},"mcp":{"reason":"billing_admin","type":"capability"},"permissions":{"invoice":["update"]},"scope":"stella:billing_write","transport":{"type":"json"}}
