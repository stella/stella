{"access":"write","consumesServices":true,"description":"Start an extraction workflow in a matter, filling the AI columns of the documents that need it. Narrow it with entityIds and propertyIds, set the processing order with entityIdsOrder, and choose serviceTier standard or flex, where flex is the cheaper deferred tier and is refused when the configured provider does not offer it. Returns the run's status, including already-running when one is in flight.","destructive":false,"handlerKind":"workspace","id":"matters.workflow.start","inputSchema":{"body":{"properties":{"entityIds":{"items":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"entity","x-stella-resource-usage":"reference"},"maxItems":10000,"type":"array"},"entityIdsOrder":{"items":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"entity","x-stella-resource-usage":"reference"},"maxItems":10000,"type":"array"},"propertyIds":{"items":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"property","x-stella-resource-usage":"reference"},"maxItems":300,"type":"array"},"serviceTier":{"anyOf":[{"const":"standard","type":"string"},{"const":"flex","type":"string"}]}},"type":"object"}},"mcp":{"reason":"workflow_orchestration","type":"capability"},"permissions":{"workspace":["update"]},"scope":"stella:matters_write","transport":{"type":"json"}}
