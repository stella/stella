{"access":"write","confirmation":"required","consumesServices":false,"description":"Email an issued invoice to the given addresses as a secure stella link to view and download it; replies go to the seller profile's email. A finalized invoice becomes sent. Refused for drafts and void invoices. Each send makes a new link; see invoices.sends.list.","destructive":false,"feature":"FEATURE_TIME_BILLING","featureAccess":"required","featureId":"time-billing","handlerKind":"workspace","id":"invoices.sends.create","inputSchema":{"body":{"additionalProperties":false,"properties":{"message":{"description":"A short note shown in the email.","maxLength":2000,"type":"string"},"recipients":{"description":"Addresses to email the link to, at most 10. Nothing goes to an address not named here.","items":{"format":"email","maxLength":254,"type":"string"},"maxItems":10,"minItems":1,"type":"array"}},"required":["recipients"],"type":"object"},"params":{"properties":{"invoiceId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"invoice","x-stella-resource-usage":"reference"},"matterId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"workspace","x-stella-resource-usage":"reference"}},"required":["matterId","invoiceId"],"type":"object"}},"mcp":{"reason":"billing_admin","type":"capability"},"permissions":{"invoice":["update"]},"scope":"stella:billing_write","transport":{"type":"json"}}
