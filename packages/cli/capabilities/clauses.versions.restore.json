{"access":"write","consumesServices":false,"description":"Restore a stored clause version by copying its body onto the clause as a new version. History is append-only: the older versions stay and the version number moves forward rather than back. The body is read server-side from the version id, never supplied by the caller. Refused when the clause is at its version limit. Optionally pass expectedBody from your last read to require the head still matches before restoring.","destructive":false,"handlerKind":"root","id":"clauses.versions.restore","inputSchema":{"body":{"properties":{"expectedBody":{"items":{"additionalProperties":true,"properties":{"text":{"maxLength":10485760,"type":"string"}},"required":["text"],"type":"object"},"maxItems":100000,"minItems":1,"type":"array"}},"type":"object"},"params":{"properties":{"clauseId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"clause","x-stella-resource-usage":"reference"},"versionId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"clauseVersion","x-stella-resource-usage":"reference"}},"required":["clauseId","versionId"],"type":"object"}},"mcp":{"reason":"knowledge_library_admin","type":"capability"},"permissions":{"clause":["update"]},"scope":"stella:knowledge_write","transport":{"type":"json"}}
