{"access":"write","consumesServices":false,"description":"Change one line of a draft invoice and recompute its totals. Any line accepts description, quantity, unit price, and VAT overrides without changing the source time entry or expense. Set resetToRecorded to true alone to restore the recorded description, quantity, unit and price. Recorded values remain available for reporting. A flat-fee line keeps its snapshotted quantity, unit, and price; its description and VAT may change. Omitted fields stay unchanged. Only drafts that have never been issued can be edited; issued invoices require a credit note, even after reverting to draft.","destructive":false,"feature":"FEATURE_TIME_BILLING","featureAccess":"required","featureId":"time-billing","handlerKind":"workspace","id":"invoices.lines.update","inputSchema":{"body":{"properties":{"description":{"maxLength":10000,"minLength":1,"type":"string"},"exemptionReason":{"anyOf":[{"maxLength":500,"minLength":1,"pattern":"\\S","type":"string"},{"type":"null"}]},"quantity":{"description":"Non-negative decimal quantity with a dot and at most four decimals, e.g. \"1.5\"","pattern":"^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,4})?$","type":"string"},"resetToRecorded":{"const":true,"type":"boolean"},"unit":{"anyOf":[{"maxLength":32,"minLength":1,"type":"string"},{"type":"null"}]},"unitPriceMinor":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"vatRateBps":{"description":"VAT rate in basis points: 2100 is 21 %","maximum":10000,"minimum":0,"type":"integer"},"vatTreatment":{"enum":["domestic_vat","not_vat_payer","outside_scope","reverse_charge","exempt"],"type":"string"}},"type":"object"},"params":{"properties":{"invoiceId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"invoice","x-stella-resource-usage":"reference"},"lineId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA