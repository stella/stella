{"access":"write","consumesServices":false,"description":"Attach approved, billable, not-yet-invoiced time entries and expenses to a draft invoice as invoice lines without VAT, marking them billed and recomputing the invoice totals. Every entry must match the invoice currency, because an invoice is single-currency and nothing is converted. Only draft invoices accept entries, and a concurrent change to the same entries fails with a retryable conflict rather than attaching part of the set.","destructive":false,"feature":"FEATURE_TIME_BILLING","featureAccess":"required","featureId":"time-billing","handlerKind":"workspace","id":"invoices.entries.add","inputSchema":{"body":{"properties":{"expenseIds":{"items":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"expense","x-stella-resource-usage":"reference"},"maxItems":500,"minItems":1,"type":"array"},"timeEntryIds":{"items":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"timeEntry","x-stella-resource-usage":"reference"},"maxItems":500,"minItems":1,"type":"array"}},"type":"object"},"params":{"properties":{"invoiceId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"invoice","x-stella-resource-usage":"reference"},"matterId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"workspace","x-stella-resource-usage":"reference"}},"required":["matterId","invoiceId"],"type":"object"}},"mcp":{"reason":"billing_admin","type":"capability"},"permissions":{"invoice":["update"]},"scope":"stella:billing_write","transport":{"type":"json"}}
