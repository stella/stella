{"access":"write","consumesServices":false,"description":"Link a clause from the library into a template, optionally pinning one of its variants and naming the clause slot it fills. The link records the clause's version as it is now, so later edits to the clause do not reach the template until it is synced. Refused once the template holds its maximum number of clause links.","destructive":false,"handlerKind":"root","id":"templates.clauses.link","inputSchema":{"body":{"properties":{"clauseId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"clause","x-stella-resource-usage":"reference"},"slotName":{"maxLength":128,"type":"string"},"variantId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"clauseVariant","x-stella-resource-usage":"reference"}},"required":["clauseId"],"type":"object"},"params":{"properties":{"templateId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"template","x-stella-resource-usage":"reference"}},"required":["templateId"],"type":"object"}},"mcp":{"reason":"template_authoring_ui","type":"capability"},"permissions":{"template":["update"]},"scope":"stella:templates","transport":{"type":"json"}}
