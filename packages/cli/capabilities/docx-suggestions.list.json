{"access":"read","consumesServices":false,"description":"List the redline suggestions queued on one document, oldest first: each suggestion's id, its document operation, comment, severity, area, status (pending, accepted, rejected) and origin (chat or review). Filter by status to find what still awaits a decision; pass a suggestion id to docx-suggestions.resolve or docx-suggestions.revert.","destructive":false,"handlerKind":"workspace","id":"docx-suggestions.list","inputSchema":{"params":{"properties":{"entityId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"entity","x-stella-resource-usage":"reference"},"matterId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"workspace","x-stella-resource-usage":"reference"}},"required":["matterId","entityId"],"type":"object"},"query":{"properties":{"cursor":{"description":"Opaque cursor from a previous page to fetch the next page","maxLength":512,"type":"string"},"limit":{"maximum":200,"minimum":1,"type":"integer"},"status":{"enum":["pending","accepted","rejected"],"type":"string"}},"type":"object"}},"mcp":{"reason":"document_processing","type":"capability"},"permissions":{"workspace":["read"]},"readClass":"tenant","scope":"stella:read","transport":{"type":"json"}}
