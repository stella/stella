{"access":"write","consumesServices":false,"description":"Set a document's value for a property (a cell in the matter's table). Pass the document entityId, the propertyId (from list_properties), and a content object whose 'type' matches the property's value type: text (value: string), single-select (value: string or null), multi-select (value: array of strings), date (value: ISO YYYY-MM-DD or null), or int (value: integer, optional currency: 3-letter ISO code). An empty value clears the cell.","destructive":false,"handlerKind":"workspace","id":"fields.upsert","inputSchema":{"body":{"properties":{"content":{"anyOf":[{"properties":{"type":{"const":"text","description":"Value type; must match the property's value type","type":"string"},"value":{"type":"string"},"version":{"const":1,"type":"number"}},"required":["version","type","value"],"type":"object"},{"properties":{"type":{"const":"single-select","description":"Value type; must match the property's value type","type":"string"},"value":{"anyOf":[{"type":"string"},{"type":"null"}],"nullable":true},"version":{"const":1,"type":"number"}},"required":["version","type","value"],"type":"object"},{"properties":{"type":{"const":"multi-select","description":"Value type; must match the property's value type","type":"string"},"value":{"items":{"minLength":1,"type":"string"},"type":"array"},"version":{"const":1,"type":"number"}},"required":["version","type","value"],"type":"object"},{"properties":{"type":{"const":"date","description":"Value type; must match the property's value type","type":"string"},"value":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"nullable":true},"version":{"const":1,"type":"number"}},"required":["version","type","value"],"type":"object"},{"properties":{"currency":{"anyOf":[{"description":"For int values only: 3-letter ISO currency code, or null","maxLength":3,"minLength":3,"pattern":"^[A-Za-z]{3}$","type":"string"},{"type":"null"}],"nullable":true},"type":{"const":"int","description":"Value type; must match the property's value type","type":"string"},"value":{"type":"integer"},"version":{"const":1,"type":"number"}},"required":["version","type","value","currency"],"type":"object"},{"properties":{"amountCents":{"description":"Amount in the currency's minor units","type":"integer"},"currency":{"description":"3-letter ISO currency code","maxLength":3,"minLength":3,"pattern":"^[A-Za-z]{3}$","type":"string"},"type":{"const":"money","description":"Value type; must match the property's value type","type":"string"},"version":{"const":1,"type":"number"}},"required":["version","type","amountCents","currency"],"type":"object"},{"properties":{"image":{"type":"null"},"name":{"const":"","type":"string"},"type":{"const":"person","description":"Empty person sentinel that clears the property value","type":"string"},"userId":{"type":"null"},"version":{"const":1,"type":"number"}},"required":["version","type","userId","name","image"],"type":"object"},{"properties":{"image":{"anyOf":[{"maxLength":2048,"type":"string"},{"type":"null"}],"nullable":true},"name":{"maxLength":256,"minLength":1,"type":"string"},"type":{"const":"person","description":"Value type; must match the property's value type","type":"string"},"userId":{"anyOf":[{"maxLength":128,"minLength":1,"type":"string"},{"type":"null"}],"nullable":true},"version":{"const":1,"type":"number"}},"required":["version","type","userId","name","image"],"type":"object"},{"properties":{"citation":{"maxLength":1000,"type":"string"},"jurisdiction":{"maxLength":128,"type":"string"},"snippet":{"maxLength":10000,"type":"string"},"sourceType":{"maxLength":64,"type":"string"},"type":{"const":"clip","type":"string"},"url":{"maxLength":2048,"type":"string"},"version":{"const":1,"type":"number"}},"required":["version","type","url"],"type":"object"}],"description":"The value to set; 'type' must match the property."},"entityId":{"description":"Document entity ID whose cell to set","maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"entity","x-stella-resource-usage":"reference"},"propertyId":{"description":"Property ID, as returned by list_properties","maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"property","x-stella-resource-usage":"reference"}},"required":["propertyId","entityId","content"],"type":"object"}},"mcp":{"name":"set_field_value","type":"tool"},"permissions":{"entity":["create","update"]},"scope":"stella:documents_write","transport":{"type":"json"}}
