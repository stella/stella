{"access":"write","consumesServices":false,"description":"Set the manual flags and lock state of one cell, meaning one document's value for one property. manualFlags is merged against baseManualFlags rather than overwritten, so flags added or removed by someone else since you read the cell survive; when no flags remain and the cell is not locked, the metadata row is deleted. Use fields.upsert to change the cell's value itself, and fields.column-flag.update to flag a whole column at once.","destructive":false,"handlerKind":"workspace","id":"fields.cell-metadata.update","inputSchema":{"body":{"properties":{"baseManualFlags":{"items":{"default":"needs-review","enum":["needs-review","important","follow-up","contradiction","verified"],"type":"string"},"maxItems":5,"type":"array"},"entityId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"entity","x-stella-resource-usage":"reference"},"locked":{"type":"boolean"},"manualFlags":{"items":{"default":"needs-review","enum":["needs-review","important","follow-up","contradiction","verified"],"type":"string"},"maxItems":5,"type":"array"},"propertyId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"property","x-stella-resource-usage":"reference"}},"required":["propertyId","entityId","manualFlags"],"type":"object"}},"mcp":{"reason":"workspace_schema","type":"capability"},"permissions":{"entity":["update"]},"scope":"stella:matters_write","transport":{"type":"json"}}
