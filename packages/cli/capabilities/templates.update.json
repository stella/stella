{"access":"write","consumesServices":false,"description":"Change a template's record: name, category, tags, languages, whenToUse and whenNotToUse guidance. Only the fields you pass are written. The fields a template asks for live in its document, so change those by storing a new body with templates.document.update or by calling configure_template_fields.","destructive":false,"handlerKind":"root","id":"templates.update","inputSchema":{"body":{"properties":{"categoryId":{"anyOf":[{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"templateCategory","x-stella-resource-usage":"reference"},{"type":"null"}],"nullable":true},"languages":{"items":{"maxLength":35,"type":"string"},"maxItems":4,"type":"array"},"name":{"maxLength":256,"minLength":1,"type":"string"},"tags":{"items":{"maxLength":64,"minLength":1,"type":"string"},"maxItems":32,"type":"array"},"whenNotToUse":{"anyOf":[{"maxLength":10000,"type":"string"},{"type":"null"}],"nullable":true},"whenToUse":{"anyOf":[{"maxLength":10000,"type":"string"},{"type":"null"}],"nullable":true}},"type":"object"},"params":{"properties":{"templateId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"template","x-stella-resource-usage":"reference"}},"required":["templateId"],"type":"object"}},"mcp":{"reason":"template_authoring_ui","type":"capability"},"permissions":{"template":["update"]},"scope":"stella:templates","transport":{"type":"json"}}
