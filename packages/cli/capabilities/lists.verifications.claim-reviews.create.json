{"access":"write","consumesServices":false,"description":"Record one reviewer action on a claim of a list verification and return the claim's review after it. `status` marks the claim reviewed, disputed, or needs-evidence (open until the record can answer it; null clears it); `override` annotates the verdict with the reviewer's own state, beside the tool's, never replacing it; `note` sets the review note; `reopen` reclassifies a set-aside claim as checkable; `record-conflict` resolves a claim withheld between two records by naming the governing fact or escalating it; the event also keeps which record was suggested to govern then (a document's record over a witness's account; see suggestedGoverningFactId in lists.verifications.get). `override`, `reopen` and `record-conflict` change the verdict and require `reason` (the reviewer's words, kept in the claim's history); `status` takes an optional `reason`. Reopening and resolving a conflict withdraw an earlier status and override.","destructive":false,"feature":"FEATURE_LEGAL_LISTS","featureAccess":"required","featureId":"list-verification","handlerKind":"workspace","id":"lists.verifications.claim-reviews.create","idempotency":{"type":"replay"},"inputSchema":{"body":{"properties":{"claimId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"legalListClaim","x-stella-resource-usage":"reference"},"event":{"anyOf":[{"additionalProperties":false,"properties":{"kind":{"const":"status","type":"string"},"reason":{"maxLength":10000,"minLength":1,"type":"string"},"status":{"anyOf":[{"enum":["reviewed","disputed","needs-evidence"],"type":"string"},{"type":"null"}]}},"required":["kind","status"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"override","type":"string"},"reason":{"maxLength":10000,"minLength":1,"type":"string"},"state":{"anyOf":[{"enum":["supported","tension","contradicted","nocover","notverifiable"],"type":"string"},{"type":"null"}]}},"required":["kind","state","reason"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"note","type":"string"},"note":{"maxLength":10000,"type":"string"}},"required":["kind","note"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"reopen","type":"string"},"reason":{"maxLength":10000,"minLength":1,"type":"string"}},"required":["kind","reason"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"record-conflict","type":"string"},"reason":{"maxLength":10000,"minLength":1,"type":"string"},"resolution":{"anyOf":[{"anyOf":[{"additionalProperties":false,"properties":{"factEntityId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"entity","x-stella-resource-usage":"reference"},"kind":{"const":"governed","type":"string"}},"required":["kind","factEntityId"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"escalated","type":"string"}},"required":["kind"],"type":"object"}]},{"type":"null"}]}},"required":["kind","resolution","reason"],"type":"object"}]},"runId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string","x-stella-resource-kind":"legalListVerificationRun","x-stella-resource-usage":"reference"}},"required":["runId","claimId","event"],"type":"object"}},"mcp":{"reason":"document_processing","type":"capability"},"permissions":{"entity":["update"]},"scope":"stella:matters_write","transport":{"type":"json"}}
