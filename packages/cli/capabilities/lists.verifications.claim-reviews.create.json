{"access":"write","consumesServices":false,"description":"Record one reviewer action on a claim of a list verification and return the claim's review after it. `status` marks the claim reviewed or disputed (null clears it); `override` annotates the verdict with the reviewer's own state, beside the tool's, never replacing it; `note` sets the review note; `reopen` reclassifies a set-aside claim as checkable; `record-conflict` resolves a claim withheld between two records by naming the governing fact or escalating it. Reopening and resolving a conflict withdraw an earlier status and override.","destructive":false,"feature":"FEATURE_LEGAL_LISTS","featureAccess":"required","featureId":"list-verification","handlerKind":"workspace","id":"lists.verifications.claim-reviews.create","inputSchema":{"body":{"properties":{"claimId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string"},"event":{"anyOf":[{"additionalProperties":false,"properties":{"kind":{"const":"status","type":"string"},"status":{"anyOf":[{"default":"reviewed","enum":["reviewed","disputed"],"type":"string"},{"type":"null"}],"nullable":true}},"required":["kind","status"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"override","type":"string"},"state":{"anyOf":[{"default":"supported","enum":["supported","tension","contradicted","nocover","notverifiable"],"type":"string"},{"type":"null"}],"nullable":true}},"required":["kind","state"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"note","type":"string"},"note":{"maxLength":10000,"type":"string"}},"required":["kind","note"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"reopen","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"record-conflict","type":"string"},"resolution":{"anyOf":[{"anyOf":[{"additionalProperties":false,"properties":{"factEntityId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string"},"kind":{"const":"governed","type":"string"}},"required":["kind","factEntityId"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"escalated","type":"string"}},"required":["kind"],"type":"object"}]},{"type":"null"}],"nullable":true}},"required":["kind","resolution"],"type":"object"}]},"runId":{"maxLength":36,"minLength":36,"pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$","type":"string"}},"required":["runId","claimId","event"],"type":"object"}},"mcp":{"reason":"document_processing","type":"capability"},"permissions":{"entity":["update"]},"scope":"stella:matters_write","transport":{"type":"json"}}
