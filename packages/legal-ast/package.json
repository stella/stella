{
  "name": "@stll/legal-ast",
  "version": "0.0.0",
  "private": true,
  "description": "Typed AST shapes for legal documents, statutes, and shared inline legal text",
  "keywords": [
    "ast",
    "case-law",
    "legal",
    "legislation",
    "parser"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/legal-ast",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/legal-ast"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./analysis": {
      "types": "./src/analysis.ts",
      "import": "./src/analysis.ts"
    },
    "./case-law-heading": {
      "types": "./src/case-law-heading.ts",
      "import": "./src/case-law-heading.ts"
    },
    "./citation-passage": {
      "types": "./src/citation-passage.ts",
      "import": "./src/citation-passage.ts"
    },
    "./citation-prefix": {
      "types": "./src/citation-prefix.ts",
      "import": "./src/citation-prefix.ts"
    },
    "./czech-document-roles": {
      "types": "./src/czech-document-roles.ts",
      "import": "./src/czech-document-roles.ts"
    },
    "./decision-identifier": {
      "types": "./src/decision-identifier.ts",
      "import": "./src/decision-identifier.ts"
    },
    "./document-ast": {
      "types": "./src/document-ast.ts",
      "import": "./src/document-ast.ts"
    },
    "./inline": {
      "types": "./src/inline.ts",
      "import": "./src/inline.ts"
    },
    "./provision-preview": {
      "types": "./src/provision-preview.ts",
      "import": "./src/provision-preview.ts"
    },
    "./provision-reference": {
      "types": "./src/provision-reference.ts",
      "import": "./src/provision-reference.ts"
    },
    "./slovak-document-roles": {
      "types": "./src/slovak-document-roles.ts",
      "import": "./src/slovak-document-roles.ts"
    },
    "./statute-ast": {
      "types": "./src/statute-ast.ts",
      "import": "./src/statute-ast.ts"
    },
    "./text-sanitize": {
      "types": "./src/text-sanitize.ts",
      "import": "./src/text-sanitize.ts"
    },
    "./text-spans": {
      "types": "./src/text-spans.ts",
      "import": "./src/text-spans.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlF 'fc.assert' src --include='*.test.ts')",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware packages/legal-ast",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/legal-ast",
    "format": "bun ../../scripts/run-oxfmt.ts ."
  },
  "dependencies": {
    "@stll/text-normalize": "workspace:*",
    "better-result": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  }
}
