{
  "name": "@stll/test-kit",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./src/forbid-network.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db-clock.ts",
    "./forbid-network": "./src/forbid-network.ts",
    "./request": "./src/request.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/test-kit",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/test-kit",
    "format": "bun ../../scripts/run-oxfmt.ts ."
  },
  "dependencies": {
    "@stll/time": "workspace:*",
    "@tanstack/react-start": "^1.168.60",
    "better-result": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
