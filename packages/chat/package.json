{
  "name": "@stll/chat",
  "version": "0.1.38",
  "description": "Typed React chat composer, message stream, model selector, and transport runtime primitives.",
  "keywords": [
    "ai",
    "chat",
    "react",
    "streaming"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/chat",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/chat"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./composer": "./src/composer.tsx",
    "./model-selector": "./src/model-selector.tsx",
    "./runtime": "./src/runtime.ts",
    "./stream": "./src/stream.tsx",
    "./durable-transport": "./src/durable-transport.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "build": "tsdown",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun test src",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/chat",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/chat",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@stll/ai-catalog": "workspace:^",
    "@stll/api-contract": "workspace:*",
    "@stll/ui": "workspace:^",
    "@tanstack/ai-client": "catalog:",
    "better-result": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@types/react": "catalog:react19",
    "bun-types": "catalog:",
    "fast-check": "catalog:",
    "react": "catalog:react19",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "@types/react": ">=19",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
