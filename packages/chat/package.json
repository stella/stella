{
  "name": "@stll/chat",
  "version": "0.2.12",
  "description": "Typed React chat composer, message stream, model selector, and transport runtime primitives.",
  "keywords": [
    "ai",
    "chat",
    "react",
    "streaming"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/chat",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/chat"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./composer": "./src/composer.tsx",
    "./model-selector": "./src/model-selector.tsx",
    "./runtime": "./src/runtime.ts",
    "./stream": "./src/stream.tsx",
    "./durable-transport": "./src/durable-transport.ts",
    "./resume-contract": "./src/resume-contract.ts",
    "./link": "./src/link.tsx",
    "./link-detection": "./src/link-detection.ts",
    "./link-editor": "./src/link-editor.ts",
    "./link-markdown": "./src/link-markdown.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "build": "tsdown",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/chat",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/chat",
    "prepack": "bun run build",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@stll/ai-catalog": "workspace:^",
    "@stll/ui": "workspace:^",
    "@tanstack/ai-client": "catalog:",
    "@types/hast": "^3.0.5",
    "better-result": "catalog:",
    "linkify-it": "6.1.0",
    "tldts": "7.4.19",
    "valibot": "catalog:",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@types/react": "catalog:react19",
    "bun-types": "catalog:",
    "fast-check": "catalog:",
    "react": "catalog:react19",
    "tsdown": "catalog:",
    "tsrs": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@types/react": ">=19",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
