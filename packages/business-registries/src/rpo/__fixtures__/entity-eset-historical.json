  "authorizations": [
    {
      "value": "V mene spoločnosti voči tretím osobám konajú a podpisujú vždy dvaja konatelia spoločne. V mene spoločnosti konatelia podpisujú tak, že k napísanému alebo vytlačenému obchodnému menu spoločnosti pripoja dvaja konatelia svoj podpis, pričom pri podpise musí byť vždy uvedené slovo „konateľ“.",
      "validFrom": "2022-02-16"
    },
    {
      "value": "Rozsah udelenej prokúry: všetky právne úkony spoločnosti podľa § 14 ods. 1 Obchodného zákonníka. Prokurista podpisuje za spoločnosť tak, že k vytlačenému alebo napísanému obchodnému menu spoločnosti pripojí dodatok označujúci prokúru a svoj podpis.",
      "validFrom": "2016-03-03",
      "validTo": "2024-01-03"
    }
