{
  "name": "@stll/business-registries",
  "version": "0.3.2",
  "description": "Typed clients for national business / commercial registries (Czech ARES, Norwegian Brreg, Mexican INEGI DENUE, US SEC EDGAR, Slovak ORSR, Taiwanese GCIS, Finnish PRH, Polish KRS, UK Companies House, French INSEE Sirene, ...)",
  "keywords": [
    "ares",
    "brreg",
    "business-register",
    "commercial-register",
    "companies-house",
    "company-lookup",
    "denue",
    "edgar",
    "gcis",
    "inegi",
    "krs",
    "legal",
    "obchodny-register",
    "orsr",
    "prh",
    "registry",
    "sec",
    "sirene",
    "sudreg",
    "vat",
    "vies",
    "zefix"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/business-registries",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/business-registries"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ares": "./src/ares/index.ts",
    "./browser": "./src/browser.ts",
    "./brreg": "./src/brreg/index.ts",
    "./cnpj": "./src/cnpj/index.ts",
    "./companies-house": "./src/companies-house/index.ts",
    "./cpf": "./src/cpf/index.ts",
    "./denue": "./src/denue/index.ts",
    "./edgar": "./src/edgar/index.ts",
    "./gcis": "./src/gcis/index.ts",
    "./krs": "./src/krs/index.ts",
    "./orsr": "./src/orsr/index.ts",
    "./prh": "./src/prh/index.ts",
    "./recherche-entreprises": "./src/recherche-entreprises/index.ts",
    "./vies": "./src/vies/index.ts",
    "./shared": "./src/shared/index.ts",
    "./sudreg": "./src/sudreg/index.ts",
    "./zefix": "./src/zefix/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "build": "rm -rf dist && bun ../../packages/scripts/src/tsc-native.ts -p tsconfig.build.json",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun test src",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware packages/business-registries",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/business-registries",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@stll/country-codes": "workspace:*",
    "@stll/stdnum": "^2.3.2",
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
