{
  "name": "@stll/scripts",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "glossary-gen": "src/glossary-gen.ts",
    "i18n-check": "src/i18n-check.ts",
    "i18n-lint": "src/i18n-lint.ts",
    "i18n-typegen": "src/i18n-typegen.ts"
  },
  "type": "module",
  "exports": {
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/scripts",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/scripts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@stll/ai-catalog": "workspace:*",
    "@stll/api-contract": "workspace:*",
    "@stll/fetch": "workspace:*",
    "@stll/locales": "workspace:*",
    "@stll/permissions": "workspace:*",
    "@stll/portable-path": "workspace:*",
    "@stll/sha256": "workspace:*",
    "@stll/skills": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "@stll/time": "0.4.1",
    "better-result": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-transform-react": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  }
}
