{
  "name": "@stll/transcript",
  "version": "0.0.0",
  "private": true,
  "description": "Pure transcript timing, vocabulary and text exports",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/transcript.ts",
    "./timeline": "./src/timeline.ts",
    "./exporters": "./src/exporters.ts",
    "./vocabulary": "./src/vocabulary.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/transcript",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/transcript"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  },
  "dependencies": {
    "@stll/text-normalize": "workspace:*",
    "better-result": "catalog:",
    "valibot": "catalog:"
  }
}
