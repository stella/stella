    "words": ["Novák"],
    "expected": "Nováková přijde"
  },
  {
    "name": "another word too far off stays",
    "text": "pan Novy",
    "words": ["Novák"],
    "expected": "pan Novy"
  },
  {
    "name": "a short word changes in case",
    "text": "firma stll",
    "words": ["STLL"],
    "expected": "firma STLL"
  },
  {
    "name": "a short word a letter off stays",
    "text": "firma stil",
    "words": ["STLL"],
    "expected": "firma stil"
  },
  {
    "name": "very short custom words are left alone",
    "text": "ano, to je ono",
    "words": ["ANO"],
    "expected": "ano, to je ono"
  },
  {
    "name": "only whole words change",
    "text": "dvorackova a dvoracek",
    "words": ["Dvořák"],
    "expected": "dvorackova a dvoracek"
  },
  {
    "name": "phrases match word for word",
