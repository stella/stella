    "expected": "„Novák“, (Dvořák)!"
  },
  {
    "name": "the right spelling changes nothing",
    "text": "pan Novák",
    "words": ["Novák"],
    "expected": "pan Novák"
  },
  {
    "name": "no words change nothing",
    "text": "pan novak",
    "words": [],
    "expected": "pan novak"
  },
  {
    "name": "a number a digit off stays",
