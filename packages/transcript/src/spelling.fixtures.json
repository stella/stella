  },
  {
    "name": "the whole phrase wins over one of its words",
    "text": "baker mckenzie",
    "words": ["Baker", "Baker McKenzie"],
    "expected": "Baker McKenzie"
  },
  {
    "name": "punctuation between the words is no phrase",
