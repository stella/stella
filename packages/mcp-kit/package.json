{
  "name": "@stll/mcp-kit",
  "version": "0.2.0",
  "description": "Framework-free MCP tool registry, compact schemas, and lazy capability discovery",
  "keywords": [
    "discovery",
    "json-schema",
    "mcp",
    "tools"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/mcp-kit",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/mcp-kit"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "build": "tsdown",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun test src",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/mcp-kit",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/mcp-kit",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@stll/agent-input": "workspace:^",
    "@stll/collation": "workspace:*",
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "tsdown": "catalog:"
  }
}
