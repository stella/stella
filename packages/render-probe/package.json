{
  "name": "@stll/render-probe",
  "version": "0.0.0",
  "private": true,
  "description": "Counts what React renders on every commit, per component and by cause, for render-width budgets in web and mobile tests",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./src/dom-test-preload.ts",
    "./src/install.ts"
  ],
  "exports": {
    ".": "./src/probe.ts",
    "./commit-hook": "./src/commit-hook.ts",
    "./dom-test": "./src/dom-test-guard.ts",
    "./dom-test-preload": "./src/dom-test-preload.ts",
    "./install": "./src/install.ts",
    "./report": "./src/report.ts",
    "./storm-ledger": "./src/storm-ledger.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test --isolate src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun scripts/lint.ts packages/render-probe",
    "lint:fix": "cd ../.. && bun scripts/lint.ts --fix packages/render-probe"
  },
  "dependencies": {
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@stll/typescript-config": "workspace:*",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "bun-types": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  }
}
