{
  "name": "@stll/errors",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/errors",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/errors",
    "format": "bun ../../scripts/run-oxfmt.ts ."
  },
  "dependencies": {
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@stll/concurrency": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
