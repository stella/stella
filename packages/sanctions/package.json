{
  "name": "@stll/sanctions",
  "version": "0.0.0",
  "private": true,
  "description": "Sanctions-list parsing and name screening",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./test-fixtures/monitoring-corpus": "./src/test-fixtures/monitoring-corpus.ts",
    "./test-fixtures/large-ofac-list": "./src/test-fixtures/large-ofac-list.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src --path-ignore-patterns '**/*.property.test.ts'",
    "evaluate": "bun scripts/evaluate.ts",
    "prove:real-editions": "bun scripts/prove-real-editions.ts",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/sanctions",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/sanctions",
    "test:property": "./scripts/test-property.sh --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')"
  },
  "dependencies": {
    "@stll/country-codes": "workspace:*",
    "@stll/fuzzy-search": "catalog:",
    "@stll/sha256": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "@stll/time": "0.4.2",
    "better-result": "catalog:",
    "saxes": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  }
}
