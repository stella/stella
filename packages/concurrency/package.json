{
  "name": "@stll/concurrency",
  "version": "0.0.0",
  "private": true,
  "description": "Bounded-concurrency helpers: run an async operation over a list with a fixed number in flight",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./with-timeout": "./src/with-timeout.ts",
    "./sleep": "./src/sleep.ts",
    "./backoff-delay": "./src/backoff-delay.ts",
    "./chunk": "./src/chunk.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/concurrency",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/concurrency",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')"
  },
  "dependencies": {
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  }
}
