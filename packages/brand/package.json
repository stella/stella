{
  "name": "@stll/brand",
  "version": "0.0.0",
  "private": true,
  "description": "The brand palette: typed hex values and the sRGB triples derived from them.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/brand",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/brand"
  },
  "dependencies": {
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
