{
  "name": "@stll/workspace-ui",
  "version": "0.4.3",
  "description": "Reusable workspace presentation components and view helpers for Stella.",
  "keywords": [
    "calculations",
    "filters",
    "react",
    "tables",
    "ui",
    "workspace"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/workspace-ui",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/workspace-ui"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./calculations": "./src/calculations.tsx",
    "./calculation-format": "./src/calculation-format.ts",
    "./calculation-selection": "./src/calculation-selection.ts",
    "./colors": "./src/colors.ts",
    "./conditions": "./src/conditions/index.ts",
    "./field-value": "./src/field-value.tsx",
    "./field-value-logic": "./src/field-value-logic.ts",
    "./kanban-grouping-picker": "./src/kanban-grouping-picker.tsx",
    "./kanban-view": "./src/kanban-view.ts",
    "./property-icon": "./src/property-icon.tsx",
    "./sorts": "./src/sorts.tsx",
    "./table-skeleton-rows": "./src/table-skeleton-rows.tsx",
    "./types": "./src/types.ts",
    "./view-switcher": "./src/view-switcher.tsx",
    "./view-switcher-logic": "./src/view-switcher.logic.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "build": "tsdown",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun test src",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware packages/workspace-ui",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/workspace-ui",
    "format": "oxfmt .",
    "prepack": "bun run build",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlF 'fc.assert' src --include='*.test.ts')"
  },
  "dependencies": {
    "@stll/calculations": "workspace:^",
    "@stll/conditions": "workspace:^",
    "@stll/money": "workspace:^",
    "@stll/ui": "workspace:^",
    "better-result": "catalog:",
    "lucide-react": "catalog:",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
    "@base-ui/react": "catalog:",
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@tanstack/react-table": "9.1.2",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "bun-types": "catalog:",
    "fast-check": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-table": "^9.1.2",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.3.0"
  }
}
