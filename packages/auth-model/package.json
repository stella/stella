{
  "name": "@stll/auth-model",
  "version": "0.2.1",
  "description": "Portable Better Auth core contract and parity checks.",
  "keywords": [
    "authentication",
    "better-auth",
    "multitenancy",
    "organizations",
    "typescript"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/packages/auth-model",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "packages/auth-model"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/contract.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "build": "tsdown",
    "pack:dry-run": "bun pm pack --dry-run",
    "test": "bun test src",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware packages/auth-model",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/auth-model",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "better-auth": "catalog:",
    "bun-types": "catalog:",
    "tsdown": "catalog:"
  }
}
