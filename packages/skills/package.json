{
  "name": "@stll/skills",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./streaming": {
      "types": "./src/streaming.ts",
      "import": "./src/streaming.ts"
    },
    "./format": {
      "types": "./src/format.ts",
      "import": "./src/format.ts"
    },
    "./frontmatter": {
      "types": "./src/frontmatter.ts",
      "import": "./src/frontmatter.ts"
    },
    "./starter-skills": {
      "types": "./src/starter-skills.ts",
      "import": "./src/starter-skills.ts"
    },
    "./network-hosts": {
      "types": "./src/network-hosts.ts",
      "import": "./src/network-hosts.ts"
    },
    "./static-import-graph": {
      "types": "./src/static-import-graph.ts",
      "import": "./src/static-import-graph.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "generate": "bun scripts/generate-manifests.ts",
    "test": "bun scripts/generate-manifests.ts --check && bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun scripts/lint.ts packages/skills",
    "lint:fix": "cd ../.. && bun scripts/lint.ts --fix packages/skills"
  },
  "dependencies": {
    "@stll/portable-path": "workspace:*",
    "@stll/sha256": "workspace:*",
    "better-result": "catalog:"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  }
}
