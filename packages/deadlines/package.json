{
  "name": "@stll/deadlines",
  "version": "0.0.0",
  "private": true,
  "description": "Explainable Czech and Slovak deadline calculations with bounded holiday coverage",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/compute-deadline.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun scripts/lint.ts packages/deadlines",
    "lint:fix": "cd ../.. && bun scripts/lint.ts --fix packages/deadlines",
    "format": "bun fmt ."
  },
  "dependencies": {
    "@stll/time": "0.4.2",
    "better-result": "catalog:",
    "date-holidays": "3.39.1"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  }
}
