{
  "name": "@stll/anonymize",
  "version": "2.9.0",
  "description": "Deterministic PII detection and anonymization with regex, deny lists, and coreference resolution",
  "keywords": [
    "anonymization",
    "pii",
    "redaction",
    "pseudonymization",
    "gdpr",
    "privacy"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./constants": {
      "types": "./dist/constants.d.mts",
      "import": "./dist/constants.mjs",
      "default": "./dist/constants.mjs"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.mts",
      "import": "./dist/capabilities.mjs",
      "default": "./dist/capabilities.mjs"
    },
    "./agent-surface": {
      "types": "./dist/agent-surface.d.mts",
      "import": "./dist/agent-surface.mjs",
      "default": "./dist/agent-surface.mjs"
    },
    "./feedback": {
      "types": "./dist/feedback.d.mts",
      "import": "./dist/feedback.mjs",
      "default": "./dist/feedback.mjs"
    },
    "./native": {
      "types": "./dist/native.d.mts",
      "import": "./dist/native.mjs",
      "default": "./dist/native.mjs"
    },
    "./native-node": {
      "types": "./dist/native-node.d.mts",
      "import": "./dist/native-node.mjs",
      "default": "./dist/native-node.mjs"
    },
    "./native-runtime": {
      "types": "./dist/native-runtime.d.mts",
      "import": "./dist/native-runtime.mjs",
      "default": "./dist/native-runtime.mjs"
    }
  },
  "types": "dist/index.d.mts",
  "bin": {
    "stella-anonymize-build-native-package": "./scripts/build-native-pipeline-package.mjs"
  },
  "files": [
    "ATTRIBUTION.md",
    "LICENSE",
    "NOTICE",
    "dist",
    "index.cjs",
    "index.d.cts",
    "native-pipeline.stlanonpkg",
    "native-pipeline.*.stlanonpkg",
    "scripts/build-native-pipeline-package.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella/anonymize.git"
  },
  "homepage": "https://github.com/stella/anonymize",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run build:native-wasm && tsdown && bun scripts/build-native-node.mjs && bun run build:wasm-assets",
    "prepublishOnly": "bun run build",
    "typecheck": "bun ../../scripts/tsc-native.ts --noEmit -p tsconfig.json && bun ../../scripts/tsc-native.ts --noEmit -p tsconfig.test.json && bun ../../scripts/tsc-native.ts --noEmit -p tsconfig.wasm.json",
    "test": "bun test --timeout 15000",
    "test:fast": "bun test --timeout 15000 src/__test__/capabilities.test.ts src/__test__/dictionary-bundle.test.ts src/__test__/operators.test.ts src/__test__/redact.test.ts",
    "test:native-fixtures": "ANONYMIZE_TEST_SLOW_NATIVE_FIXTURE_PARITY=1 bun test --timeout 600000 src/__test__/python-parity.test.ts",
    "perf:native-adapters": "bun scripts/native-adapter-perf.mjs",
    "perf:native-default": "bun scripts/native-default-sdk-perf.mjs",
    "perf:native-default:summary": "ANONYMIZE_NATIVE_DEFAULT_SDK_PERF_OUTPUT=summary bun scripts/native-default-sdk-perf.mjs",
    "check:v1-native": "bun scripts/native-v1-readiness.mjs",
    "check:v1-native:full": "ANONYMIZE_V1_READINESS_MODE=full bun scripts/native-v1-readiness.mjs",
    "check:native-install-footprint": "node scripts/check-native-install-footprint.mjs",
    "smoke:dist": "bun scripts/dist-smoke.mjs",
    "build:native-wasm": "node scripts/build-native-wasm.mjs",
    "build:wasm-assets": "node scripts/build-native-wasm-assets.mjs",
    "smoke:wasm": "node scripts/smoke-wasm.mjs",
    "smoke:wasm-package": "node scripts/smoke-wasm-package.mjs",
    "smoke:wasm-runtimes": "node scripts/smoke-wasm-runtimes.mjs",
    "smoke:wasm-compiled": "node scripts/smoke-wasm-compiled.mjs",
    "smoke:wasm-browser": "node scripts/smoke-wasm-browser.mjs",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@stll/anonymize-data": "^0.0.10"
  },
  "optionalDependencies": {
    "@stll/anonymize-darwin-arm64": "2.9.0",
    "@stll/anonymize-darwin-x64": "2.9.0",
    "@stll/anonymize-linux-arm64-gnu": "2.9.0",
    "@stll/anonymize-linux-x64-gnu": "2.9.0",
    "@stll/anonymize-win32-x64-msvc": "2.9.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "bun-types": "1.4.0",
    "fast-check": "^4.9.0",
    "fflate": "^0.8.3",
    "puppeteer-core": "25.8.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  }
}
