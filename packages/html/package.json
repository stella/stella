{
  "name": "@stll/html",
  "version": "0.0.0",
  "private": true,
  "description": "String-only HTML parsing with Cheerio traversal",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/load.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "test": "bun test src",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check packages/html",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix packages/html"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "parse5": "catalog:",
    "parse5-htmlparser2-tree-adapter": "catalog:"
  }
}
