+						...chunk.response.usage && { usage: buildResponsesUsage(chunk.response.usage) },
 						error: {
 							message: errorMessage,
 							...errorCode !== void 0 && { code: errorCode }
@@ -1172,13 +1173,19 @@ var OpenAIBaseResponsesTextAdapter = class extends BaseTextAdapter {
