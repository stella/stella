+++ b/dist/esm/adapters/responses-text.js
@@ -1119,13 +1119,19 @@ var OpenAIBaseResponsesTextAdapter = class extends BaseTextAdapter {
 					model: model || options.model,
 					timestamp: Date.now()
 				};
+				// Backport of TanStack/ai#1494 (issue #1447): the Responses API always
+				// sends a terminal event, so a stream that ends without one failed.
+				// Remove with @tanstack/openai-base >= 0.12.0.
 				yield {
-					type: EventType.RUN_FINISHED,
-					runId: aguiState.runId,
-					threadId: aguiState.threadId,
+					type: EventType.RUN_ERROR,
 					model: model || options.model,
 					timestamp: Date.now(),
-					finishReason: toolCallMetadata.size > 0 ? "tool_calls" : "stop"
+					message: "The response stream ended before a terminal response event.",
