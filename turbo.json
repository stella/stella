{
  "$schema": "https://turborepo.com/schema.json",
  // Turbo runs tasks in strict env mode, which strips undeclared variables from
  // the task environment. propertyConfig reads these at run time: the nightly
  // factor that scales property numRuns, the pinned seed a replay command
  // sets, and CI to enable fast-check verbose reporting. Without passing them
  // through, the nightly sweep would silently run at factor 1 and a replay
  // would silently run the default seed.
  "globalPassThroughEnv": [
    "CI",
    "CI_GENERATED_SOURCES_MANIFEST",
    "PROPERTY_TEST_NUM_RUNS_FACTOR",
    "PROPERTY_TEST_SEED"
  ],
  // A patched dependency changes installed code for every task that resolves
  // it, but editing a patch file moves neither bun.lock (which records the
  // patch path, not its contents) nor package.json, so nothing Turbo hashes by
  // default changes and a cached pass could replay over the edit. Hashing the
  // patches globally is the honest scope: the blast radius is every dependent
  // package, not one task's declared inputs.
  "globalDependencies": ["patches/**"],
  "tasks": {
    "@stll/desktop#test:browser": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@stll/visual-preview#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser/**"]
    },
    "@stll/visual-preview#test:browser": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/browser/visual-preview-composition.spec.ts",
        "$TURBO_ROOT$/apps/api/src/handlers/visual-sandbox/**",
        "$TURBO_ROOT$/packages/api-contract/src/visual-sandbox.ts"
      ]
    },
    // Outputs are ignored by Git, but restored by Turbo on a cache hit.
    "@stll/web#generate:route-tree": {
      "inputs": [
        "src/routes/**",
        "vite.config.ts",
        "route-tree.config.ts",
        "scripts/generate-route-tree.ts",
        "$TURBO_ROOT$/packages/scripts/src/prepared-generated-sources.ts",
        "$TURBO_ROOT$/packages/scripts/src/generated-files.ts",
        "$TURBO_ROOT$/scripts/generated-files.ts",
        "package.json",
        "$TURBO_ROOT$/bun.lock"
      ],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "@stll/web#build": {
      "dependsOn": ["^build", "generate:route-tree", "generate:api-types"]
    },
    "@stll/web#dev": {
      "dependsOn": ["generate:route-tree", "generate:api-types"],
      "persistent": true,
      "cache": false
    },
    "@stll/web#generate:api-types": {
      "dependsOn": [
        "generate:route-tree",
        "@stll/api#generate:capability-runtime"
      ],
      "inputs": [
        "$TURBO_ROOT$/apps/api/**",
        "$TURBO_ROOT$/packages/scripts/src/generated-files.ts",
        "$TURBO_ROOT$/scripts/generated-files.ts",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/apps/web/tsconfig*.json",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/types/**",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/.npmrc",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/.cache/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.env*",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.tsbuildinfo",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/.cache/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/packages/**/.env*",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/*.tsbuildinfo",
        "!$TURBO_ROOT$/apps/api/src/mcp/generated/capability-dispatch.ts",
        "!$TURBO_ROOT$/apps/api/src/mcp/generated/capability-catalog.ts",
        "!$TURBO_ROOT$/apps/api/src/mcp/generated/capability-feature-bindings.ts",
        "!src/generated/api-routes.gen.ts",
        "!src/routeTree.gen.ts"
      ],
      "outputs": ["src/generated/api-routes.gen.ts"]
    },
    // Compiler scripts prepare direct invocations, but skip that cache restore
    // inside Turbo (TURBO_HASH): these dependencies already prepared the file.
    "@stll/web#typecheck": {
      "dependsOn": ["transit", "generate:api-types", "generate:route-tree"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/scripts/src/tsc-native.ts",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/types/**"
      ],
      "outputs": [".cache/tsbuildinfo*.json", "**/.cache/tsbuildinfo*.json"]
    },
    "@stll/web#lint": {
      "dependsOn": ["transit", "generate:api-types", "generate:route-tree"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.result-boundary.config.ts",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/scripts/oxlint-presets/**",
        "$TURBO_ROOT$/scripts/ownership.ts",
        "$TURBO_ROOT$/scripts/ownership/*.ts",
        "$TURBO_ROOT$/scripts/ownership-loader.ts",
        "$TURBO_ROOT$/scripts/ownership-types.ts",
        "$TURBO_ROOT$/scripts/sha256-owners.ts",
        "$TURBO_ROOT$/scripts/sha256-migration-ledger.json",
        "$TURBO_ROOT$/scripts/status-write-shapes.ts",
        "$TURBO_ROOT$/scripts/parse-memo.ts",
        "$TURBO_ROOT$/scripts/oxlint-disable-rule-ids.ts",
        "$TURBO_ROOT$/scripts/oxlint-rule-ids.ts",
        "$TURBO_ROOT$/apps/api/src/lib/db/status-tables.gen.ts",
        "$TURBO_ROOT$/apps/api/src/lib/lists/sanctions/monitoring-transition-identities.ts",
        "$TURBO_ROOT$/apps/api/src/lib/db/read-bounded.ts",
        "$TURBO_ROOT$/scripts/result-boundary-globs.ts",
        "$TURBO_ROOT$/scripts/sql-perf-detector.ts",
        "$TURBO_ROOT$/apps/api/src/db/high-volume-tables.ts",
        "$TURBO_ROOT$/apps/api/src/lib/safe-handler-factories.ts",
        "$TURBO_ROOT$/apps/api/src/lib/system-audit/modules.ts",
        "$TURBO_ROOT$/scripts/sql-perf-scope.ts",
        "$TURBO_ROOT$/scripts/design-lint-policy.ts",
        "$TURBO_ROOT$/scripts/design-lint-baseline.json",
        "$TURBO_ROOT$/scripts/derived-attributes.ts",
        "$TURBO_ROOT$/scripts/source-fingerprint-baseline.json",
        "$TURBO_ROOT$/scripts/outbound-transport-census.ts",
        "$TURBO_ROOT$/scripts/outbound-transport-ownership.ts",
        "$TURBO_ROOT$/scripts/parse-memo.ts",
        "$TURBO_ROOT$/scripts/audit-mutation-ledger-scope.ts",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/tsconfig.tooling.json",
        "$TURBO_ROOT$/types/**"
      ]
    },
    "@stll/web#lint:fix": {
      "dependsOn": ["transit", "generate:api-types", "generate:route-tree"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.result-boundary.config.ts",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/scripts/oxlint-presets/**",
        "$TURBO_ROOT$/scripts/ownership.ts",
        "$TURBO_ROOT$/scripts/ownership/*.ts",
        "$TURBO_ROOT$/scripts/ownership-loader.ts",
        "$TURBO_ROOT$/scripts/ownership-types.ts",
        "$TURBO_ROOT$/scripts/sha256-owners.ts",
        "$TURBO_ROOT$/scripts/sha256-migration-ledger.json",
        "$TURBO_ROOT$/scripts/status-write-shapes.ts",
        "$TURBO_ROOT$/scripts/parse-memo.ts",
        "$TURBO_ROOT$/scripts/oxlint-disable-rule-ids.ts",
        "$TURBO_ROOT$/scripts/oxlint-rule-ids.ts",
        "$TURBO_ROOT$/apps/api/src/lib/db/status-tables.gen.ts",
        "$TURBO_ROOT$/apps/api/src/lib/lists/sanctions/monitoring-transition-identities.ts",
        "$TURBO_ROOT$/apps/api/src/lib/db/read-bounded.ts",
        "$TURBO_ROOT$/scripts/result-boundary-globs.ts",
        "$TURBO_ROOT$/scripts/sql-perf-detector.ts",
        "$TURBO_ROOT$/apps/api/src/db/high-volume-tables.ts",
        "$TURBO_ROOT$/apps/api/src/lib/safe-handler-factories.ts",
        "$TURBO_ROOT$/apps/api/src/lib/system-audit/modules.ts",
        "$TURBO_ROOT$/scripts/sql-perf-scope.ts",
        "$TURBO_ROOT$/scripts/design-lint-policy.ts",
        "$TURBO_ROOT$/scripts/design-lint-baseline.json",
        "$TURBO_ROOT$/scripts/derived-attributes.ts",
        "$TURBO_ROOT$/scripts/source-fingerprint-baseline.json",
        "$TURBO_ROOT$/scripts/audit-mutation-ledger-scope.ts",
        "$TURBO_ROOT$/tsconfig.tooling.json"
      ],
      "cache": false
    },
    "@stll/web#test:property": {
      "dependsOn": ["generate:api-types", "generate:route-tree"],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    // The landing build also reads files outside its workspace graph: release
    // notes, the generated tool reference, and the media sync script its build
    // script runs. scripts/landing-deploy-scope.ts reads these inputs to decide
    // whether a push can change the site, so a new outside read belongs here.
    "@stll/landing#build": {
      "dependsOn": ["^build", "@stll/cli#codegen:runtime"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/docs/changelog/**",
        "$TURBO_ROOT$/packages/cli/**",
        "$TURBO_ROOT$/scripts/product-media.ts"
      ],
      "outputs": ["dist/**"]
    },
    "@stll/extension#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/VERSION",
        "$TURBO_ROOT$/apps/desktop/assets/icon-*.png"
      ],
      "outputs": [".output/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "typegen": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "typecheck": {
      // A package type-checking @stll/api source needs its generated capability
      // runtime modules first.
      "dependsOn": ["transit", "^generate:capability-runtime"],
      // These files live outside each workspace but can change dependency
      // resolution or the shared compiler program. Hash them explicitly so a
      // linked worktree never restores a stale lint or TypeScript result.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/scripts/src/tsc-native.ts",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/types/**"
      ],
      "outputs": [".cache/tsbuildinfo*.json", "**/.cache/tsbuildinfo*.json"]
    },
    "//#typecheck:repo": {
      "dependsOn": [
        "@stll/web#generate:api-types",
        "@stll/web#generate:route-tree",
        "@stll/cli#codegen:runtime",
        "@stll/api#generate:capability-runtime"
      ],
      // Root projects can import workspace source. The broad workspace inputs
      // trade some misses for correctness while still sharing exact results
      // and compiler state between linked worktrees and CI runners.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/mcp/**",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/types/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tsconfig*.json"
      ],
      "outputs": [".cache/tsbuildinfo*.json"]
    },
    // A workspace whose typecheck generates declarations first keeps the
    // shared typecheck inputs, records the generated directory as an output,
    // and orders its type-checking lint after it (see the `#lint` overrides).
    // Left unrecorded, a cache hit replays the logs and writes nothing, so the
    // lint would type-check a program without the generated declarations.
    "@stll/landing#typecheck": {
      "dependsOn": ["transit", "@stll/cli#codegen:runtime"],
      // `astro check` generates the `astro:content` types.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/scripts/src/tsc-native.ts",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/types/**"
      ],
      "outputs": [".astro/**"]
    },
    "@stll/extension#typecheck": {
      "dependsOn": ["transit"],
      // `wxt prepare` generates `.wxt/wxt.d.ts`, which the tsconfig includes
      // for the `import.meta.env` and browser declarations.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/scripts/src/tsc-native.ts",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/types/**"
      ],
      "outputs": [
        ".cache/tsbuildinfo*.json",
        "**/.cache/tsbuildinfo*.json",
        ".wxt/**"
      ]
    },
    "lint": {
      // A package type-checking @stll/api source needs its generated capability
      // runtime modules first.
      "dependsOn": ["transit", "^generate:capability-runtime"],
      // Type-aware lint reads the same external install and compiler inputs as
      // TypeScript, in addition to Oxlint's root config and plugins.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
