{
  "$schema": "https://turborepo.com/schema.json",
  // Turbo runs tasks in strict env mode, which strips undeclared variables from
  // the task environment. propertyConfig reads these at run time: the nightly
  // factor that scales property numRuns, the pinned seed a replay command
  // sets, and CI to enable fast-check verbose reporting. Without passing them
  // through, the nightly sweep would silently run at factor 1 and a replay
  // would silently run the default seed.
  "globalPassThroughEnv": [
    "CI",
    "PROPERTY_TEST_NUM_RUNS_FACTOR",
    "PROPERTY_TEST_SEED"
  ],
  // A patched dependency changes installed code for every task that resolves
  // it, but editing a patch file moves neither bun.lock (which records the
  // patch path, not its contents) nor package.json, so nothing Turbo hashes by
  // default changes and a cached pass could replay over the edit. Hashing the
  // patches globally is the honest scope: the blast radius is every dependent
  // package, not one task's declared inputs.
  "globalDependencies": ["patches/**"],
  "tasks": {
    "@stll/redis-config#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    // The landing build also reads files outside its workspace graph: release
    // notes, the generated tool reference, and the media sync script its build
    // script runs. scripts/landing-deploy-scope.ts reads these inputs to decide
    // whether a push can change the site, so a new outside read belongs here.
    "@stll/landing#build": {
      "dependsOn": ["^build", "@stll/cli#codegen:runtime"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/docs/changelog/**",
        "$TURBO_ROOT$/packages/cli/**",
        "$TURBO_ROOT$/scripts/product-media.ts"
      ],
      "outputs": ["dist/**"]
    },
    "@stll/extension#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".output/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "typegen": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["transit"],
      // These files live outside each workspace but can change dependency
      // resolution or the shared compiler program. Hash them explicitly so a
      // linked worktree never restores a stale lint or TypeScript result.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/scripts/src/tsc-native.ts",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/types/**"
      ],
      "outputs": [".cache/tsbuildinfo*.json", "**/.cache/tsbuildinfo*.json"]
    },
    "//#typecheck:repo": {
      "dependsOn": ["@stll/cli#codegen:runtime"],
      // Root projects can import workspace source. The broad workspace inputs
      // trade some misses for correctness while still sharing exact results
      // and compiler state between linked worktrees and CI runners.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/mcp/**",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/types/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tsconfig*.json"
      ],
      "outputs": [".cache/tsbuildinfo*.json"]
    },
    // A workspace whose typecheck generates declarations first keeps the
    // shared typecheck inputs, records the generated directory as an output,
    // and orders its type-checking lint after it (see the `#lint` overrides).
    // Left unrecorded, a cache hit replays the logs and writes nothing, so the
    // lint would type-check a program without the generated declarations.
    "@stll/landing#typecheck": {
      "dependsOn": ["transit", "@stll/cli#codegen:runtime"],
      // `astro check` generates the `astro:content` types.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/scripts/src/tsc-native.ts",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/types/**"
      ],
      "outputs": [".astro/**"]
    },
    "@stll/extension#typecheck": {
      "dependsOn": ["transit"],
      // `wxt prepare` generates `.wxt/wxt.d.ts`, which the tsconfig includes
      // for the `import.meta.env` and browser declarations.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/scripts/src/tsc-native.ts",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/types/**"
      ],
      "outputs": [
        ".cache/tsbuildinfo*.json",
        "**/.cache/tsbuildinfo*.json",
        ".wxt/**"
      ]
    },
    "lint": {
      "dependsOn": ["transit"],
      // Type-aware lint reads the same external install and compiler inputs as
      // TypeScript, in addition to Oxlint's root config and plugins.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.result-boundary.config.ts",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/scripts/ownership.ts",
        "$TURBO_ROOT$/scripts/result-boundary-globs.ts",
        "$TURBO_ROOT$/scripts/sql-perf-detector.ts",
        "$TURBO_ROOT$/apps/api/src/db/high-volume-tables.ts",
        "$TURBO_ROOT$/scripts/sql-perf-scope.ts",
        "$TURBO_ROOT$/scripts/design-lint-policy.ts",
        "$TURBO_ROOT$/scripts/design-lint-baseline.json",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/tsconfig.tooling.json",
        "$TURBO_ROOT$/types/**"
      ]
    },
    "@stll/landing#dev": {
      "dependsOn": ["@stll/cli#codegen:runtime"],
      "persistent": true,
      "cache": false
    },
    "@stll/landing#lint:fix": {
      "dependsOn": ["transit", "@stll/cli#codegen:runtime"]
    },
    "@stll/landing#lint": {
      // Astro check generates the content types consumed by type-aware Oxlint.
      // Running a second astro sync concurrently races on the same temp file.
      "dependsOn": ["typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.result-boundary.config.ts",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/scripts/ownership.ts",
        "$TURBO_ROOT$/scripts/result-boundary-globs.ts",
        "$TURBO_ROOT$/scripts/sql-perf-detector.ts",
        "$TURBO_ROOT$/apps/api/src/db/high-volume-tables.ts",
        "$TURBO_ROOT$/scripts/sql-perf-scope.ts",
        "$TURBO_ROOT$/scripts/design-lint-policy.ts",
        "$TURBO_ROOT$/scripts/design-lint-baseline.json",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/tsconfig.tooling.json",
        "$TURBO_ROOT$/types/**"
      ]
    },
    "@stll/extension#lint": {
      // Type-checking lint reads the `.wxt` declarations `wxt prepare` writes.
      "dependsOn": ["typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.result-boundary.config.ts",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/scripts/ownership.ts",
        "$TURBO_ROOT$/scripts/result-boundary-globs.ts",
        "$TURBO_ROOT$/scripts/sql-perf-detector.ts",
        "$TURBO_ROOT$/apps/api/src/db/high-volume-tables.ts",
        "$TURBO_ROOT$/scripts/sql-perf-scope.ts",
        "$TURBO_ROOT$/scripts/design-lint-policy.ts",
        "$TURBO_ROOT$/scripts/design-lint-baseline.json",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/tsconfig.tooling.json",
        "$TURBO_ROOT$/types/**"
      ]
    },
    "lint:fix": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.result-boundary.config.ts",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/scripts/ownership.ts",
        "$TURBO_ROOT$/scripts/result-boundary-globs.ts",
        "$TURBO_ROOT$/scripts/sql-perf-detector.ts",
        "$TURBO_ROOT$/apps/api/src/db/high-volume-tables.ts",
        "$TURBO_ROOT$/scripts/sql-perf-scope.ts",
        "$TURBO_ROOT$/scripts/design-lint-policy.ts",
        "$TURBO_ROOT$/scripts/design-lint-baseline.json"
      ],
      "cache": false
    },
    "format": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxfmtrc.json",
        "$TURBO_ROOT$/scripts/check-format-environment.ts",
        "$TURBO_ROOT$/scripts/run-oxfmt.ts"
      ]
    },
    "i18n:check": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "i18n:sync": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "test": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@stll/cli#codegen:runtime": {
      "inputs": [
        "package.json",
        "capability-catalog.json",
        "src/codegen.ts",
        "src/capability-catalog-load.ts",
        "src/generate-capability-tree.ts",
        "src/generate-route-map.ts",
        "src/annotations.ts",
        "src/expand-schema-defs.ts",
        "src/flag-name.ts",
        "src/route-types.ts",
        "src/generated/registry-snapshot.json",
        "src/generated/mcp-contract.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/patches/**"
      ],
      "outputs": [
        "src/generated/route-map.ts",
        "src/generated/tool-annotations.ts"
      ]
    },
    "@stll/cli#build": {
      "dependsOn": ["^build", "codegen:runtime"]
    },
    "@stll/cli#typecheck": {
      "dependsOn": ["transit", "codegen:runtime"]
    },
    "@stll/cli#lint": {
      "dependsOn": ["transit", "codegen:runtime"]
    },
    "@stll/cli#lint:fix": {
      "dependsOn": ["transit", "codegen:runtime"]
    },
    // A package's tests are selected, and cached, on that package's own files.
    // The entries below declare the files each suite reads from outside its
    // workspace: scripts/test-scope.ts adds the package to the test filter when
    // one of them changed, and Turbo counts it in the cache key so a cached
    // pass cannot replay over it. scripts/check-test-input-coverage.ts holds
    // these lists and the tests in sync in both directions.
    "@stll/cli#test": {
      "dependsOn": ["codegen:runtime"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@stll/agent-engine#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/agent-sandbox-canary.yml",
        "$TURBO_ROOT$/.github/workflows/scheduled-run-alerts.yml"
      ]
    },
    "@stll/api#test": {
      "dependsOn": [],
      // How many test batches run at once; it never changes results, so it
      // passes through without entering the cache key.
      "passThroughEnv": ["API_TEST_LANES"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/ai-provider-canary.yml",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/apps/web/src/components/chat/**",
        "$TURBO_ROOT$/apps/web/src/features/chat/chat-runtime.ts",
        "$TURBO_ROOT$/oxlint.config.ts"
      ]
    },
    "@stll/web#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/apps/api/src/**",
        "$TURBO_ROOT$/apps/landing/public/fonts/CabinetGrotesk-Regular.otf",
        "$TURBO_ROOT$/apps/landing/public/images/gradients/**",
        "$TURBO_ROOT$/oxlint.config.ts"
      ]
    },
    // The native suite compiles files it embeds from outside the crate, so its
    // inputs are the crate plus those embeds: a web-only edit elsewhere in the
    // package keeps the cached pass. scripts/check-desktop-rust-inputs.ts keeps
    // this list, the embeds, and the CI detector in sync.
    "@stll/desktop#test:native": {
      "dependsOn": [],
      "inputs": [
        "src-tauri/**",
        "!src-tauri/target/**",
        "!src-tauri/gen/**",
        "!src-tauri/permissions/autogenerated/**",
        "fixtures/**",
        "src/i18n/langs/**",
        "src/clipboard/clipboard-types.ts",
        "$TURBO_ROOT$/packages/api-contract/src/desktop-account-policy.json",
        "$TURBO_ROOT$/packages/api-contract/src/desktop-edit-file-types.ts",
        "$TURBO_ROOT$/packages/api-contract/src/desktop-rpc.gen.ts"
      ]
    },
    // Repository-wide tooling guards: these suites walk apps/*, packages/* and
    // the workflows themselves, so any of those files can break them.
    "@stll/property-testing#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**"
      ]
    },
    "@stll/scripts#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/.oxlint-plugins/**",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/scripts/**"
      ]
    },
    "test:property": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
