{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "packages/legal-atlas/src/__fixtures__/cz-esbirka-500-2004-par-64.json",
    "packages/legal-atlas/src/__fixtures__/cz-esbirka-262-2006-par-1a.json",
    "apps/api/src/handlers/case-law/ingestion/**/__fixtures__/**/*.html",
    "apps/api/src/handlers/case-law/ingestion/**/__fixtures__/**/*.json",
    "packages/business-registries/src/**/__fixtures__/**/*.html",
    "**/*.gen.*",
    "**/*.min.*",
    "sbom.cdx.json",
    "**/.cache/**",
    "**/.oxlintrc.json",
    "**/dist/**",
    "**/.react-email/**",
    "/AGENTS.md",
    "/GEMINI.md",
    "apps/*/AGENTS.md",
    "apps/*/GEMINI.md",
    "packages/*/AGENTS.md",
    "packages/*/GEMINI.md",
    ".agents/skills/**/SKILL.md",
    ".claude/skills/**/SKILL.md",
    "apps/api/src/db/schema.ts",
    "packages/template-packs/content/**",
    "apps/api/src/lib/legal-search/morphology/snowball/base-stemmer.ts",
    "apps/api/src/mcp/apps/**/generated/**",
    "apps/api/src/handlers/visual-sandbox/generated/**",
    "apps/api/src/mcp/generated/capability-dispatch/*.ts",
    "packages/cli/capabilities/*.json",
    "packages/cli/src/generated/route-map.ts",
    "packages/cli/src/generated/tool-annotations.ts",
    "packages/cli/skills/stella-cli/SKILL.md",
    "docs/capability-coverage.md",
    "**/i18n-check-baseline.json",
    "**/i18n-lint-baseline.json",
    "apps/api/mcp-surface-baseline.json",
    "apps/api/src/mcp/generated/capability-feature-bindings.ts",
    "apps/api/src/mcp/generated/capability-catalog.ts",
    "apps/api/src/mcp/generated/capability-dispatch.ts"
  ],
  "printWidth": 80,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react-dom", "react-dom/**"]
      },
      {
        "groupName": "stella",
        "elementNamePattern": ["@stll/**"]
      },
      {
        "groupName": "aliases",
        "elementNamePattern": ["@/**"]
      }
    ],
    "groups": [
      "react",
      ["value-builtin", "value-external", "type-builtin", "type-external"],
      "stella",
      "aliases",
      [
        "value-parent",
        "value-sibling",
        "value-index",
        "type-parent",
        "type-sibling",
        "type-index"
      ]
    ],
    "newlinesBetween": true
  },
  "sortTailwindcss": {
    "functions": ["cn", "cva"],
    "stylesheet": "node_modules/tailwindcss/theme.css"
  }
}
