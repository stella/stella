                "properties": {
                  "reason": {
                    "const": "checksum_mismatch"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "Path inside the part's ZIP archive, `/`-separated, NFC-normalised."
                  },
                  "fileId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "recordedSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "Lowercase hex SHA-256 of the file bytes."
                  }
                },
                "required": ["reason", "path", "fileId", "recordedSha256"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "reason": {
                    "const": "matter_unavailable"
                  },
                  "matterId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                },
                "required": ["reason", "matterId"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "$schema",
        "format",
        "formatVersion",
        "exportId",
        "organization",
        "createdAt",
        "scope",
        "kind",
        "completedAt",
        "requestedBy",
        "parts",
        "totals",
        "problems"
      ],
      "additionalProperties": false
    }
  ],
  "title": "stella data export manifest",
  "description": "A `part` manifest is `manifest.json` at the root of every part ZIP; the `export` manifest (`export-manifest.json`) lists every part.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stll.app/schemas/stella-data-export.v1.schema.json"
}
