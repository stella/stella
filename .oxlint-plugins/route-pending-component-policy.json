{
  "$comment": "What a route's pending half (*.pending.tsx) may import, besides other *.pending modules, *.logic modules and type-only imports. Pending halves ship in the entry chunk, so each entry here must stay small and context-free; __tests__/route-pending-component-closure.test.ts walks every entry's import closure and fails on closureBanned.",
  "pendingSafeModules": [
    "react",
    "@stll/ui/calendar-primitives",
    "@stll/ui/composer-tokens",
    "@stll/ui/control-face",
    "@stll/ui/directional-icon",
    "@stll/ui/frame",
    "@stll/ui/icons",
    "@stll/ui/input-otp-face",
    "@stll/ui/kanban-card-shell",
    "@stll/ui/kanban-column-header-shell",
    "@stll/ui/kanban-grouping",
    "@stll/ui/landing-shell",
    "@stll/ui/layout-tokens",
    "@stll/ui/list-shell",
    "@stll/ui/matter-icon",
    "@stll/ui/scroll-area",
    "@stll/ui/separator",
    "@stll/ui/skeleton",
    "@stll/ui/stella-mark",
    "@stll/ui/stella-wordmark",
    "@stll/ui/table-shell",
    "@stll/ui/truncated-text-face",
    "@stll/ui/utils",
    "@stll/ui/view-toolbar-shell",
    "@stll/workspace-ui/sorts-face",
    "@stll/workspace-ui/view-strip",
    "@/components/auth/inbox-quick-jump-face",
    "@/components/auth/otp-panel-text",
    "@/components/docx/docx-loading-shell",
    "@/components/pending-cache",
    "@/components/pending-text",
    "@/components/workspaces/table/workspace-grid",
    "@/components/workspaces/table/workspace-table/skeleton-rows",
    "@/features/knowledge/views/playbooks/playbooks-page-shape",
    "@/features/knowledge/views/templates/template-list-shape",
    "@/lib/consts",
    "@/lib/workspaces/types",
    "@/routes/_protected.chat/-components/chat-reading-column",
    "@/routes/knowledge/-tools/tools-page-shape",
    "@/stores/config-store"
  ],
  "$namedImportsComment": "Single exports a pending half may import from a module that is otherwise not pending-safe. The router's URL hooks are there at every pending level, and only with `strict: false` (the rule checks the call).",
  "pendingSafeNamedImports": {
    "@tanstack/react-router": ["useParams", "useSearch"],
    "@/lib/redirect": ["isAcceptInvitationRedirect", "normalizeRedirectTo"],
    "@/lib/chrome-header-actions": ["ChromeHeaderActions"]
  },
  "$syncCacheReadersComment": "Synchronous reads of data already in the query cache, by export name from any module, so a pending view can show the controls the loaded page will (no fetch, no subscription).",
  "syncCacheReaders": ["cachedRoleGrants"],
  "closureBanned": [
    "menu",
    "alert-dialog",
    "dialog",
    "popover",
    "@tanstack/react-query",
    "@/lib/api",
    "form",
    "table-core",
    "@tanstack/react-table",
    "@atlaskit/pragmatic-",
    "@dnd-kit",
    "@tiptap",
    "prosemirror",
    "@stll/folio",
    "chat-runtime",
    "@ai-sdk",
    "editor"
  ]
}
