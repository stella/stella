# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files — block all .env* by default, allow only .example
.env*
!.env.example
!.env*.example

# Testing
coverage
apps/api/.test-mutants/

# AI SDK DevTools traces (local plaintext AI interactions)
.devtools/

# Dev runner state for this checkout (runtime URLs, agent key, evidence)
.stella-dev/

# Playwright (storage-state, screenshots, traces)
.playwright/
playwright-report/
test-results/

# Checksum-verified landing recordings hydrated from the product-media manifest
apps/landing/public/media/products/*.mp4
apps/landing/public/media/products/*-poster.jpg

# Claude Code worktrees (local state)
.claude/worktrees/

# QA reports and implementation plans (local-only)
.agents/reports/
.agents/plans/

# Tan Stack
.nitro
.tanstack
dist-ssr

# Turbo
.turbo
.cache

# Local source projections restored by Turbo generation tasks
apps/web/src/generated/api-routes.gen.ts

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
.output
.wxt
.react-email

# Copied at dev server start by vite.config.ts (copyPdfjsWorker)
apps/web/public/pdf.worker.min.mjs

# Machine-local symlink into a folio checkout's visual-test fixtures
# (see the loader comment in apps/playground/src/App.tsx)
apps/playground/public/fixtures

# Bun binary lockfile (text-based bun.lock is committed instead)
bun.lockb

# Debug and tool logs (committed fixture logs are force-added)
*.log
npm-debug.log*

# Misc
.DS_Store
*.pem
.prettiercache
i18n.cache

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock

# API runtime aggregates embed the committed per-capability shards.
apps/api/src/mcp/generated/capability-dispatch.ts
apps/api/src/mcp/generated/capability-catalog.ts
apps/api/src/mcp/generated/capability-feature-bindings.ts

# CLI runtime projections are restored by codegen:runtime.
packages/cli/src/generated/route-map.ts
packages/cli/src/generated/tool-annotations.ts

# Derived TanStack route tree, restored by the web generation task.
apps/web/src/routeTree.gen.ts
apps/web/src/route-templates.gen.ts
apps/web/src/i18n/langs/messages.gen.ts

# MCP runtime and browser outputs are prepared before use.
apps/api/src/mcp/generated/
packages/mcp-apps/src/*/generated/*
!packages/mcp-apps/src/shared/generated/style.css.d.ts
!packages/mcp-apps/src/shared/generated/tsconfig.json
packages/mcp-apps/src/generated/

# Per-run build directories of the rule catalog test.
/.oxlint-rule-ids-*/
