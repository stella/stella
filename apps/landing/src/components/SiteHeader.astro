---
import ThemeToggle from "./ThemeToggle.astro";
import MainNav from "./MainNav.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { GitHubLogoIcon } from "@stll/ui/brand-icons";
import MobileNav from "./MobileNav.astro";
import { getTranslations, localizePath } from "../i18n/utils";
import { defaultLocale, isLocale } from "../i18n/config";

// `current` lets a page mark its own nav entry. `overlay` floats the header
// transparently over the page top (the homepage hero gradient runs to the
// viewport edge behind it) and solidifies it on first scroll; the default is
// the always-solid sticky bar used by every other page.
type Props = { current?: string; overlay?: boolean };
const { current, overlay = false } = Astro.props;

const rawLocale = Astro.currentLocale ?? defaultLocale;
const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
const t = getTranslations(locale);

const appUrl = "https://my.stll.app";
const githubUrl = "https://github.com/stella/stella";
---

<header
  class:list={[
    "top-0 z-50",
    overlay
      ? "site-header-overlay fixed inset-x-0 border-b border-transparent"
      : "site-header-solid sticky border-b backdrop-blur-md",
  ]}
  data-site-header-overlay={overlay ? "" : undefined}
>
  <nav
    class="mx-auto flex w-full max-w-300 items-center justify-between px-4 py-4 sm:px-6"
  >
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-3">
        <a
          href={localizePath("/", locale)}
          class="inline-flex min-h-11 shrink-0 items-center"
        >
          <img
            src={locale === "ar"
              ? "/images/stella-logo-ar.svg"
              : "/images/stella-logo.svg"}
            alt="stella"
            class="h-6 dark:invert"
          />
        </a>
        <span
          class="border-border text-muted-foreground hidden rounded-sm border px-1.5 py-0.5 text-[0.625rem] font-medium tracking-[0.1em] uppercase sm:inline"
        >
          {t("nav.beta")}
        </span>
        <span
          class="hidden h-4 w-px sm:inline"
          style="background: var(--border)"
          aria-hidden="true"></span>
        <a
          href={githubUrl}
          class="hidden min-h-11 min-w-11 items-center justify-center transition-opacity hover:opacity-70 sm:inline-flex"
          style="color: var(--muted-foreground)"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t("nav.github")}
        >
          <GitHubLogoIcon className="h-5 w-5" />
        </a>
      </div>

      <MainNav current={current} />
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <div class="hidden items-center gap-2 sm:flex">
        <ThemeToggle />
        <LanguageSwitcher />
      </div>
      <a
        href={appUrl}
        class="inline-flex min-h-11 items-center rounded-[0.625rem] px-4 text-sm font-medium transition-opacity hover:opacity-90 whitespace-nowrap"
        style="background: var(--primary); color: var(--primary-foreground)"
      >
        {t("common.startFree")}
      </a>
      <MobileNav />
    </div>
  </nav>
</header>

<style is:global>
  .site-header-solid {
    border-color: var(--border);
    background: color-mix(in srgb, var(--background) 82%, transparent);
  }
  .site-header-overlay {
    background: transparent;
    transition:
      background-color 240ms,
      border-color 240ms,
      backdrop-filter 240ms;
  }
  .site-header-overlay.is-scrolled {
    border-color: var(--border);
    background: color-mix(in srgb, var(--background) 82%, transparent);
    backdrop-filter: blur(12px);
  }
</style>

<script is:inline>
  if (!window.__siteHeaderOverlayBound) {
    window.__siteHeaderOverlayBound = true;
    const syncOverlayHeader = () => {
      const header = document.querySelector("[data-site-header-overlay]");
      if (!header) {
        return;
      }
      header.classList.toggle("is-scrolled", window.scrollY > 8);
    };
    window.addEventListener("scroll", syncOverlayHeader, { passive: true });
    document.addEventListener("astro:page-load", syncOverlayHeader);
    syncOverlayHeader();
  }
</script>
