---
import { panic } from "better-result";

import Base from "../layouts/Base.astro";
import ProductMediaFrame from "./ProductMediaFrame.astro";
import McpProofSection from "./McpProofSection.astro";
import LandingFooter from "./LandingFooter.astro";
import SetupSnippet from "./SetupSnippet.astro";
import { resolveProductLink } from "../data/products/links";
import type { AnyProduct } from "../data/products/types";
import { defaultLocale, isLocale, locales } from "../i18n/config";
import { getCliMcpSetupCopy, getProductCopy } from "../i18n/product-copy";
import { getTranslations, localizePath } from "../i18n/utils";

// One template renders any product in any locale: /product/<slug> and
// /<lang>/product/<slug> both mount this. All prose comes from the catalog
// (English included, so the source copy cannot drift unseen); the registry
// supplies media, section pairing, and link destinations.
type Props = { product: AnyProduct };
const { product } = Astro.props;

const rawLocale = Astro.currentLocale ?? defaultLocale;
const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
const t = getTranslations(locale);
const copy = getProductCopy(locale, product.slug);

const eyebrow = t(`nav.products.${product.slug}.eyebrow`);
const title = t(`nav.products.${product.slug}.title`);
const summary = t(`nav.products.${product.slug}.blurb`);

// Prose comes from the catalog; stable section IDs attach optional visual
// treatments without coupling media to translated section order.
const sections = copy.sections.map((section) => {
  const presentation = Object.entries(
    product.sectionPresentations ?? {},
  ).find(([sectionId]) => sectionId === section.id)?.[1];

  return {
    bullets: section.bullets,
    frameVariant: presentation?.frameVariant,
    heading: section.heading,
    media: presentation?.media,
  };
});

// Agent-connection instructions: prose from the catalog, endpoint and code
// snippets from the registry (code is not translated), paired with prose by
// stable client ID.
const copyLabel = t("common.copy");
const copiedLabel = t("common.copied");
const copyFailedLabel = t("common.copyFailed");
const setupData = product.setup;
const setup = setupData
  ? (() => {
      const setupCopy = getCliMcpSetupCopy(locale);
      return {
        clients: Object.entries(setupData.clients).map(([id, client]) => {
          const body = Object.entries(setupCopy.clients).find(
            ([copyId]) => copyId === id,
          )?.[1].body;
          return {
            body:
              body ??
              panic(
                `products.${product.slug}.setup.clients.${id}.body is missing`,
              ),
            name: client.name,
            snippet: client.snippet,
          };
        }),
        endpoint: setupData.endpoint,
        heading: setupCopy.heading,
        intro: setupCopy.intro,
        outro: setupCopy.outro,
        outroSnippet: setupData.outroSnippet,
      };
    })()
  : null;

const adjacent = Object.entries(product.adjacent).map(([id, link]) => {
  const destination = resolveProductLink(link, locale);
  const body = Object.entries(copy.adjacent).find(
    ([copyId]) => copyId === id,
  )?.[1].body;
  return {
    body: body ?? panic(`products.${product.slug}.adjacent.${id}.body is missing`),
    href: destination.href,
    hreflang: destination.hreflang,
    titleKey: destination.titleKey,
  };
});

// FAQPage structured data: the quick answer plus every FAQ, sourced from the
// same content rendered below so assistants and people see the same answers.
// `inLanguage` is stated here and nowhere else in the graph: this node is
// per-page and its text is the catalog's, whereas the site-wide `#website` and
// `#software` nodes share one @id across all thirteen locales and would get as
// many conflicting languages as there are pages (the PRODUCT_DESCRIPTION
// problem). BreadcrumbList is an ItemList, which has no inLanguage.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: locales[locale].hreflang,
  mainEntity: [copy.quickAnswer, ...copy.faqs].map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Base
  title={copy.metaTitle}
  description={copy.metaDescription}
  current="product"
  translationScope="all-locales"
  breadcrumbTrail={{
    ancestors: [{ name: "stella", path: localizePath("/", locale) }],
    name: eyebrow,
  }}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />

  <div class="flex min-h-dvh flex-col">
    <main class="flex-1">
      {/* ——— Hero ——— */}
      <section
        class="px-6 pt-12 pb-10 lg:pt-16"
        id={product.slug === "cli-mcp" ? "cli-and-mcp" : undefined}
      >
        <div class="mx-auto max-w-300">
          <div class="mx-auto max-w-3xl text-center">
            <p
              data-reveal
              class="text-xs font-medium uppercase tracking-[0.2em]"
              style="color: var(--primary)"
            >
              {eyebrow}
            </p>
            <h1
              data-reveal
              style="--reveal-delay: 80ms"
              class="mt-3 font-display text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl"
            >
              {title}
            </h1>
            <p
              data-reveal
              style="--reveal-delay: 160ms; color: var(--muted-foreground)"
              class="mx-auto mt-5 max-w-2xl text-lg leading-[1.7]"
            >
              {summary}
            </p>
          </div>
          <div
            data-reveal
            style="--reveal-delay: 240ms"
            class:list={[
              "mx-auto mt-10",
              product.slug === "editor" ? "max-w-5xl" : "max-w-4xl",
            ]}
          >
            <ProductMediaFrame
              media={product.hero}
              variant={product.heroFrameVariant}
              accent={product.frameAccent}
            />
          </div>
        </div>
      </section>

      {/* ——— Quick answer ——— */}
      <section class="px-6 py-10">
        <div class="mx-auto max-w-3xl">
          <div data-reveal class="quick-answer relative overflow-hidden rounded-2xl border p-6 backdrop-blur-md lg:p-8">
            <p
              class="text-xs font-medium uppercase tracking-[0.18em]"
              style="color: var(--primary)"
            >
              {t("products.ui.inShort")}
            </p>
            <h2 class="mt-2 font-display text-xl font-medium tracking-tight">
              {copy.quickAnswer.question}
            </h2>
            <p
              class="mt-3 text-base leading-[1.8]"
              style="color: var(--muted-foreground)"
            >
              {copy.quickAnswer.answer}
            </p>
          </div>
        </div>
      </section>

      {/* ——— Capabilities ——— */}
      <section class="px-6 py-10 lg:py-12">
        <div class="mx-auto max-w-300">
          <p
            data-reveal
            class="mb-8 text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--muted-foreground)"
          >
            {t("products.ui.capabilities")}
          </p>
          {/*
            Editorial rhythm instead of an equal card grid: the first capability
            is a wide lead card with larger type; the rest pair up two per row
            on lg, alternating which side holds the wide card. Spans are derived
            from the index so any capability count fills the grid without holes:
            even counts tile exactly (2+1 / 1+2 / ...), an odd count promotes
            its lone last card to a full-width row.
          */}
          <div class="grid border-t sm:grid-cols-2 lg:grid-cols-3" style="border-color: var(--border)">
            {
              copy.capabilities.map((cap, index) => {
                const count = copy.capabilities.length;
                const isLead = index === 0;
                const isLast = index === count - 1;
                const isLoneLast = isLast && count % 2 === 1;
                // Paired rows on lg: even rows open with the wide card, odd
                // rows close with it.
                const wideSlot = index % 2 === Math.floor(index / 2) % 2;
                const spanClasses = [];
                if (isLead || (isLast && count % 2 === 0)) {
                  // Full-width bookends on the 2-column sm grid keep the
                  // in-between cards paired with no orphan cell.
                  spanClasses.push("sm:col-span-2");
                }
                if (isLoneLast) {
                  spanClasses.push("lg:col-span-3");
                } else {
                  // Explicit lg span so an sm:col-span-2 bookend narrows back
                  // down when the lg rhythm puts it in a narrow slot.
                  spanClasses.push(wideSlot ? "lg:col-span-2" : "lg:col-span-1");
                }
                return (
                  <div
                    data-reveal
                    class:list={[
                      "capability-card border-b p-6 lg:border-e",
                      spanClasses,
                      isLead && "capability-card-lead lg:p-8",
                    ]}
                    style={`--reveal-delay: ${index * 60}ms; border-color: var(--border)`}
                  >
                    <span
                      class="font-mono text-xs font-medium tabular-nums"
                      style="color: color-mix(in srgb, var(--primary) 75%, transparent)"
                    >
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3
                      class:list={[
                        "font-display font-medium tracking-tight",
                        isLead
                          ? "mt-4 max-w-xl text-2xl sm:text-3xl"
                          : "mt-3 text-lg",
                      ]}
                    >
                      {cap.title}
                    </h3>
                    <p
                      class:list={[
                        "leading-[1.8]",
                        isLead
                          ? "mt-3 max-w-xl text-base"
                          : "mt-2 max-w-lg text-sm",
                      ]}
                      style="color: var(--muted-foreground)"
                    >
                      {cap.body}
                    </p>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      {/* ——— Deep-dive sections ——— */}
      {
        sections.map((section, index) => (
          <section class="px-6 py-8 lg:py-10">
            <div
              class:list={[
                "mx-auto grid gap-8 border-t pt-8",
                !section.media
                  ? "max-w-3xl md:gap-10"
                  : product.slug === "cli-mcp"
                    ? "max-w-5xl md:gap-10"
                    : "max-w-5xl md:grid-cols-[minmax(0,.72fr)_minmax(0,1.28fr)] md:items-center md:gap-12",
              ]}
              style="border-color: var(--border)"
            >
              <div
                data-reveal
              >
                <span class="font-mono text-xs" style="color: var(--muted-foreground)">{String(index + 1).padStart(2, "0")}</span>
                <h2 class="font-display text-2xl font-medium tracking-tight sm:text-3xl">
                  {section.heading}
                </h2>
                <ul class="mt-5 space-y-3">
                  {section.bullets.map((bullet) => (
                    <li
                      class="flex items-start gap-2.5 text-sm leading-[1.7]"
                      style="color: var(--muted-foreground)"
                    >
                      <span
                        class="mt-[7px] block h-2 w-2 shrink-0 rounded-full"
                        style="background: var(--primary)"
                        aria-hidden="true"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {section.media && (
                <div data-reveal style={`--reveal-delay: ${80 + index * 30}ms`}>
                  <ProductMediaFrame
                    media={section.media}
                    compact
                    variant={section.frameVariant}
                    accent={product.frameAccent}
                  />
                </div>
              )}
            </div>
          </section>
        ))
      }

      {/* ——— Agent setup ——— */}
      {
        setup && (
          <section class="px-6 py-8 lg:py-10">
            <div
              class="mx-auto max-w-3xl border-t pt-8"
              style="border-color: var(--border)"
            >
              <h2 class="font-display text-2xl font-medium tracking-tight sm:text-3xl">
                {setup.heading}
              </h2>
              <p
                class="mt-4 text-sm leading-[1.7]"
                style="color: var(--muted-foreground)"
              >
                {setup.intro}
              </p>
              <SetupSnippet
                class="mt-4"
                copiedLabel={copiedLabel}
                copyFailedLabel={copyFailedLabel}
                copyLabel={copyLabel}
                text={setup.endpoint}
              />
              <div class="mt-8 space-y-7">
                {setup.clients.map((client) => (
                  <div>
                    <h3 class="font-display text-base font-medium">
                      {client.name}
                    </h3>
                    <p
                      class="mt-1.5 text-sm leading-[1.7]"
                      style="color: var(--muted-foreground)"
                    >
                      {client.body}
                    </p>
                    {client.snippet && (
                      <SetupSnippet
                        class="mt-3"
                        copiedLabel={copiedLabel}
                        copyFailedLabel={copyFailedLabel}
                        copyLabel={copyLabel}
                        text={client.snippet}
                      />
                    )}
                  </div>
                ))}
                <div>
                  <p
                    class="text-sm leading-[1.7]"
                    style="color: var(--muted-foreground)"
                  >
                    {setup.outro}
                  </p>
                  <SetupSnippet
                    class="mt-3"
                    copiedLabel={copiedLabel}
                    copyFailedLabel={copyFailedLabel}
                    copyLabel={copyLabel}
                    text={setup.outroSnippet}
                  />
                </div>
              </div>
            </div>
          </section>
        )
      }

      {product.slug === "cli-mcp" && <McpProofSection />}

      {/* ——— FAQ ——— */}
      <section class="px-6 py-10 lg:py-12">
        <div class="mx-auto max-w-3xl">
          <h2
            class="mb-6 text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--muted-foreground)"
          >
            {t("products.ui.faq")}
          </h2>
          <div class="divide-y" style="border-color: var(--border)">
            {
              copy.faqs.map((faq) => (
                <details class="product-faq group">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 py-4 font-display text-base font-medium">
                    {faq.question}
                    <span
                      class="product-faq-mark shrink-0 text-lg leading-none transition-transform"
                      style="color: var(--muted-foreground)"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <p
                    class="pb-5 text-sm leading-[1.8]"
                    style="color: var(--muted-foreground)"
                  >
                    {faq.answer}
                  </p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      {/* ——— Adjacent products ——— */}
      <section class="px-6 py-10 lg:py-12">
        <div class="mx-auto max-w-300">
          <h2
            class="mb-6 text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--muted-foreground)"
          >
            {t("products.ui.exploreMore")}
          </h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              adjacent.map((link) => (
                <a
                  href={link.href}
                  hreflang={link.hreflang}
                  class="adjacent-card flex flex-col rounded-2xl p-6 no-underline transition-[border-color,transform] duration-200"
                  style="background: var(--card); border: 1px solid var(--border); color: inherit"
                >
                  <span class="font-display text-base font-medium" style="color: var(--foreground)">
                    {t(link.titleKey)}
                  </span>
                  <span
                    class="mt-1.5 text-sm leading-[1.6]"
                    style="color: var(--muted-foreground)"
                  >
                    {link.body}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      {/* ——— CTA ——— */}
      <section class="px-6 py-28 lg:py-40">
        <div class="mx-auto max-w-3xl text-center">
          <h2
            data-reveal
            class="text-balance font-display text-4xl font-medium tracking-tight sm:text-5xl"
          >
            {copy.ctaHeading}
          </h2>
          <div class="mt-10">
            <a
              href={product.cta.href}
              data-reveal
              style="--reveal-delay: 120ms; background: var(--primary); color: var(--primary-foreground)"
              class="inline-flex h-11 items-center rounded-[0.85rem] px-6 text-sm font-medium transition-opacity hover:opacity-90"
            >
              {t(product.cta.label)}
            </a>
          </div>
        </div>
      </section>
    </main>

    <LandingFooter />
  </div>

  <style>
    .quick-answer {
      background: color-mix(in srgb, var(--card) 80%, transparent);
      border-color: color-mix(in srgb, var(--border) 90%, transparent);
      box-shadow: inset 0 1px 0 color-mix(in srgb, white 8%, transparent);
    }

    .capability-card {
      background: color-mix(in srgb, var(--card) 78%, transparent);
      border-color: color-mix(in srgb, var(--border) 90%, transparent);
      box-shadow: inset 0 1px 0 color-mix(in srgb, white 8%, transparent);
      transition:
        border-color 200ms,
        transform 200ms,
        box-shadow 200ms;
    }
    .capability-card:hover {
      border-color: color-mix(in srgb, var(--primary) 42%, var(--border));
      transform: translateY(-2px);
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, white 10%, transparent),
        0 18px 40px -30px rgba(0, 0, 0, 0.3);
    }
    .capability-card-lead {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--primary) 7%, var(--card)),
        color-mix(in srgb, var(--card) 78%, transparent)
      );
    }

    .product-faq[open] .product-faq-mark {
      transform: rotate(45deg);
    }
    .product-faq summary::-webkit-details-marker {
      display: none;
    }
    .adjacent-card:hover {
      border-color: var(--primary) !important;
      transform: translateY(-2px);
    }
  </style>
</Base>
