---
import Base from "../layouts/Base.astro";
import LandingFooter from "./LandingFooter.astro";
import PricingPlanPrice from "./PricingPlanPrice.astro";
import {
  billingIntervals,
  formatPrice,
  formatStorage,
  pricingPlans,
  yearlyTotal,
  type BillingInterval,
} from "../data/pricing";
import { appUrl, selfHostingUrl } from "../data/site-nav";
import { defaultLocale, isLocale, locales } from "../i18n/config";
import { catalogs, getTranslations, requireLinkedSegment } from "../i18n/utils";

// One template renders /pricing and /<lang>/pricing. Prose comes from the
// catalog (`pricing.*`); amounts and storage come from data/pricing.ts and are
// formatted for the page's locale, so a translation cannot change a price.
const rawLocale = Astro.currentLocale ?? defaultLocale;
const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
const t = getTranslations(locale);
const copy = catalogs[locale].pricing;
const { hreflang } = locales[locale];

const DEFAULT_INTERVAL: BillingInterval = "monthly";

const intervalLabels = {
  monthly: t("pricing.interval.monthly"),
  yearly: t("pricing.interval.yearly"),
} as const satisfies Record<BillingInterval, string>;

const plans = pricingPlans.map((plan) => {
  const perSeat = plan.seating.type === "perSeat";
  const storage = formatStorage(plan.storageGb, hreflang);
  const seatingLine = perSeat
    ? t("pricing.membersPerSeat")
    : t("pricing.members", { count: 1 });
  const storageLine = perSeat
    ? t("pricing.storagePerSeat", { storage })
    : t("pricing.storage", { storage });
  const unit = perSeat ? t("pricing.perSeatPerMonth") : t("pricing.perMonth");
  const planCopy = copy.plans[plan.id];

  const prices = (() => {
    switch (plan.price.type) {
      case "free": {
        return {
          type: "free" as const,
          amount: formatPrice(0, hreflang),
          note: copy.plans.free.priceNote,
        };
      }
      case "paid": {
        const total = formatPrice(
          yearlyTotal(plan.price.yearlyPerMonth),
          hreflang,
        );
        return {
          type: "paid" as const,
          monthly: {
            amount: formatPrice(plan.price.monthly, hreflang),
            note: t("pricing.billedMonthly"),
          },
          yearly: {
            amount: formatPrice(plan.price.yearlyPerMonth, hreflang),
            note: perSeat
              ? t("pricing.billedYearlyPerSeat", { total })
              : t("pricing.billedYearly", { total }),
          },
          unit,
        };
      }
      default: {
        const exhaustive: never = plan.price;
        return exhaustive;
      }
    }
  })();

  const cta = (() => {
    switch (plan.id) {
      case "free":
        return t("common.startFree");
      case "solo":
        return t("pricing.choosePlan", { plan: plan.name });
      case "team":
        return t("pricing.startEvaluation");
      default: {
        const exhaustive: never = plan;
        return exhaustive;
      }
    }
  })();

  return {
    id: plan.id,
    name: plan.name,
    summary: planCopy.summary,
    seatingLine,
    storageLine,
    features: Object.values(planCopy.features),
    prices,
    cta,
  };
});

const everyPlan = (["caseLaw", "keys", "selfHost"] as const).map((id) => ({
  id,
  title: copy.everyPlan[id].title,
  body: copy.everyPlan[id].body,
}));
const selfHostLink = requireLinkedSegment(
  "pricing.everyPlan.selfHost.body",
  copy.everyPlan.selfHost.body,
);

const faqs = Object.entries(copy.faqs).map(([id, faq]) => ({
  id,
  question: faq.question,
  answer: faq.answer,
}));
// The self-hosting answer links the guide; every locale marks the phrase.
const SELF_HOST_FAQ_ID = "5";
const selfHostFaqLink = requireLinkedSegment(
  `pricing.faqs.${SELF_HOST_FAQ_ID}.answer`,
  copy.faqs[SELF_HOST_FAQ_ID].answer,
);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: hreflang,
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer.replaceAll(/<\/?gh>/gu, ""),
    },
  })),
};
---

<Base
  title={copy.metaTitle}
  description={copy.metaDescription}
  current="pricing"
  translationScope="all-locales"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />

  <div class="pricing flex min-h-dvh flex-col">
    <main class="flex-1">
      {/* ——— Hero ——— */}
      <section class="px-6 pt-12 pb-8 lg:pt-16">
        <div class="mx-auto max-w-3xl text-center">
          <p
            data-reveal
            class="text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--primary)"
          >
            {t("nav.pricing")}
          </p>
          <h1
            data-reveal
            style="--reveal-delay: 80ms"
            class="mt-3 text-balance font-display text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl"
          >
            {copy.title}
          </h1>
          <p
            data-reveal
            style="--reveal-delay: 160ms; color: var(--muted-foreground)"
            class="mx-auto mt-5 max-w-2xl text-pretty text-lg leading-[1.7]"
          >
            {copy.subtitle}
          </p>
        </div>
      </section>

      {/* ——— Billing period ——— */}
      <section class="px-6 pb-8">
        <fieldset class="interval-switch mx-auto flex w-fit rounded-[0.85rem] p-1">
          <legend class="sr-only">{t("pricing.interval.label")}</legend>
          {
            billingIntervals.map((interval) => (
              <label class="interval-option relative inline-flex min-h-10 cursor-pointer items-center rounded-[0.6rem] px-4 text-sm font-medium">
                <input
                  type="radio"
                  name="billing-interval"
                  value={interval}
                  checked={interval === DEFAULT_INTERVAL}
                  class="sr-only"
                />
                {intervalLabels[interval]}
              </label>
            ))
          }
        </fieldset>
      </section>

      {/* ——— Plans ——— */}
      <section class="px-6 pb-6">
        <div class="mx-auto grid max-w-300 gap-4 lg:grid-cols-3">
          {
            plans.map((plan, index) => (
              <article
                data-reveal
                class="plan-card flex flex-col rounded-2xl border p-6 lg:p-8"
                style={`--reveal-delay: ${index * 60}ms`}
                aria-labelledby={`plan-${plan.id}`}
              >
                <h2
                  id={`plan-${plan.id}`}
                  class="font-display text-2xl font-medium tracking-tight"
                >
                  {plan.name}
                </h2>
                <p
                  class="mt-2 min-h-[3.4em] text-sm leading-[1.7]"
                  style="color: var(--muted-foreground)"
                >
                  {plan.summary}
                </p>

                <div class="mt-6 min-h-[5.5rem]">
                  {plan.prices.type === "free" ? (
                    <PricingPlanPrice
                      amount={plan.prices.amount}
                      note={plan.prices.note}
                    />
                  ) : (
                    billingIntervals.map((interval) => (
                      <div data-interval={interval}>
                        <PricingPlanPrice
                          amount={plan.prices[interval].amount}
                          unit={plan.prices.unit}
                          note={plan.prices[interval].note}
                        />
                      </div>
                    ))
                  )}
                </div>

                <a
                  href={appUrl}
                  class="plan-cta mt-6 inline-flex min-h-11 items-center justify-center rounded-[0.85rem] px-5 text-center text-sm font-medium transition-[border-color,background-color] duration-150"
                >
                  {plan.cta}
                </a>

                <ul class="mt-6 space-y-3 border-t pt-6" style="border-color: var(--border)">
                  {[plan.seatingLine, plan.storageLine, ...plan.features].map(
                    (feature) => (
                      <li
                        class="flex items-start gap-2.5 text-sm leading-[1.7]"
                        style="color: var(--muted-foreground)"
                      >
                        <span
                          class="mt-[7px] block h-2 w-2 shrink-0 rounded-full"
                          style="background: var(--primary)"
                          aria-hidden="true"
                        />
                        <span>{feature}</span>
                      </li>
                    ),
                  )}
                </ul>
              </article>
            ))
          }
        </div>
        <div
          class="mx-auto mt-5 flex max-w-300 flex-col gap-1 text-sm sm:flex-row sm:justify-between"
          style="color: var(--muted-foreground)"
        >
          <p>{copy.signUpNote}</p>
          {/* PLACEHOLDER for Jan: VAT treatment is undecided; confirm or replace this line. */}
          <p data-placeholder="vat">{copy.vatNote}</p>
        </div>
      </section>

      {/* ——— Included in every plan ——— */}
      <section class="px-6 py-10 lg:py-12">
        <div class="mx-auto max-w-300">
          <h2
            data-reveal
            class="mb-6 text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--muted-foreground)"
          >
            {copy.everyPlan.heading}
          </h2>
          <div class="grid border-t sm:grid-cols-3" style="border-color: var(--border)">
            {
              everyPlan.map((item, index) => (
                <div
                  data-reveal
                  class="border-b py-6 sm:pe-6"
                  style={`--reveal-delay: ${index * 60}ms; border-color: var(--border)`}
                >
                  <h3 class="font-display text-lg font-medium tracking-tight">
                    {item.title}
                  </h3>
                  <p
                    class="mt-2 text-sm leading-[1.8]"
                    style="color: var(--muted-foreground)"
                  >
                    {item.id === "selfHost" ? (
                      <>
                        {selfHostLink.before}
                        <a
                          href={selfHostingUrl}
                          class="underline underline-offset-2"
                          style="color: var(--foreground)"
                        >
                          {selfHostLink.linked}
                        </a>
                        {selfHostLink.after}
                      </>
                    ) : (
                      item.body
                    )}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {/* ——— FAQ ——— */}
      <section class="px-6 py-10 lg:py-12">
        <div class="mx-auto max-w-3xl">
          <h2
            class="mb-6 text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--muted-foreground)"
          >
            {t("products.ui.faq")}
          </h2>
          <div class="divide-y" style="border-color: var(--border)">
            {
              faqs.map((faq) => (
                <details class="pricing-faq group">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 py-4 font-display text-base font-medium">
                    {faq.question}
                    <span
                      class="pricing-faq-mark shrink-0 text-lg leading-none transition-transform"
                      style="color: var(--muted-foreground)"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <p
                    class="pb-5 text-sm leading-[1.8]"
                    style="color: var(--muted-foreground)"
                  >
                    {faq.id === SELF_HOST_FAQ_ID ? (
                      <>
                        {selfHostFaqLink.before}
                        <a
                          href={selfHostingUrl}
                          class="underline underline-offset-2"
                          style="color: var(--foreground)"
                        >
                          {selfHostFaqLink.linked}
                        </a>
                        {selfHostFaqLink.after}
                      </>
                    ) : (
                      faq.answer
                    )}
                  </p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      {/* ——— CTA ——— */}
      <section class="px-6 py-28 lg:py-40">
        <div class="mx-auto max-w-3xl text-center">
          <h2
            data-reveal
            class="text-balance font-display text-4xl font-medium tracking-tight sm:text-5xl"
          >
            {copy.ctaHeading}
          </h2>
          <div class="mt-10">
            <a
              href={appUrl}
              data-reveal
              style="--reveal-delay: 120ms; background: var(--primary); color: var(--primary-foreground)"
              class="inline-flex h-11 items-center rounded-[0.85rem] px-6 text-sm font-medium transition-opacity hover:opacity-90"
            >
              {t("common.startFree")}
            </a>
          </div>
        </div>
      </section>
    </main>

    <LandingFooter />
  </div>

  <style>
    /* Monthly is the server-rendered default; the radio group switches the
       visible price with CSS alone, so the page needs no script. */
    .pricing [data-interval="yearly"] {
      display: none;
    }
    .pricing:has(input[value="yearly"]:checked) [data-interval="yearly"] {
      display: block;
    }
    .pricing:has(input[value="yearly"]:checked) [data-interval="monthly"] {
      display: none;
    }

    .interval-switch {
      border: 1px solid var(--border);
      background: color-mix(in srgb, var(--card) 80%, transparent);
    }
    .interval-option {
      color: var(--muted-foreground);
      transition:
        background-color 150ms,
        color 150ms;
    }
    .interval-option:has(input:checked) {
      background: var(--background);
      color: var(--foreground);
      box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.08),
        0 0 0 1px var(--border);
    }
    .interval-option:has(input:focus-visible) {
      outline: 2px solid var(--ring, var(--primary));
      outline-offset: 2px;
    }

    .plan-card {
      background: color-mix(in srgb, var(--card) 80%, transparent);
      border-color: color-mix(in srgb, var(--border) 90%, transparent);
      box-shadow: inset 0 1px 0 color-mix(in srgb, white 8%, transparent);
    }

    .plan-cta {
      border: 1px solid var(--border);
      color: var(--foreground);
    }
    .plan-cta:hover {
      border-color: var(--primary);
      background: color-mix(in srgb, var(--primary) 6%, transparent);
    }

    .pricing-faq[open] .pricing-faq-mark {
      transform: rotate(45deg);
    }
    .pricing-faq summary::-webkit-details-marker {
      display: none;
    }
  </style>
</Base>
