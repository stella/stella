---
// "Ask any AI about stella" bar. One pre-baked prompt that names stella's own
// canonical pages and asks the model to cite them inline, so answers are
// grounded in first-party content. Copy it, or open it prefilled in a model —
// every supported model (including Gemini) accepts the prompt via `?q=`.
import { defaultLocale, isLocale } from "../i18n/config";
import { getTranslations } from "../i18n/utils";

const rawLocale = Astro.currentLocale ?? defaultLocale;
const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
const t = getTranslations(locale);
---

<div
  class="flex flex-col items-center gap-3"
  data-ask-ai
  data-copied-label={t("common.copied")}
  data-copy-label-default={t("askAi.copy")}
>
  <span
    class="text-xs font-medium tracking-[0.04em]"
    style="color: var(--muted-foreground)">{t("askAi.label")}</span
  >

  <div class="flex flex-wrap items-center justify-center gap-2">
    <button type="button" class="ask-pill" data-copy>
      <svg
        class="h-3.5 w-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
          d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg
      >
      <span data-copy-label>{t("askAi.copy")}</span>
    </button>
    <span class="mx-0.5 h-5 w-px" style="background: var(--border)" aria-hidden="true"></span>
    <a class="ask-pill" target="_blank" rel="noopener noreferrer" data-llm="chatgpt"
      >ChatGPT<span class="ask-ext rtl:inline-block rtl:-scale-x-100" aria-hidden="true">↗</span></a
    >
    <a class="ask-pill" target="_blank" rel="noopener noreferrer" data-llm="claude"
      >Claude<span class="ask-ext rtl:inline-block rtl:-scale-x-100" aria-hidden="true">↗</span></a
    >
    <a class="ask-pill" target="_blank" rel="noopener noreferrer" data-llm="perplexity"
      >Perplexity<span class="ask-ext rtl:inline-block rtl:-scale-x-100" aria-hidden="true">↗</span></a
    >
    <a class="ask-pill" target="_blank" rel="noopener noreferrer" data-llm="gemini"
      >Gemini<span class="ask-ext rtl:inline-block rtl:-scale-x-100" aria-hidden="true">↗</span></a
    >
    <a class="ask-pill" target="_blank" rel="noopener noreferrer" data-llm="grok"
      >Grok<span class="ask-ext rtl:inline-block rtl:-scale-x-100" aria-hidden="true">↗</span></a
    >
  </div>
</div>

<style>
  .ask-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.125rem;
    padding: 0 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card) 88%, transparent);
    color: var(--foreground);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 150ms,
      transform 150ms;
  }
  .ask-pill:hover {
    border-color: color-mix(in srgb, var(--foreground) 24%, var(--border));
    transform: translateY(-1px);
  }
  .ask-pill.is-copied {
    border-color: color-mix(in srgb, var(--primary) 55%, transparent);
    color: var(--primary);
  }
  .ask-ext {
    opacity: 0.5;
    font-size: 0.75rem;
  }
</style>

<script>
  import { Result } from "better-result";

  import { copyToClipboard } from "@stll/clipboard";

  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-ask-ai]");
    if (root) {
      // Canonical, first-party pages the model should read and cite.
      const SOURCES = [
        "https://stll.app/ai-info",
        "https://stll.app/llms-full.txt",
        "https://stll.app/",
        "https://stll.app/security",
      ].join(", ");

      const PROMPT = `What is stella? Use these canonical sources: ${SOURCES}. Summarize in 4 sentences: (1) what it is, (2) who it is for, (3) pricing, (4) security. Cite the sources inline.`;

      // Every supported model accepts the prompt via a `?q=` URL param.
      const LINKS: Record<string, (p: string) => string> = {
        chatgpt: (p) => `https://chatgpt.com/?q=${p}`,
        claude: (p) => `https://claude.ai/new?q=${p}`,
        perplexity: (p) => `https://www.perplexity.ai/search?q=${p}`,
        gemini: (p) => `https://gemini.google.com/app?q=${p}`,
        grok: (p) => `https://grok.com/?q=${p}`,
      };

      const encoded = encodeURIComponent(PROMPT);
      for (const a of root.querySelectorAll<HTMLAnchorElement>("[data-llm]")) {
        const builder = LINKS[a.dataset.llm ?? ""];
        if (builder) {
          a.href = builder(encoded);
        }
      }

      const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy]");
      const copyLabel = root.querySelector<HTMLElement>("[data-copy-label]");
      copyBtn?.addEventListener("click", async () => {
        // The copy failed: leave the pill on its default label.
        if (Result.isError(await copyToClipboard(PROMPT))) {
          return;
        }
        const copiedLabel = root.dataset.copiedLabel;
        const defaultLabel = root.dataset.copyLabelDefault;
        if (!(copyLabel && copiedLabel && defaultLabel)) {
          return;
        }
        copyBtn.classList.add("is-copied");
        copyLabel.textContent = copiedLabel;
        setTimeout(() => {
          copyBtn.classList.remove("is-copied");
          copyLabel.textContent = defaultLabel;
        }, 1400);
      });
    }
  });
</script>
