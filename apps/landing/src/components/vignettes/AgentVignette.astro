---
// Chrome-less chapter vignette: a question and a cited agent answer as floating
// styled components. The exchange mirrors the recorded Supplier Agreement world
// (the § 12.2 liability-cap change), so the homepage and the recordings tell one
// story. Decorative; strings stay English like the recorded scenes.
---

<div class="vignette-scene" aria-hidden="true">
  <div class="vignette-cluster">
    <div class="vignette-ask">What changed in the liability cap?</div>
    <div class="vignette-card vignette-answer">
      <p>
        Clause <span class="vignette-cite">§ 12.2</span> now caps liability at
        <span class="vignette-cite">100% of fees paid</span> in the preceding 12
        months; the previous draft had 300%. The change is tracked in the
        current redline.<span class="vignette-caret"></span>
      </p>
      <div class="vignette-sources">
        <span class="vignette-chip-static">
          Supplier_Agreement.docx · § 12.2
        </span>
        <span class="vignette-chip-static">Compare v3 → v4</span>
      </div>
    </div>
    <span class="vignette-chip vignette-chip-approval">
      Approved · read file
    </span>
  </div>
</div>

<style>
  .vignette-cluster {
    inline-size: min(30rem, 88%);
  }

  .vignette-ask {
    align-self: flex-end;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--muted-foreground) 10%, transparent);
    padding: 0.5rem 0.9rem;
    color: var(--foreground);
    font-size: 0.85rem;
  }

  .vignette-answer {
    margin-block-start: 1rem;
  }

  .vignette-answer p {
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .vignette-cite {
    color: var(--primary);
    font-weight: 500;
  }

  .vignette-caret {
    display: inline-block;
    inline-size: 1px;
    block-size: 0.9em;
    margin-inline-start: 0.15rem;
    vertical-align: text-bottom;
    background: var(--foreground);
    animation: vignette-caret-blink 1.1s steps(1) infinite;
  }

  .vignette-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.8rem;
  }

  .vignette-chip-static {
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    padding: 0.25rem 0.65rem;
    color: var(--muted-foreground);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .vignette-chip-approval {
    inset-block-start: -0.4rem;
    inset-inline-start: -2rem;
  }

  @keyframes vignette-caret-blink {
    0%,
    45% {
      opacity: 1;
    }
    50%,
    95% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vignette-caret {
      animation: none;
    }
  }
</style>
