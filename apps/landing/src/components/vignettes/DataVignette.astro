---
// Chrome-less chapter vignette: a case-law excerpt and a registry record as two
// floating styled components, with an anonymization chip; the three legs of the
// data chapter's copy. Decorative; strings stay English like the other vignettes
// (the sp. zn. citation follows the AgentAnswerPreview precedent).
---

<div class="vignette-scene" aria-hidden="true">
  <div class="vignette-cluster">
    <div class="vignette-card vignette-case">
    <p class="vignette-eyebrow">Case law · official source</p>
    <p class="vignette-case-title">6 Afs 34/2021 · Nejvyšší správní soud</p>
    <p class="vignette-case-excerpt">
      …performance obligations under <span class="vignette-cite">§ 1751</span>
      must be met within 30 days of written notice…
    </p>
    <div class="vignette-sources">
      <span class="vignette-chip-static">Cites 8 decisions</span>
      <span class="vignette-chip-static">Full text</span>
    </div>
  </div>
  <div class="vignette-card vignette-registry">
    <p class="vignette-eyebrow">Company registry</p>
    <p class="vignette-registry-name">Northstar Robotics, Inc.</p>
    <dl class="vignette-registry-rows">
      <div><dt>Reg. no.</dt><dd>184 02 995</dd></div>
      <div><dt>Seat</dt><dd>Wilmington, DE</dd></div>
      <div><dt>Status</dt><dd class="vignette-status">Active</dd></div>
    </dl>
  </div>
    <span class="vignette-chip vignette-chip-anon">
      Identifying details removed
    </span>
  </div>
</div>

<style>
  .vignette-cluster {
    inline-size: min(32rem, 92%);
  }

  .vignette-case {
    inline-size: min(26rem, 84%);
    align-self: flex-start;
  }

  .vignette-registry {
    inline-size: min(19rem, 70%);
    align-self: flex-end;
    margin-block-start: -1.25rem;
  }

  .vignette-eyebrow {
    color: var(--muted-foreground);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .vignette-case-title {
    margin-block-start: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .vignette-case-excerpt {
    margin-block-start: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .vignette-cite {
    color: var(--primary);
    font-weight: 500;
  }

  .vignette-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.75rem;
  }

  .vignette-chip-static {
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    padding: 0.25rem 0.65rem;
    color: var(--muted-foreground);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .vignette-registry-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .vignette-registry-rows {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-block-start: 0.6rem;
  }

  .vignette-registry-rows div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.75rem;
  }

  .vignette-registry-rows dt {
    color: var(--muted-foreground);
  }

  .vignette-registry-rows dd {
    font-variant-numeric: tabular-nums;
  }

  .vignette-status {
    color: var(--primary);
    font-weight: 500;
  }

  .vignette-chip-anon {
    inset-block-end: -0.9rem;
    inset-inline-start: -1rem;
  }
</style>
