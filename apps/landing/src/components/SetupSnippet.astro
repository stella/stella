---
// A copyable code snippet for the agent-setup section: the block is always
// LTR (it is code), the button sits in the code's own top-right corner, and
// its label comes pre-localized from the caller.
type Props = {
  class?: string;
  copiedLabel: string;
  copyFailedLabel: string;
  copyLabel: string;
  text: string;
};

const {
  class: className,
  copiedLabel,
  copyFailedLabel,
  copyLabel,
  text,
} = Astro.props;
---

<div class:list={["product-setup-snippet relative", className]} dir="ltr">
  <pre class="overflow-x-auto whitespace-pre pe-10"><code>{text}</code></pre>
  <!-- Empty on load so the browser treats later text as a live update, and
    the only place a failed copy is reported: the icon swap says "copied" and
    has nothing to say about a clipboard that refused. -->
  <span
    class="setup-copy-status absolute end-10 top-1.5 text-xs leading-7"
    role="status"
    aria-live="polite"
    data-copy-status
  ></span>
  <button
    type="button"
    class="setup-copy absolute end-1.5 top-1.5 inline-flex h-7 w-7 items-center justify-center rounded-md transition-colors"
    aria-label={copyLabel}
    title={copyLabel}
    data-copy-snippet={text}
    data-copy-label={copyLabel}
    data-copied-label={copiedLabel}
    data-copy-failed-label={copyFailedLabel}
  >
    <svg
      class="setup-copy-icon h-3.5 w-3.5"
      aria-hidden="true"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.8"
    >
      <path
        d="M9 9.5A1.5 1.5 0 0 1 10.5 8h8A1.5 1.5 0 0 1 20 9.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 9 18.5v-9Z"
      ></path>
      <path d="M6 15.5H5.5A1.5 1.5 0 0 1 4 14V5.5A1.5 1.5 0 0 1 5.5 4H14a1.5 1.5 0 0 1 1.5 1.5V6"></path>
    </svg>
    <svg
      class="setup-copied-icon h-3.5 w-3.5"
      aria-hidden="true"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="m5 12.5 5 5L19 7"></path>
    </svg>
  </button>
</div>

<style>
  .product-setup-snippet {
    background: color-mix(in srgb, var(--muted) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 90%, transparent);
    border-radius: 0.75rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    line-height: 1.6;
    padding: 0.75rem 1rem;
  }

  .setup-copy {
    color: var(--muted-foreground);
  }

  .setup-copy:hover {
    background: color-mix(in srgb, var(--muted) 80%, transparent);
    color: var(--foreground);
  }

  .setup-copied-icon {
    display: none;
  }

  .setup-copy-status {
    color: var(--destructive, #dc2626);
  }

  .setup-copy.is-copied .setup-copy-icon {
    display: none;
  }

  .setup-copy.is-copied .setup-copied-icon {
    display: block;
    color: var(--success);
  }
</style>

<script>
  import { Result } from "better-result";

  import { copyToClipboard } from "@stll/clipboard";

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-snippet]",
  )) {
    button.addEventListener("click", async () => {
      const text = button.dataset["copySnippet"];
      if (!text) {
        return;
      }
      const status = button.parentElement?.querySelector("[data-copy-status]");
      if (Result.isError(await copyToClipboard(text))) {
        // The clipboard refused (denied permission, insecure context). Say so
        // where the confirmation would have gone, rather than going quiet.
        if (status) {
          status.textContent = button.dataset["copyFailedLabel"] ?? "";
        }
        return;
      }
      if (status) {
        status.textContent = "";
      }
      button.classList.add("is-copied");
      const copied = button.dataset["copiedLabel"];
      if (copied) {
        button.setAttribute("aria-label", copied);
        button.setAttribute("title", copied);
      }
      setTimeout(() => {
        button.classList.remove("is-copied");
        const label = button.dataset["copyLabel"];
        if (label) {
          button.setAttribute("aria-label", label);
          button.setAttribute("title", label);
        }
      }, 1400);
    });
  }
</script>
