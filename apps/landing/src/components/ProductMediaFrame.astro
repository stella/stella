---
import { existsSync } from "node:fs";
import path from "node:path";
import type { FrameAccent, FrameVariant, ProductMedia } from "../data/products/types";
import { productStoryThumbnails } from "../data/product-story";
import MediaSkeleton from "./MediaSkeleton.astro";
import ThemeImage from "./ThemeImage.astro";
import { ProductPreview } from "./react/previews/ProductPreview";
import { CliMcpPreview } from "./react/previews/CliMcpPreview";

type Props = {
  media: ProductMedia;
  compact?: boolean;
  deferThemeImage?: boolean;
  thumbnail?: boolean;
  /**
   * Frame background recipe; "wash" keeps the neutral glass gradient and is
   * the default (menu thumbnails always stay on it for calm).
   */
  variant?: FrameVariant;
  /** Accent hue for the "bloom" glow, from `frameAccents`. */
  accent?: FrameAccent;
};
const {
  media,
  compact = false,
  deferThemeImage = false,
  thumbnail = false,
  variant = "wash",
  accent,
} = Astro.props;
const aspect = media.aspect ?? "16 / 9";
const accentStyle = accent === undefined ? "" : `; --frame-accent: ${accent}`;

// A video slot upgrades from skeleton to <video> the moment its file lands in
// public/. The build's cwd is the Astro project dir (apps/landing), so resolve
// public assets from there; this runs at build time with no data edits.
const videoOnDisk = (p: string) => existsSync(path.join(process.cwd(), "public", p));
const videoReady = media.type === "video" && videoOnDisk(media.src);
const posterReady = media.type === "video" && media.poster !== undefined && videoOnDisk(media.poster);
const storyThumbnail = media.type === "story" ? productStoryThumbnails[media.sceneId] : undefined;
---

<div
  class:list={[
    "product-media relative overflow-hidden",
    variant === "bloom" && "frame-bloom",
    compact
      ? "rounded-xl p-1.5"
      : "rounded-[2rem] p-[clamp(1rem,3vw,2.5rem)]",
  ]}
  style={`aspect-ratio: ${aspect}${accentStyle}`}
>
  {
    variant === "ripple" && (
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="frame-ripple-layer frame-ripple-light" />
        <div class="frame-ripple-layer frame-ripple-dark" />
      </div>
    )
  }

  <div
    class="pointer-events-none absolute -top-1/2 start-[8%] z-10 h-full w-[42%] rotate-[18deg] rounded-full blur-3xl"
    style="background: color-mix(in srgb, white 20%, transparent)"
    aria-hidden="true"
  >
  </div>

  {
    media.type === "preview" && (
      <div class="absolute inset-0">
        <ProductPreview client:visible previewKey={media.key} />
      </div>
    )
  }

  {
    media.type === "story" && !thumbnail && !compact && (
      <div class="absolute inset-0">
        <CliMcpPreview
          client:visible
          sceneId={media.sceneId}
          showCompanions={media.showCompanions ?? false}
        />
      </div>
    )
  }

  {
    media.type === "story" && !thumbnail && compact && (
      <div class="absolute inset-0">
        <CliMcpPreview
          includeStyles={false}
          sceneId={media.sceneId}
          showCompanions={media.showCompanions ?? false}
        />
      </div>
    )
  }

  {
    media.type === "story" && thumbnail && storyThumbnail && (
      <ThemeImage
        lightSrc={storyThumbnail.src}
        darkSrc={storyThumbnail.darkSrc}
        alt={storyThumbnail.alt}
        class="relative z-1 h-full w-full rounded-lg border object-cover object-top"
        style="border-color: color-mix(in srgb, var(--border) 70%, transparent); box-shadow: 0 18px 42px -30px rgba(0, 0, 0, 0.5)"
        loading="lazy"
        decoding="async"
        defer={deferThemeImage ? "manual" : undefined}
      />
    )
  }

  {
    media.type === "image" && (
      <ThemeImage
        lightSrc={media.src}
        darkSrc={media.darkSrc}
        alt={media.alt}
        class={`relative z-1 h-full w-full border object-cover object-top ${compact ? "rounded-lg" : "rounded-[1.1rem]"}`}
        style="border-color: color-mix(in srgb, var(--border) 70%, transparent); box-shadow: 0 28px 70px -38px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255,255,255,.24)"
        loading="lazy"
        decoding="async"
        defer={deferThemeImage ? "manual" : undefined}
      />
    )
  }

  {
    media.type === "video" && videoReady && (
      <video
        class="absolute inset-0 h-full w-full object-cover"
        poster={posterReady ? media.poster : undefined}
        aria-label={media.alt}
        autoplay
        muted
        loop
        playsinline
      >
        <source src={media.src} type="video/mp4" />
      </video>
    )
  }

  {media.type === "video" && !videoReady && <MediaSkeleton note={media.alt} />}

  {media.type === "placeholder" && <MediaSkeleton note={media.note} />}
</div>

<style>
  /* Neutral glass base shared by every recipe; "wash" is exactly this. The
     variants layer on top of it so the frame never loses its glass footing. */
  .product-media {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--card) 88%, var(--background)),
      color-mix(in srgb, var(--muted) 52%, var(--background))
    );
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 22%, transparent);
  }

  /* "bloom": a radial accent glow anchored to the frame's end corner via
     logical insets, so it mirrors correctly under RTL like the sheen does.
     The accent stays at a low mix percentage; it is a background, never a
     competitor to the screenshot. ::before paints below every positioned
     child (tree order), keeping the glow under the media. */
  .frame-bloom::before {
    content: "";
    position: absolute;
    pointer-events: none;
    inset-block-start: -22%;
    inset-inline-end: -14%;
    inline-size: 62%;
    block-size: 78%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--frame-accent, var(--auth-gradient-end)) 12%, transparent),
      transparent
    );
  }

  /* "ripple": a faint excerpt of the hero gradient artwork under the glass,
     theme-switched with the same light/dark opacity toggle the hero and the
     footer art use. Static background-image only; no animation in frames. */
  .frame-ripple-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    transition: opacity 500ms ease;
  }

  .frame-ripple-light {
    background-image: url("/images/gradients/hero-light.svg");
    opacity: 0.4;
  }

  .frame-ripple-dark {
    background-image: url("/images/gradients/hero-dark.svg");
    opacity: 0;
  }

  :global(.dark) .frame-ripple-light {
    opacity: 0;
  }

  :global(.dark) .frame-ripple-dark {
    opacity: 0.35;
  }
</style>
