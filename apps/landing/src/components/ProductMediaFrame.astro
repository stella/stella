---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { ProductMedia } from "../data/products/types";
import MediaSkeleton from "./MediaSkeleton.astro";
import { ProductPreview } from "./react/previews/ProductPreview";

type Props = { media: ProductMedia };
const { media } = Astro.props;
const aspect = media.aspect ?? "16 / 9";

// A video slot upgrades from skeleton to <video> the moment its file lands in
// public/. The build's cwd is the Astro project dir (apps/landing), so resolve
// public assets from there; this runs at build time with no data edits.
const videoOnDisk = (p: string) => existsSync(join(process.cwd(), "public", p));
const videoReady = media.type === "video" && videoOnDisk(media.src);
const posterReady = media.type === "video" && media.poster !== undefined && videoOnDisk(media.poster);
---

<div
  class="product-media relative overflow-hidden rounded-[1.45rem] border backdrop-blur-md"
  style={`aspect-ratio: ${aspect}; border-color: color-mix(in srgb, var(--border) 90%, transparent); background: color-mix(in srgb, var(--card) 78%, transparent); box-shadow: inset 0 1px 0 color-mix(in srgb, white 10%, transparent), 0 18px 40px -28px rgba(0, 0, 0, 0.28)`}
>
  {/* Glass light catch, matching the homepage showcase tiles. */}
  <div
    class="pointer-events-none absolute inset-0 z-10"
    style="background: linear-gradient(180deg, color-mix(in srgb, white 7%, transparent) 0%, transparent 38%)"
    aria-hidden="true"
  >
  </div>

  {
    media.type === "preview" && (
      <div class="absolute inset-0">
        <ProductPreview previewKey={media.key} />
      </div>
    )
  }

  {
    media.type === "image" && (
      <img
        src={media.src}
        alt={media.alt}
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    )
  }

  {
    media.type === "video" && videoReady && (
      <video
        class="absolute inset-0 h-full w-full object-cover"
        poster={posterReady ? media.poster : undefined}
        aria-label={media.alt}
        autoplay
        muted
        loop
        playsinline
      >
        <source src={media.src} type="video/mp4" />
      </video>
    )
  }

  {media.type === "video" && !videoReady && <MediaSkeleton note={media.alt} />}

  {media.type === "placeholder" && <MediaSkeleton note={media.note} />}
</div>
