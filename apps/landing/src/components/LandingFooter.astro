---
import {
  connectLinks,
  isExternal,
  productNavEntries,
  resolveNavLabel,
  resolveNavLinks,
  resourceLinks,
} from "../data/site-nav";
import { productHref } from "../data/products/links";
import { defaultLocale, isLocale, locales } from "../i18n/config";
import { getTranslations } from "../i18n/utils";

const rawLocale = Astro.currentLocale ?? defaultLocale;
const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
const t = getTranslations(locale);
const arrow = locales[locale].dir === "rtl" ? "←" : "→";

const columns = [
  {
    heading: t("nav.product"),
    links: productNavEntries.map((product) => ({
      label: resolveNavLabel(product.footerLabel, t),
      href: productHref(product.slug, locale),
    })),
  },
  {
    heading: t("footer.resources"),
    links: resolveNavLinks(resourceLinks, t),
  },
  {
    heading: t("footer.connect"),
    links: resolveNavLinks(connectLinks, t),
  },
];

const legalLinks = [
  { label: t("footer.terms"), href: "/terms" },
  { label: t("footer.imprint"), href: "/imprint" },
];
---

<footer class="footer-shell relative overflow-hidden">
  <div
    id="footer-gradient-light"
    class="footer-art footer-art-light pointer-events-none absolute"
    aria-hidden="true"
  ></div>
  <div
    id="footer-gradient-dark"
    class="footer-art footer-art-dark pointer-events-none absolute"
    aria-hidden="true"
  ></div>
  <div class="relative z-10 mx-auto max-w-300 px-6 pb-5 pt-12 sm:pb-8 sm:pt-20">
    <div class="grid gap-10 sm:gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <span class="inline-flex">
          <img
            src={locale === "ar" ? "/images/stella-logo-ar.svg" : "/images/stella-logo.svg"}
            alt="stella"
            class="h-9 w-auto dark:invert"
          />
        </span>
        <p class="mt-5 max-w-80 text-balance text-base leading-relaxed" style="color: var(--muted-foreground)">
          {t("footer.tagline")}
        </p>

      </div>

      <nav class="grid grid-cols-3 gap-x-4 sm:gap-x-6 lg:col-span-8" aria-label={t("footer.navLabel")}>
        {columns.map((column) => (
          <section>
            <h2 class="footer-heading text-sm font-semibold" style="color: var(--foreground)">{column.heading}</h2>
            <ul class="footer-link-list mt-3 sm:mt-5 sm:space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    class="footer-link group inline-grid min-h-11 grid-cols-[1fr_auto] items-center gap-1 text-xs sm:min-h-6 sm:items-baseline sm:gap-2 sm:text-sm"
                    href={link.href}
                    target={isExternal(link.href) ? "_blank" : undefined}
                    rel={isExternal(link.href) ? "noopener noreferrer" : undefined}
                  >
                    <span class="footer-link-label">{link.label}</span>
                    <span class="footer-arrow" aria-hidden="true">{arrow}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t pt-4 text-sm sm:mt-16 sm:flex-row sm:items-center sm:justify-between" style="border-color: var(--border)">
      <nav class="flex gap-6" aria-label={t("footer.legal")}>
        {legalLinks.map((link) => (
          <a class="footer-link group inline-grid grid-cols-[1fr_auto] items-baseline gap-2" href={link.href}>
            <span>{link.label}</span>
            <span class="footer-arrow" aria-hidden="true">{arrow}</span>
          </a>
        ))}
      </nav>
      <p class="font-display text-base font-medium" style="color: var(--foreground)">
        {t("footer.clarity")}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-shell {
    background: var(--background);
  }

  .footer-art {
    inset: -12%;
    transition: opacity 500ms ease;
    /* The art box extends 12% past the footer on every side, so the
       overflow clip lands at 12 / 124 ≈ 9.7% of this element's height.
       Dissolve the artwork to transparent above that point so no hard
       edge appears where the clip cuts it at the footer's top boundary. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 9.7%,
      black 38%
    );
    mask-image: linear-gradient(to bottom, transparent 9.7%, black 38%);
  }

  .footer-art-light {
    opacity: 0.38;
  }

  .footer-art-dark {
    opacity: 0;
  }

  :global(.dark) .footer-art-light {
    opacity: 0;
  }

  :global(.dark) .footer-art-dark {
    opacity: 0.3;
  }

.footer-shell:has(.footer-link:hover) .footer-link:not(:hover),
.footer-shell:has(.footer-link:focus-visible) .footer-link:not(:focus-visible) {
  opacity: 0.52;
}

.footer-shell:has(.footer-link:hover) .footer-heading,
.footer-shell:has(.footer-link:focus-visible) .footer-heading {
  opacity: 0.52;
}

  .footer-heading {
    transition: opacity 180ms ease;
  }

  .footer-link {
    position: relative;
    color: var(--muted-foreground);
    transition: color 180ms ease, opacity 180ms ease;
  }

  .footer-link::before {
    position: absolute;
    content: "";
    inset-block: -0.625rem;
    inset-inline: 0;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--foreground);
  }

  .footer-arrow {
    display: none;
    opacity: 0;
    transform: translateX(-0.35rem);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .footer-link-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (min-width: 640px) {
    .footer-arrow {
      display: inline-block;
    }
  }

  [dir="rtl"] .footer-arrow {
    transform: translateX(0.35rem);
  }

  .footer-link:hover .footer-arrow,
  .footer-link:focus-visible .footer-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .footer-heading,
    .footer-arrow {
      transition: none;
    }
  }
</style>
