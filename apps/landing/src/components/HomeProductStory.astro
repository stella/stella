---
import type { TranslationKey } from "../data/site-nav";
import { defaultLocale, isLocale } from "../i18n/config";
import { getTranslations } from "../i18n/utils";
import { CliMcpPreview } from "./react/previews/CliMcpPreview";
import ThemeImage from "./ThemeImage.astro";

const rawLocale = Astro.currentLocale ?? defaultLocale;
const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
const t = getTranslations(locale);

// Copy is referenced by TranslationKey (not literal strings) so a renamed or
// removed message key fails typecheck instead of rendering the raw key.
type StoryChapter = {
  id: "workspace" | "agent" | "data";
  eyebrowKey: TranslationKey;
  titleKey: TranslationKey;
  bodyKey: TranslationKey;
  links: readonly { labelKey: TranslationKey; href: string }[];
};

const chapters = [
  {
    id: "workspace",
    eyebrowKey: "story.workspaceEyebrow",
    titleKey: "story.workspaceTitle",
    bodyKey: "story.workspaceBody",
    links: [
      { labelKey: "story.exploreWorkspace", href: "/product/workspace" },
      { labelKey: "story.openEditor", href: "/product/editor" },
      {
        labelKey: "story.exploreTabularReview",
        href: "/product/tabular-review",
      },
    ],
  },
  {
    id: "agent",
    eyebrowKey: "story.agentEyebrow",
    titleKey: "story.agentTitle",
    bodyKey: "story.agentBody",
    links: [
      { labelKey: "story.exploreAgent", href: "/product/agent" },
      { labelKey: "story.exploreTemplates", href: "/product/templates" },
    ],
  },
  {
    id: "data",
    eyebrowKey: "story.dataEyebrow",
    titleKey: "story.dataTitle",
    bodyKey: "story.dataBody",
    links: [
      { labelKey: "story.explorePublicData", href: "/product/public-data" },
      { labelKey: "story.exploreAnonymization", href: "/product/anonymization" },
    ],
  },
] as const satisfies readonly StoryChapter[];

const proofItems = [
  { titleKey: "story.proofOpenSourceTitle", bodyKey: "story.proofOpenSourceBody" },
  { titleKey: "story.proofSelfHostTitle", bodyKey: "story.proofSelfHostBody" },
  { titleKey: "story.proofByokTitle", bodyKey: "story.proofByokBody" },
  { titleKey: "story.proofPermissionsTitle", bodyKey: "story.proofPermissionsBody" },
] as const satisfies readonly { titleKey: TranslationKey; bodyKey: TranslationKey }[];
---

<section class="home-product-story px-4 py-20 sm:px-6 lg:py-28" aria-labelledby="product-story-title">
  <div class="mx-auto max-w-300">
    <div class="max-w-4xl">
      <p
        data-reveal
        class="text-xs font-medium uppercase tracking-[0.2em]"
        style="color: var(--muted-foreground)"
      >
        {t("story.eyebrow")}
      </p>
      <h2
        data-reveal
        id="product-story-title"
        style="--reveal-delay: 80ms"
        class="mt-3 max-w-4xl text-balance font-display text-4xl font-medium leading-[1.04] sm:text-5xl lg:text-6xl"
      >
        {t("story.title")}
      </h2>
      <p
        data-reveal
        style="--reveal-delay: 160ms; color: var(--muted-foreground)"
        class="mt-5 max-w-2xl text-pretty text-base leading-7 sm:text-lg sm:leading-8"
      >
        {t("story.intro")}
      </p>
    </div>

    <div class="mt-16 space-y-24 lg:mt-24 lg:space-y-36">
      {
        chapters.map((chapter, index) => (
          <article
            class:list={[
              "product-chapter grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12",
              index % 2 === 1 && "product-chapter-reverse",
            ]}
            id={`story-${chapter.id}`}
          >
            <div
              data-reveal
              class:list={[
                "product-chapter-copy lg:col-span-4",
                index % 2 === 1 ? "lg:col-start-9" : "lg:col-start-1",
              ]}
            >
              <p
                class="text-xs font-medium uppercase tracking-[0.2em]"
                style="color: var(--muted-foreground)"
              >
                {t(chapter.eyebrowKey)}
              </p>
              <h3 class="mt-3 text-balance font-display text-3xl font-medium leading-[1.08] sm:text-4xl">
                {t(chapter.titleKey)}
              </h3>
              <p
                class="mt-5 text-pretty text-base leading-7"
                style="color: var(--muted-foreground)"
              >
                {t(chapter.bodyKey)}
              </p>
              <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-1" aria-label={t(chapter.eyebrowKey)}>
                {chapter.links.map((link) => (
                  <a class="story-link group inline-flex min-h-11 items-center gap-2 text-sm font-medium" href={link.href}>
                    <span>{t(link.labelKey)}</span>
                    <span
                      aria-hidden="true"
                      class="transition-transform rtl:-scale-x-100 ltr:group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5"
                    >
                      →
                    </span>
                  </a>
                ))}
              </nav>
            </div>

            <div
              data-reveal
              style={`--reveal-delay: ${120 + index * 30}ms`}
              class:list={[
                "product-chapter-visual lg:col-span-8",
                index % 2 === 1 ? "lg:col-start-1 lg:row-start-1" : "lg:col-start-5",
              ]}
            >
              {chapter.id === "workspace" && (
                <div class="story-window">
                  <CliMcpPreview
                    client:visible
                    backdrop="transparent"
                    includeStyles={false}
                    sceneId="workspace"
                    showCompanions={false}
                  />
                </div>
              )}
              {chapter.id === "agent" && (
                <div class="story-window">
                  <CliMcpPreview
                    client:visible
                    backdrop="transparent"
                    includeStyles={false}
                    sceneId="agent"
                    showCompanions={false}
                  />
                </div>
              )}
              {chapter.id === "data" && (
                <div class="story-window story-window-shot">
                  <div class="story-shot-main">
                    <ThemeImage
                      lightSrc="/media/products/story-public-data.png"
                      darkSrc="/media/products/story-public-data-dark.png"
                      alt={t("story.dataMainAlt")}
                      class="h-full w-full object-cover object-top"
                      loading="lazy"
                      decoding="async"
                      defer="visible"
                    />
                  </div>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="relative px-4 pb-20 sm:px-6 lg:pb-28" aria-labelledby="control-title">
  <div class="control-rail mx-auto max-w-300 overflow-hidden rounded-[1.65rem]">
    <div class="grid gap-8 p-7 sm:p-9 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,2.65fr)] lg:items-center lg:p-12">
      <div data-reveal>
        <p
          class="text-xs font-medium uppercase tracking-[0.2em]"
          style="color: var(--muted-foreground)"
        >
          {t("story.controlEyebrow")}
        </p>
        <h2 id="control-title" class="mt-3 text-balance font-display text-3xl font-medium leading-[1.08] sm:text-4xl">
          {t("story.controlTitle")}
        </h2>
        <p
          class="mt-4 text-pretty text-base leading-7"
          style="color: var(--muted-foreground)"
        >
          {t("story.controlBody")}
        </p>
      </div>
      <ul class="proof-list grid sm:grid-cols-2" data-reveal style="--reveal-delay: 100ms">
        {
          proofItems.map((item) => (
            <li>
              <strong>{t(item.titleKey)}</strong>
              <span>{t(item.bodyKey)}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="deployment-band flex flex-col gap-6 px-7 py-6 sm:px-9 lg:flex-row lg:items-center lg:justify-between lg:px-12">
      <div>
        <h3 class="font-display text-xl font-medium">{t("story.deployTitle")}</h3>
        <p class="mt-1 text-sm leading-6" style="color: var(--muted-foreground)">
          {t("story.deploySubtitle")}
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-3">
        <a
          href="https://github.com/stella/stella/blob/main/docs/self-hosting.md"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-[0.75rem] px-4 text-sm font-medium transition-opacity hover:opacity-75"
        >
          {t("story.selfHostGuide")}
        </a>
        <a
          href="https://github.com/stella/stella"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-[0.75rem] px-4 text-sm font-medium transition-opacity hover:opacity-75"
        >
          {t("story.sourceOnGitHub")}
        </a>
        <a
          href="https://my.stll.app"
          class="inline-flex min-h-11 items-center rounded-[0.75rem] px-5 text-sm font-medium transition-opacity hover:opacity-90"
          style="background: var(--primary); color: var(--primary-foreground)"
        >
          {t("common.startFree")}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-product-story {
    position: relative;
  }

  /* Frameless chapter windows: the app window itself (chrome, border, its
     own shadow) is the only frame; the container just reserves the aspect
     and lets the shadow breathe. On wide screens the window bleeds slightly
     past the text container on its outer side (the page-level overflow clip
     crops at the viewport), so each capability peeks into the page. */
  .story-window {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  /* The data chapter's screenshot is captured at 1440x760 (see
     apps/web/e2e/marketing/product-screenshots.spec.ts, "story-public-data");
     match that aspect exactly so object-cover doesn't crop the case-law
     reader's side panels off camera. */
  .story-window-shot {
    aspect-ratio: 1440 / 760;
  }

  .story-shot-main {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--foreground) 11%, transparent);
    border-radius: 0.9rem;
    background: var(--background);
    box-shadow: 0 42px 110px -54px rgba(15, 23, 42, 0.5);
  }

  @media (min-width: 1024px) {
    .product-chapter:not(.product-chapter-reverse) .story-window {
      margin-inline-end: -3.5rem;
    }

    .product-chapter-reverse .story-window {
      margin-inline-start: -3.5rem;
    }
  }

  @media (max-width: 639px) {
    .story-window {
      aspect-ratio: 4 / 3;
    }
  }

  /* Liquid-glass control rail: a thin translucent layer with a strong blur
     and saturation boost, a bright specular top edge, and a diagonal sheen.
     Solid fallbacks below for browsers without backdrop-filter and for
     reduced-transparency users. */
  .control-rail {
    background: color-mix(in srgb, var(--card) 52%, transparent);
    -webkit-backdrop-filter: blur(26px) saturate(1.7);
    backdrop-filter: blur(26px) saturate(1.7);
    border: 1px solid color-mix(in srgb, white 34%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 55%, transparent),
      inset 0 -1px 0 color-mix(in srgb, white 12%, transparent),
      0 36px 90px -58px color-mix(in srgb, var(--foreground) 45%, transparent);
  }

  :global(.dark) .control-rail {
    border-color: color-mix(in srgb, white 14%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 20%, transparent),
      inset 0 -1px 0 color-mix(in srgb, white 6%, transparent),
      0 36px 90px -58px rgba(0, 0, 0, 0.8);
  }

  .control-rail::before {
    position: absolute;
    content: "";
    pointer-events: none;
    inset: 0;
    background: linear-gradient(
      115deg,
      color-mix(in srgb, white 30%, transparent),
      transparent 24%,
      transparent 70%,
      color-mix(in srgb, var(--auth-gradient-end) 14%, transparent)
    );
  }

  :global(.dark) .control-rail::before {
    background: linear-gradient(
      115deg,
      color-mix(in srgb, white 10%, transparent),
      transparent 24%,
      transparent 70%,
      color-mix(in srgb, var(--auth-gradient-end) 18%, transparent)
    );
  }

  /* Glass needs backdrop-filter; without it (or when the user asks for
     reduced transparency) the rail falls back to a solid card. */
  @supports not (backdrop-filter: blur(1px)) {
    .control-rail {
      background: color-mix(in srgb, var(--card) 92%, var(--background));
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .control-rail {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: color-mix(in srgb, var(--card) 92%, var(--background));
    }
  }

  .story-link {
    color: var(--foreground);
    text-decoration: none;
  }

  .story-link:hover,
  .story-link:focus-visible {
    opacity: 0.68;
  }

  .control-rail {
    position: relative;
  }

  .proof-list {
    grid-auto-rows: 1fr;
  }

  .proof-list li {
    display: flex;
    min-height: 6.5rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    border-block-start: 1px solid var(--border);
    padding-block: 1.25rem;
  }

  .proof-list li:first-child {
    border-block-start: 0;
  }

  .proof-list li:nth-child(odd) {
    padding-inline-end: 1.5rem;
  }

  .proof-list li:nth-child(even) {
    padding-inline-start: 1.5rem;
  }

  .proof-list strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .proof-list span {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .deployment-band {
    position: relative;
    border-block-start: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 56%, transparent);
  }

  @media (min-width: 640px) {
    .proof-list li:nth-child(even) {
      border-inline-start: 1px solid var(--border);
    }

    /* In the two-column grid the second cell sits in the first row, so its
       top border would draw the same stray line above the list. */
    .proof-list li:nth-child(2) {
      border-block-start: 0;
    }
  }

  @media (max-width: 639px) {
    .proof-list li:nth-child(odd),
    .proof-list li:nth-child(even) {
      padding-inline: 0;
    }
  }
</style>
