---
import { type FrameVariant, frameAccents } from "../data/products/types";
import type { TranslationKey } from "../data/site-nav";
import { defaultLocale, isLocale } from "../i18n/config";
import { getTranslations } from "../i18n/utils";
import { CliMcpPreview } from "./react/previews/CliMcpPreview";
import ThemeImage from "./ThemeImage.astro";

const rawLocale = Astro.currentLocale ?? defaultLocale;
const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
const t = getTranslations(locale);

// Copy is referenced by TranslationKey (not literal strings) so a renamed or
// removed message key fails typecheck instead of rendering the raw key.
type StoryChapter = {
  id: "workspace" | "agent" | "data";
  eyebrowKey: TranslationKey;
  titleKey: TranslationKey;
  bodyKey: TranslationKey;
  links: readonly { labelKey: TranslationKey; href: string }[];
};

const chapters = [
  {
    id: "workspace",
    eyebrowKey: "story.workspaceEyebrow",
    titleKey: "story.workspaceTitle",
    bodyKey: "story.workspaceBody",
    links: [
      { labelKey: "story.exploreWorkspace", href: "/product/workspace" },
      { labelKey: "story.openEditor", href: "/product/editor" },
      {
        labelKey: "story.exploreTabularReview",
        href: "/product/tabular-review",
      },
    ],
  },
  {
    id: "agent",
    eyebrowKey: "story.agentEyebrow",
    titleKey: "story.agentTitle",
    bodyKey: "story.agentBody",
    links: [
      { labelKey: "story.exploreAgent", href: "/product/agent" },
      { labelKey: "story.exploreTemplates", href: "/product/templates" },
    ],
  },
  {
    id: "data",
    eyebrowKey: "story.dataEyebrow",
    titleKey: "story.dataTitle",
    bodyKey: "story.dataBody",
    links: [
      { labelKey: "story.explorePublicData", href: "/product/public-data" },
      { labelKey: "story.exploreAnonymization", href: "/product/anonymization" },
    ],
  },
] as const satisfies readonly StoryChapter[];

// Deliberate frame-recipe assignment: three chapters, three recipes, so no
// two adjacent homepage visuals repeat a background. The agent chapter blooms
// with the agent scene's own ember accent; the data chapter carries a faint
// ripple of the hero artwork; the workspace chapter keeps the neutral wash.
const chapterFrameVariants = {
  workspace: "wash",
  agent: "bloom",
  data: "ripple",
} as const satisfies Record<StoryChapter["id"], FrameVariant>;

const proofItems = [
  { titleKey: "story.proofOpenSourceTitle", bodyKey: "story.proofOpenSourceBody" },
  { titleKey: "story.proofSelfHostTitle", bodyKey: "story.proofSelfHostBody" },
  { titleKey: "story.proofByokTitle", bodyKey: "story.proofByokBody" },
  { titleKey: "story.proofPermissionsTitle", bodyKey: "story.proofPermissionsBody" },
] as const satisfies readonly { titleKey: TranslationKey; bodyKey: TranslationKey }[];
---

<section class="home-product-story px-4 py-20 sm:px-6 lg:py-28" aria-labelledby="product-story-title">
  <div class="mx-auto max-w-300">
    <div class="max-w-4xl">
      <p
        data-reveal
        class="text-xs font-medium uppercase tracking-[0.2em]"
        style="color: var(--muted-foreground)"
      >
        {t("story.eyebrow")}
      </p>
      <h2
        data-reveal
        id="product-story-title"
        style="--reveal-delay: 80ms"
        class="mt-3 max-w-4xl text-balance font-display text-4xl font-medium leading-[1.04] sm:text-5xl lg:text-6xl"
      >
        {t("story.title")}
      </h2>
      <p
        data-reveal
        style="--reveal-delay: 160ms; color: var(--muted-foreground)"
        class="mt-5 max-w-2xl text-pretty text-base leading-7 sm:text-lg sm:leading-8"
      >
        {t("story.intro")}
      </p>
    </div>

    <div class="mt-16 space-y-24 lg:mt-24 lg:space-y-36">
      {
        chapters.map((chapter, index) => (
          <article
            class:list={[
              "product-chapter grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12",
              index % 2 === 1 && "product-chapter-reverse",
            ]}
            id={`story-${chapter.id}`}
          >
            <div
              data-reveal
              class:list={[
                "product-chapter-copy lg:col-span-4",
                index % 2 === 1 ? "lg:col-start-9" : "lg:col-start-1",
              ]}
            >
              <p
                class="text-xs font-medium uppercase tracking-[0.2em]"
                style="color: var(--muted-foreground)"
              >
                {t(chapter.eyebrowKey)}
              </p>
              <h3 class="mt-3 text-balance font-display text-3xl font-medium leading-[1.08] sm:text-4xl">
                {t(chapter.titleKey)}
              </h3>
              <p
                class="mt-5 text-pretty text-base leading-7"
                style="color: var(--muted-foreground)"
              >
                {t(chapter.bodyKey)}
              </p>
              <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-1" aria-label={t(chapter.eyebrowKey)}>
                {chapter.links.map((link) => (
                  <a class="story-link group inline-flex min-h-11 items-center gap-2 text-sm font-medium" href={link.href}>
                    <span>{t(link.labelKey)}</span>
                    <span
                      aria-hidden="true"
                      class="transition-transform rtl:-scale-x-100 ltr:group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5"
                    >
                      →
                    </span>
                  </a>
                ))}
              </nav>
            </div>

            <div
              data-reveal
              style={`--reveal-delay: ${120 + index * 30}ms${
                chapterFrameVariants[chapter.id] === "bloom"
                  ? `; --frame-accent: ${frameAccents.ember}`
                  : ""
              }`}
              class:list={[
                "product-chapter-visual lg:col-span-8",
                chapterFrameVariants[chapter.id] === "bloom" && "chapter-frame-bloom",
                chapterFrameVariants[chapter.id] === "ripple" && "chapter-frame-ripple",
                index % 2 === 1 ? "lg:col-start-1 lg:row-start-1" : "lg:col-start-5",
              ]}
            >
              {chapterFrameVariants[chapter.id] === "ripple" && (
                <div class="pointer-events-none absolute inset-0" aria-hidden="true">
                  <div class="chapter-ripple-layer chapter-ripple-light" />
                  <div class="chapter-ripple-layer chapter-ripple-dark" />
                </div>
              )}
              {chapter.id === "workspace" && (
                <div class="story-media story-media-workspace">
                  <CliMcpPreview
                    client:visible
                    includeStyles={false}
                    sceneId="workspace"
                    showCompanions={false}
                  />
                </div>
              )}
              {chapter.id === "agent" && (
                <div class="story-media story-media-agent">
                  <CliMcpPreview
                    client:visible
                    includeStyles={false}
                    initialScenarioId="template"
                    revealSideWindowsOnScroll
                  />
                </div>
              )}
              {chapter.id === "data" && (
                <div class="story-media story-media-data">
                  <div class="story-main-screen">
                    <ThemeImage
                      lightSrc="/media/products/story-public-data.png"
                      darkSrc="/media/products/story-public-data-dark.png"
                      alt={t("story.dataMainAlt")}
                      class="h-full w-full object-cover object-top"
                      loading="lazy"
                      decoding="async"
                      defer="visible"
                    />
                  </div>
                  <div class="story-inset-screen story-anonymization-screen">
                    <ThemeImage
                      lightSrc="/media/products/anonymization.png"
                      darkSrc="/media/products/anonymization-dark.png"
                      alt={t("story.dataInsetAlt")}
                      class="h-full w-full object-cover object-top"
                      loading="lazy"
                      decoding="async"
                      defer="visible"
                    />
                  </div>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="px-4 pb-20 sm:px-6 lg:pb-28" aria-labelledby="control-title">
  <div class="control-rail mx-auto max-w-300 overflow-hidden rounded-[1.65rem]">
    <div class="grid gap-8 p-7 sm:p-9 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,2.65fr)] lg:items-center lg:p-12">
      <div data-reveal>
        <p
          class="text-xs font-medium uppercase tracking-[0.2em]"
          style="color: var(--muted-foreground)"
        >
          {t("story.controlEyebrow")}
        </p>
        <h2 id="control-title" class="mt-3 text-balance font-display text-3xl font-medium leading-[1.08] sm:text-4xl">
          {t("story.controlTitle")}
        </h2>
        <p
          class="mt-4 text-pretty text-base leading-7"
          style="color: var(--muted-foreground)"
        >
          {t("story.controlBody")}
        </p>
      </div>
      <ul class="proof-list grid sm:grid-cols-2" data-reveal style="--reveal-delay: 100ms">
        {
          proofItems.map((item) => (
            <li>
              <strong>{t(item.titleKey)}</strong>
              <span>{t(item.bodyKey)}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="deployment-band flex flex-col gap-6 px-7 py-6 sm:px-9 lg:flex-row lg:items-center lg:justify-between lg:px-12">
      <div>
        <h3 class="font-display text-xl font-medium">{t("story.deployTitle")}</h3>
        <p class="mt-1 text-sm leading-6" style="color: var(--muted-foreground)">
          {t("story.deploySubtitle")}
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-3">
        <a
          href="https://github.com/stella/stella/blob/main/docs/self-hosting.md"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-[0.75rem] px-4 text-sm font-medium transition-opacity hover:opacity-75"
        >
          {t("story.selfHostGuide")}
        </a>
        <a
          href="https://github.com/stella/stella"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-[0.75rem] px-4 text-sm font-medium transition-opacity hover:opacity-75"
        >
          {t("story.sourceOnGitHub")}
        </a>
        <a
          href="https://my.stll.app"
          class="inline-flex min-h-11 items-center rounded-[0.75rem] px-5 text-sm font-medium transition-opacity hover:opacity-90"
          style="background: var(--primary); color: var(--primary-foreground)"
        >
          {t("common.startFree")}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-product-story {
    position: relative;
  }

  .product-chapter-visual,
  .control-rail {
    background: color-mix(in srgb, var(--card) 82%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 28%, transparent),
      0 36px 90px -58px color-mix(in srgb, var(--foreground) 38%, transparent);
  }

  .product-chapter-visual {
    position: relative;
    overflow: hidden;
    border-radius: 1.65rem;
    padding: 0.55rem;
  }

  .story-media {
    position: relative;
    z-index: 1;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 1.1rem;
    background: var(--background);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--foreground) 7%, transparent);
  }

  .story-main-screen {
    position: absolute;
    inset: 0;
  }

  .story-inset-screen {
    position: absolute;
    overflow: hidden;
    border-radius: 0.8rem;
    background: var(--background);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--foreground) 10%, transparent),
      0 24px 64px -34px color-mix(in srgb, var(--foreground) 52%, transparent);
  }

  .story-editor-screen {
    inline-size: 44%;
    block-size: 64%;
    inset-block-end: 5%;
    inset-inline-end: 3.5%;
  }

  .story-anonymization-screen {
    inline-size: 48%;
    block-size: 58%;
    inset-block-end: 5%;
    inset-inline-start: 3.5%;
  }

  .story-media-agent {
    aspect-ratio: 2.03;
  }

  .product-chapter-visual::before,
  .control-rail::before {
    position: absolute;
    content: "";
    pointer-events: none;
    inset: 0;
    background: linear-gradient(
      118deg,
      color-mix(in srgb, white 20%, transparent),
      transparent 28%,
      transparent 72%,
      color-mix(in srgb, var(--auth-gradient-end) 10%, transparent)
    );
  }

  /* "bloom" chapter recipe: a radial accent glow in the frame's end corner,
     via logical insets so it mirrors under RTL. ::after paints above the
     sheen (tree order) but below .story-media (z-index: 1). The same glow
     repeats inside the media surface, behind the floating scene windows, so
     the accent reads through the scene, always at a low mix percentage. */
  .chapter-frame-bloom::after {
    content: "";
    position: absolute;
    pointer-events: none;
    inset-block-start: -20%;
    inset-inline-end: -12%;
    inline-size: 58%;
    block-size: 76%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--frame-accent, var(--auth-gradient-end)) 12%, transparent),
      transparent
    );
  }

  .chapter-frame-bloom .story-media::before {
    content: "";
    position: absolute;
    pointer-events: none;
    inset-block-start: -18%;
    inset-inline-end: -10%;
    inline-size: 58%;
    block-size: 80%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--frame-accent, var(--auth-gradient-end)) 8%, transparent),
      transparent
    );
  }

  /* "ripple" chapter recipe: a faint excerpt of the hero gradient artwork in
     the frame ring, theme-switched with the same light/dark opacity toggle
     the hero and footer art use. Static image, no animation. */
  .chapter-ripple-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    transition: opacity 500ms ease;
  }

  .chapter-ripple-light {
    background-image: url("/images/gradients/hero-light.svg");
    opacity: 0.4;
  }

  .chapter-ripple-dark {
    background-image: url("/images/gradients/hero-dark.svg");
    opacity: 0;
  }

  :global(.dark) .chapter-ripple-light {
    opacity: 0;
  }

  :global(.dark) .chapter-ripple-dark {
    opacity: 0.35;
  }

  .story-link {
    color: var(--foreground);
    text-decoration: none;
  }

  .story-link:hover,
  .story-link:focus-visible {
    opacity: 0.68;
  }

  .control-rail {
    position: relative;
  }

  .proof-list {
    grid-auto-rows: 1fr;
  }

  .proof-list li {
    display: flex;
    min-height: 6.5rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    border-block-start: 1px solid var(--border);
    padding-block: 1.25rem;
  }

  .proof-list li:first-child {
    border-block-start: 0;
  }

  .proof-list li:nth-child(odd) {
    padding-inline-end: 1.5rem;
  }

  .proof-list li:nth-child(even) {
    padding-inline-start: 1.5rem;
  }

  .proof-list strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .proof-list span {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .deployment-band {
    position: relative;
    border-block-start: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 56%, transparent);
  }

  @media (min-width: 640px) {
    .proof-list li:nth-child(even) {
      border-inline-start: 1px solid var(--border);
    }

    /* In the two-column grid the second cell sits in the first row, so its
       top border would draw the same stray line above the list. */
    .proof-list li:nth-child(2) {
      border-block-start: 0;
    }
  }

  @media (max-width: 639px) {
    .story-media {
      aspect-ratio: 4 / 3;
    }

    .story-media-agent {
      aspect-ratio: 4 / 5;
    }

    .story-editor-screen {
      display: none;
    }

    .story-anonymization-screen {
      inline-size: 72%;
      block-size: 50%;
    }

    .story-media-workspace .story-main-screen img {
      width: 170%;
      max-width: none;
      object-position: start top;
    }

    .story-media-data .story-main-screen img {
      width: 165%;
      max-width: none;
      object-position: center top;
    }

    .proof-list li:nth-child(odd),
    .proof-list li:nth-child(even) {
      padding-inline: 0;
    }
  }
</style>
