---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import LandingFooter from "../../components/LandingFooter.astro";

const posts = (
  await getCollection("blog", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const dateFormatter = new Intl.DateTimeFormat("en", { dateStyle: "medium" });
---

<Base
  title="stella | blog"
  description="Product updates, engineering notes, and thoughts on legal software from the team building stella, the open-source legal workspace for law firms."
  current="blog"
>
  <div class="flex min-h-dvh flex-col">
    <main class="flex-1">
      <section class="relative flex min-h-[52dvh] flex-col overflow-hidden px-6">
        <div class="absolute inset-0 overflow-hidden" id="gradient-bg">
          <div
            id="gradient-light"
            class="absolute inset-0 transition-opacity duration-500 dark:opacity-0"
          >
          </div>
          <div
            id="gradient-dark"
            class="absolute inset-0 opacity-0 transition-opacity duration-500 dark:opacity-100"
          >
          </div>
        </div>
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2"
          style="background: linear-gradient(to bottom, transparent, var(--background))"
        >
        </div>

        <div
          class="relative z-10 mx-auto flex w-full max-w-300 flex-1 items-center justify-center py-20"
        >
          <h1>
            <a
              href="/blog"
              class="font-display text-5xl font-medium leading-[1.05] transition-opacity hover:opacity-80 sm:text-6xl lg:text-7xl"
            >
              Blog
            </a>
          </h1>
        </div>
      </section>

      <section class="px-6 pb-20 lg:pb-24">
        <div class="mx-auto max-w-5xl">
          {
            posts.length === 0 ? (
              <article
                class="rounded-lg p-6"
                style="background: var(--card); border: 1px solid var(--border)"
              >
                <p
                  class="text-sm leading-[1.8]"
                  style="color: var(--muted-foreground)"
                >
                  No posts yet. Check back soon.
                </p>
              </article>
            ) : (
              <ul class="space-y-5">
                {posts.map((post) => (
                  <li>
                    <a
                      href={`/blog/${post.id}`}
                      class="block rounded-lg p-6 transition-opacity hover:opacity-90 sm:p-7"
                      style="background: var(--card); border: 1px solid var(--border)"
                    >
                      <div
                        class="flex flex-wrap items-center gap-3 text-sm font-medium"
                        style="color: var(--muted-foreground)"
                      >
                        <time datetime={post.data.publishedAt.toISOString()}>
                          {dateFormatter.format(post.data.publishedAt)}
                        </time>
                        {post.data.draft ? (
                          <span
                            class="rounded-full px-2 py-0.5 text-xs"
                            style="background: var(--muted); color: var(--foreground)"
                          >
                            Draft
                          </span>
                        ) : null}
                      </div>
                      <h2
                        class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl"
                        style="color: var(--foreground)"
                      >
                        {post.data.title}
                      </h2>
                      <p
                        class="mt-3 text-base leading-[1.7]"
                        style="color: var(--muted-foreground)"
                      >
                        {post.data.description}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </section>
    </main>

    <LandingFooter />
  </div>

</Base>
