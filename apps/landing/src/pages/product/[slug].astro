---
import Base from "../../layouts/Base.astro";
import ProductMediaFrame from "../../components/ProductMediaFrame.astro";
import McpProofSection from "../../components/McpProofSection.astro";
import ConnectedSources from "../../components/ConnectedSources.astro";
import LandingFooter from "../../components/LandingFooter.astro";
import { products } from "../../data/products/registry";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

// FAQPage structured data: the quick answer plus every FAQ, sourced from the
// same content rendered below so assistants and people see the same answers.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [product.quickAnswer, ...product.faqs].map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Base
  title={product.metaTitle ?? `stella | ${product.eyebrow}`}
  description={product.metaDescription ?? product.summary}
  socialImage={`/images/og/${product.slug}.png`}
  current="product"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />

  <div class="flex min-h-dvh flex-col">
    <main class="flex-1">
      {/* ——— Hero ——— */}
      <section
        class="px-6 pt-12 pb-10 lg:pt-16"
        id={product.slug === "cli-mcp" ? "cli-and-mcp" : undefined}
      >
        <div class="mx-auto max-w-300">
          <div class="mx-auto max-w-3xl text-center">
            <p
              data-reveal
              class="text-xs font-medium uppercase tracking-[0.2em]"
              style="color: var(--primary)"
            >
              {product.eyebrow}
            </p>
            <h1
              data-reveal
              style="--reveal-delay: 80ms"
              class="mt-3 font-display text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl"
            >
              {product.title}
            </h1>
            <p
              data-reveal
              style="--reveal-delay: 160ms; color: var(--muted-foreground)"
              class="mx-auto mt-5 max-w-2xl text-lg leading-[1.7]"
            >
              {product.summary}
            </p>
          </div>
          <div
            data-reveal
            style="--reveal-delay: 240ms"
            class="mx-auto mt-10 max-w-4xl"
          >
            <ProductMediaFrame
              media={product.hero}
              variant={product.heroFrameVariant}
              accent={product.frameAccent}
            />
          </div>
        </div>
      </section>

      {/* ——— Quick answer ——— */}
      <section class="px-6 py-10">
        <div class="mx-auto max-w-3xl">
          <div data-reveal class="quick-answer relative overflow-hidden rounded-2xl border p-6 backdrop-blur-md lg:p-8">
            <p
              class="text-xs font-medium uppercase tracking-[0.18em]"
              style="color: var(--primary)"
            >
              In short
            </p>
            <h2 class="mt-2 font-display text-xl font-medium tracking-tight">
              {product.quickAnswer.question}
            </h2>
            <p
              class="mt-3 text-base leading-[1.8]"
              style="color: var(--muted-foreground)"
            >
              {product.quickAnswer.answer}
            </p>
          </div>
        </div>
      </section>

      {
        product.slug === "public-data" && (
          <section class="px-6 py-10 lg:py-12">
            <div class="mx-auto max-w-3xl">
              <h2
                class="mb-2 text-xs font-medium uppercase tracking-[0.2em]"
                style="color: var(--muted-foreground)"
              >
                Connected sources by jurisdiction
              </h2>
              <p
                class="mb-6 text-sm leading-[1.7]"
                style="color: var(--muted-foreground)"
              >
                Official sources surface automatically for the jurisdictions you
                work in, derived from the connector catalogue. Coverage grows as
                adapters are added.
              </p>
              <div class="space-y-6">
                <ConnectedSources locale="cs" country="Czechia" />
                <ConnectedSources locale="es" country="Spain" />
                <ConnectedSources locale="zh-TW" country="Taiwan" />
              </div>
            </div>
          </section>
        )
      }

      {/* ——— Capabilities ——— */}
      <section class="px-6 py-10 lg:py-12">
        <div class="mx-auto max-w-300">
          <p
            data-reveal
            class="mb-8 text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--muted-foreground)"
          >
            Capabilities
          </p>
          {/*
            Editorial rhythm instead of an equal card grid: the first capability
            is a wide lead card with larger type; the rest pair up two per row
            on lg, alternating which side holds the wide card. Spans are derived
            from the index so any capability count fills the grid without holes:
            even counts tile exactly (2+1 / 1+2 / ...), an odd count promotes
            its lone last card to a full-width row.
          */}
          <div class="grid border-t sm:grid-cols-2 lg:grid-cols-3" style="border-color: var(--border)">
            {
              product.capabilities.map((cap, index) => {
                const count = product.capabilities.length;
                const isLead = index === 0;
                const isLast = index === count - 1;
                const isLoneLast = isLast && count % 2 === 1;
                // Paired rows on lg: even rows open with the wide card, odd
                // rows close with it.
                const wideSlot = index % 2 === Math.floor(index / 2) % 2;
                const spanClasses = [];
                if (isLead || (isLast && count % 2 === 0)) {
                  // Full-width bookends on the 2-column sm grid keep the
                  // in-between cards paired with no orphan cell.
                  spanClasses.push("sm:col-span-2");
                }
                if (isLoneLast) {
                  spanClasses.push("lg:col-span-3");
                } else {
                  // Explicit lg span so an sm:col-span-2 bookend narrows back
                  // down when the lg rhythm puts it in a narrow slot.
                  spanClasses.push(wideSlot ? "lg:col-span-2" : "lg:col-span-1");
                }
                return (
                  <div
                    data-reveal
                    class:list={[
                      "capability-card border-b p-6 lg:border-e",
                      spanClasses,
                      isLead && "capability-card-lead lg:p-8",
                    ]}
                    style={`--reveal-delay: ${index * 60}ms; border-color: var(--border)`}
                  >
                    <span
                      class="font-mono text-xs font-medium tabular-nums"
                      style="color: color-mix(in srgb, var(--primary) 75%, transparent)"
                    >
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3
                      class:list={[
                        "font-display font-medium tracking-tight",
                        isLead
                          ? "mt-4 max-w-xl text-2xl sm:text-3xl"
                          : "mt-3 text-lg",
                      ]}
                    >
                      {cap.title}
                    </h3>
                    <p
                      class:list={[
                        "leading-[1.8]",
                        isLead
                          ? "mt-3 max-w-xl text-base"
                          : "mt-2 max-w-lg text-sm",
                      ]}
                      style="color: var(--muted-foreground)"
                    >
                      {cap.body}
                    </p>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      {/* ——— Deep-dive sections ——— */}
      {
        product.sections.map((section, index) => (
          <section class="px-6 py-8 lg:py-10">
            <div
              class:list={[
                "mx-auto grid gap-8 border-t pt-8",
                !section.media
                  ? "max-w-3xl md:gap-10"
                  : product.slug === "cli-mcp"
                    ? "max-w-5xl md:gap-10"
                    : "max-w-5xl md:grid-cols-[minmax(0,.72fr)_minmax(0,1.28fr)] md:items-center md:gap-12",
              ]}
              style="border-color: var(--border)"
            >
              <div
                data-reveal
              >
                <span class="font-mono text-xs" style="color: var(--muted-foreground)">{String(index + 1).padStart(2, "0")}</span>
                <h2 class="font-display text-2xl font-medium tracking-tight sm:text-3xl">
                  {section.heading}
                </h2>
                <ul class="mt-5 space-y-3">
                  {section.bullets.map((bullet) => (
                    <li
                      class="flex items-start gap-2.5 text-sm leading-[1.7]"
                      style="color: var(--muted-foreground)"
                    >
                      <span
                        class="mt-[7px] block h-2 w-2 shrink-0 rounded-full"
                        style="background: var(--primary)"
                        aria-hidden="true"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {section.media && (
                <div data-reveal style={`--reveal-delay: ${80 + index * 30}ms`}>
                  <ProductMediaFrame
                    media={section.media}
                    compact
                    variant={section.frameVariant}
                    accent={product.frameAccent}
                  />
                </div>
              )}
            </div>
          </section>
        ))
      }

      {product.slug === "cli-mcp" && <McpProofSection />}

      {/* ——— FAQ ——— */}
      <section class="px-6 py-10 lg:py-12">
        <div class="mx-auto max-w-3xl">
          <h2
            class="mb-6 text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--muted-foreground)"
          >
            FAQ
          </h2>
          <div class="divide-y" style="border-color: var(--border)">
            {
              product.faqs.map((faq) => (
                <details class="product-faq group">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 py-4 font-display text-base font-medium">
                    {faq.question}
                    <span
                      class="product-faq-mark shrink-0 text-lg leading-none transition-transform"
                      style="color: var(--muted-foreground)"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <p
                    class="pb-5 text-sm leading-[1.8]"
                    style="color: var(--muted-foreground)"
                  >
                    {faq.answer}
                  </p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      {/* ——— Adjacent products ——— */}
      <section class="px-6 py-10 lg:py-12">
        <div class="mx-auto max-w-300">
          <h2
            class="mb-6 text-xs font-medium uppercase tracking-[0.2em]"
            style="color: var(--muted-foreground)"
          >
            Explore more
          </h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              product.adjacent.map((link) => (
                <a
                  href={link.href}
                  class="adjacent-card flex flex-col rounded-2xl p-6 no-underline transition-[border-color,transform] duration-200"
                  style="background: var(--card); border: 1px solid var(--border); color: inherit"
                >
                  <span class="font-display text-base font-medium" style="color: var(--foreground)">
                    {link.title}
                  </span>
                  <span
                    class="mt-1.5 text-sm leading-[1.6]"
                    style="color: var(--muted-foreground)"
                  >
                    {link.body}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      {/* ——— CTA ——— */}
      <section class="px-6 py-28 lg:py-40">
        <div class="mx-auto max-w-3xl text-center">
          <h2
            data-reveal
            class="text-balance font-display text-4xl font-medium tracking-tight sm:text-5xl"
          >
            {product.cta.heading}
          </h2>
          <div class="mt-10">
            <a
              href={product.cta.href}
              data-reveal
              style="--reveal-delay: 120ms; background: var(--primary); color: var(--primary-foreground)"
              class="inline-flex h-11 items-center rounded-[0.85rem] px-6 text-sm font-medium transition-opacity hover:opacity-90"
            >
              {product.cta.label}
            </a>
          </div>
        </div>
      </section>
    </main>

    <LandingFooter />
  </div>

  <style>
    .quick-answer {
      background: color-mix(in srgb, var(--card) 80%, transparent);
      border-color: color-mix(in srgb, var(--border) 90%, transparent);
      box-shadow: inset 0 1px 0 color-mix(in srgb, white 8%, transparent);
    }

    .capability-card {
      background: color-mix(in srgb, var(--card) 78%, transparent);
      border-color: color-mix(in srgb, var(--border) 90%, transparent);
      box-shadow: inset 0 1px 0 color-mix(in srgb, white 8%, transparent);
      transition:
        border-color 200ms,
        transform 200ms,
        box-shadow 200ms;
    }
    .capability-card:hover {
      border-color: color-mix(in srgb, var(--primary) 42%, var(--border));
      transform: translateY(-2px);
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, white 10%, transparent),
        0 18px 40px -30px rgba(0, 0, 0, 0.3);
    }
    .capability-card-lead {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--primary) 7%, var(--card)),
        color-mix(in srgb, var(--card) 78%, transparent)
      );
    }

    .product-faq[open] .product-faq-mark {
      transform: rotate(45deg);
    }
    .product-faq summary::-webkit-details-marker {
      display: none;
    }
    .adjacent-card:hover {
      border-color: var(--primary) !important;
      transform: translateY(-2px);
    }
  </style>
</Base>
