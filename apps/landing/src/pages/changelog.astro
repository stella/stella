---
import Base from "../layouts/Base.astro";
import ChangelogMarkdown from "../components/ChangelogMarkdown.astro";
import LandingFooter from "../components/LandingFooter.astro";
import {
  getChangelogReleaseEntries,
  type ChangelogRelease,
} from "../lib/changelog";
import { removeFirstMarkdownHeading } from "../lib/changelog-markdown";
import {
  CHANGELOG_ENTRIES_PER_PAGE,
  formatMaintenanceReleaseRange,
  getMaintenanceReleaseTitle,
  isFeatureRelease,
} from "../lib/changelog-release";

const githubUrl = "https://github.com/stella/stella";
const releasesUrl = `${githubUrl}/releases`;
const releaseEntries = getChangelogReleaseEntries();

const staticReleaseEntries = releaseEntries.slice(
  0,
  CHANGELOG_ENTRIES_PER_PAGE,
);
const totalPages = Math.max(
  1,
  Math.ceil(releaseEntries.length / CHANGELOG_ENTRIES_PER_PAGE),
);
const serializedEntries = JSON.stringify(releaseEntries).replace(
  /</gu,
  "\u003c",
);

const releaseUrl = (release: ChangelogRelease) =>
  `${releasesUrl}/tag/${release.tagName}`;
const formatReleaseDate = (publishedAt: string) =>
  new Intl.DateTimeFormat("en", { dateStyle: "medium" }).format(
    new Date(publishedAt),
  );
---

<Base
  title="stella | changelog"
  description="Release notes for stella: what changed in each version of the open-source legal workspace — new features, improvements, and fixes, release by release."
  current="changelog"
>
  <div class="flex min-h-dvh flex-col">
    <main class="flex-1">
      <section class="relative flex min-h-[52dvh] flex-col overflow-hidden px-6">
        <div class="absolute inset-0 overflow-hidden" id="gradient-bg">
          <div
            id="gradient-light"
            class="absolute inset-0 dark:opacity-0 transition-opacity duration-500"
          >
          </div>
          <div
            id="gradient-dark"
            class="absolute inset-0 opacity-0 dark:opacity-100 transition-opacity duration-500"
          >
          </div>
        </div>
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2"
          style="background: linear-gradient(to bottom, transparent, var(--background))"
        >
        </div>

        <div
          class="relative z-10 mx-auto flex w-full max-w-300 flex-1 items-center justify-center py-20"
        >
          <h1>
            <a
              href="/changelog/"
              class="font-display text-5xl font-medium leading-[1.05] transition-opacity hover:opacity-80 sm:text-6xl lg:text-7xl"
            >
              Changelog
            </a>
          </h1>
        </div>
      </section>

      <section class="px-6 pb-20 lg:pb-24">
        <div class="mx-auto max-w-5xl">
          <div id="changelog-releases" class="space-y-5" aria-live="polite">
            {
              staticReleaseEntries.map((entry) => {
                if (entry.type === "maintenance") {
                  const newestRelease = entry.releases[0];
                  return (
                    <details class="changelog-entry changelog-patch-release rounded-lg">
                      <summary class="changelog-patch-summary flex min-h-14 cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3 sm:flex-nowrap sm:px-6">
                        <span
                          class="shrink-0 tabular-nums text-sm font-medium"
                          style="color: var(--muted-foreground)"
                        >
                          {formatMaintenanceReleaseRange(
                            entry.releases,
                            (release) => release.tagName,
                          )}
                        </span>
                        <h2
                          class="min-w-0 flex-1 truncate font-display text-base font-medium sm:text-lg"
                          style="color: var(--foreground)"
                        >
                          {getMaintenanceReleaseTitle(entry.releases.length)}
                        </h2>
                        {newestRelease.publishedAt && (
                          <time
                            datetime={newestRelease.publishedAt}
                            class="shrink-0 text-sm tabular-nums"
                            style="color: var(--muted-foreground)"
                          >
                            {formatReleaseDate(newestRelease.publishedAt)}
                          </time>
                        )}
                        <span
                          class="changelog-patch-marker inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-lg leading-none"
                          aria-hidden="true"
                          style="background: var(--muted); color: var(--foreground)"
                        >
                          +
                        </span>
                      </summary>
                      <div
                        class="changelog-maintenance-list px-5 pb-2 sm:px-6"
                        style="border-top: 1px solid var(--border)"
                      >
                        {entry.releases.map((release) => {
                          const notesBody = removeFirstMarkdownHeading(
                            release.body,
                          );
                          return (
                            <details
                              id={release.slug}
                              class="changelog-maintenance-item py-3"
                            >
                              <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium">
                                <span class="tabular-nums">
                                  {release.tagName}
                                </span>
                                {release.publishedAt && (
                                  <time
                                    datetime={release.publishedAt}
                                    class="shrink-0 tabular-nums"
                                    style="color: var(--muted-foreground)"
                                  >
                                    {formatReleaseDate(release.publishedAt)}
                                  </time>
                                )}
                              </summary>
                              <div class="changelog-body pb-2 pt-3">
                                <ChangelogMarkdown
                                  body={notesBody || release.description}
                                />
                                <div class="mt-4 flex flex-wrap items-center gap-3">
                                  <a
                                    href={releaseUrl(release)}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex h-9 shrink-0 items-center justify-center rounded-[0.625rem] px-3 text-sm font-medium transition-opacity hover:opacity-80 whitespace-nowrap"
                                    style="background: var(--background); border: 1px solid var(--border); color: var(--foreground)"
                                  >
                                    View release on GitHub
                                  </a>
                                </div>
                              </div>
                            </details>
                          );
                        })}
                      </div>
                    </details>
                  );
                }

                const { release } = entry;
                if (!isFeatureRelease(release.heading)) {
                  const notesBody = removeFirstMarkdownHeading(release.body);
                  return (
                    <details
                      id={release.slug}
                      class="changelog-entry changelog-patch-release rounded-lg"
                      open
                    >
                      <summary class="changelog-patch-summary flex min-h-14 cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3 sm:flex-nowrap sm:px-6">
                        <span
                          class="shrink-0 tabular-nums text-sm font-medium"
                          style="color: var(--muted-foreground)"
                        >
                          {release.tagName}
                        </span>
                        <h2
                          class="min-w-0 flex-1 truncate font-display text-base font-medium sm:text-lg"
                          style="color: var(--foreground)"
                        >
                          {release.heading ?? release.displayName}
                        </h2>
                        {release.publishedAt && (
                          <time
                            datetime={release.publishedAt}
                            class="shrink-0 text-sm tabular-nums"
                            style="color: var(--muted-foreground)"
                          >
                            {formatReleaseDate(release.publishedAt)}
                          </time>
                        )}
                        <span
                          class="changelog-patch-marker inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-lg leading-none"
                          aria-hidden="true"
                          style="background: var(--muted); color: var(--foreground)"
                        >
                          +
                        </span>
                      </summary>
                      <div
                        class="changelog-body px-5 pb-5 pt-3 sm:px-6"
                        style="border-top: 1px solid var(--border)"
                      >
                        <ChangelogMarkdown
                          body={notesBody || release.description}
                        />
                        <div class="mt-5 flex flex-wrap items-center gap-3">
                          <a
                            href={releaseUrl(release)}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex h-9 shrink-0 items-center justify-center rounded-[0.625rem] px-3 text-sm font-medium transition-opacity hover:opacity-80 whitespace-nowrap"
                            style="background: var(--background); border: 1px solid var(--border); color: var(--foreground)"
                          >
                            View release on GitHub
                          </a>
                        </div>
                      </div>
                    </details>
                  );
                }

                return (
                  <article
                    id={release.slug}
                    class="changelog-entry changelog-feature-release rounded-lg p-6 sm:p-8"
                  >
                    <div
                      class="flex flex-wrap items-center gap-3 text-sm font-medium"
                      style="color: var(--muted-foreground)"
                    >
                      <h2>
                        <a
                          href={`/changelog/${release.slug}/`}
                          data-release-anchor={release.slug}
                          class="font-display text-3xl font-medium transition-opacity hover:opacity-70 sm:text-4xl"
                          style="color: var(--foreground)"
                        >
                          {release.tagName}
                        </a>
                      </h2>
                      {release.publishedAt && (
                        <time datetime={release.publishedAt}>
                          {formatReleaseDate(release.publishedAt)}
                        </time>
                      )}
                      <a
                        href={releaseUrl(release)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex h-9 shrink-0 items-center justify-center rounded-[0.625rem] px-3 text-sm font-medium transition-opacity hover:opacity-80 whitespace-nowrap"
                        style="background: var(--background); border: 1px solid var(--border); color: var(--foreground)"
                      >
                        View release on GitHub
                      </a>
                    </div>
                    <div class="changelog-body mt-7 space-y-3">
                      <ChangelogMarkdown body={release.body} />
                    </div>
                  </article>
                );
              })
            }
          </div>
          <nav
            id="changelog-pagination"
            class:list={[
              "mt-6 items-center justify-between gap-3",
              totalPages > 1 ? "flex" : "hidden",
            ]}
            aria-label="Changelog pagination"
          >
          </nav>

          <noscript>
            <div
              class="mt-6 rounded-lg p-6"
              style="background: var(--card); border: 1px solid var(--border)"
            >
              <p
                class="text-sm leading-[1.8]"
                style="color: var(--muted-foreground)"
              >
                Showing the latest releases. The full history and complete
                release notes are on
                <a
                  href={releasesUrl}
                  class="font-medium transition-opacity hover:opacity-70"
                  style="color: var(--foreground)"
                  >GitHub</a
                >.
              </p>
            </div>
          </noscript>
        </div>
      </section>
    </main>

    <LandingFooter />
  </div>

  <script
    is:inline
    id="changelog-entries"
    type="application/json"
    set:html={serializedEntries}
  />

  <style>
    :global(.changelog-entry) {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--foreground);
      scroll-margin-top: 2rem;
    }

    :global(.changelog-feature-release) {
      box-shadow: 0 24px 72px color-mix(in srgb, var(--foreground) 7%, transparent);
      overflow: hidden;
      position: relative;
    }

    :global(.changelog-feature-release::before) {
      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in srgb, var(--auth-gradient-end) 76%, var(--foreground)),
        transparent
      );
      content: "";
      height: 1px;
      inset-block-start: 0;
      inset-inline: 1.5rem;
      opacity: 0.9;
      position: absolute;
    }

    :global(.changelog-feature-release .changelog-body > h2:first-child) {
      font-size: clamp(2rem, 5vw, 3.25rem);
      line-height: 1.02;
      text-wrap: balance;
    }

    :global(.changelog-feature-release .changelog-body > h3:first-of-type) {
      color: color-mix(in srgb, var(--foreground) 82%, var(--muted-foreground));
      font-size: 1.25rem;
      line-height: 1.5;
      text-wrap: balance;
    }

    :global(.changelog-patch-release) {
      transition: transform 160ms ease;
    }

    :global(.changelog-patch-release:hover),
    :global(.changelog-patch-release[open]) {
      border-color: color-mix(in srgb, var(--foreground) 18%, var(--border));
      box-shadow: 0 14px 44px color-mix(in srgb, var(--foreground) 5%, transparent);
    }

    :global(.changelog-patch-release[open]) {
      transform: translateY(-1px);
    }

    :global(.changelog-patch-summary) {
      list-style: none;
    }

    :global(.changelog-patch-summary::-webkit-details-marker) {
      display: none;
    }

    :global(.changelog-patch-marker) {
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }

    :global(.changelog-patch-release[open] .changelog-patch-marker) {
      transform: rotate(45deg);
    }

    :global(.changelog-maintenance-item) {
      scroll-margin-top: 2rem;
    }

    :global(.changelog-maintenance-item + .changelog-maintenance-item) {
      border-top: 1px solid var(--border);
    }

    :global(.changelog-maintenance-item > summary) {
      color: var(--foreground);
    }

    :global(.changelog-maintenance-item > summary::marker) {
      color: var(--muted-foreground);
    }

    :global(.changelog-body h2),
    :global(.changelog-body h3) {
      color: var(--foreground);
      font-family: "Cabinet Grotesk", system-ui, sans-serif;
      font-weight: 500;
      margin-top: 1.5rem;
    }

    :global(.changelog-body h2:first-child),
    :global(.changelog-body h3:first-child) {
      margin-top: 0;
    }

    :global(.changelog-body h2) {
      font-size: 1.75rem;
      line-height: 1.15;
    }

    :global(.changelog-body h3) {
      font-size: 1.125rem;
      line-height: 1.45;
      color: var(--muted-foreground);
    }

    :global(.changelog-body p),
    :global(.changelog-body li) {
      color: var(--muted-foreground);
      font-size: 0.9375rem;
      line-height: 1.8;
    }

    :global(.changelog-body code) {
      background: var(--muted);
      border-radius: 0.25rem;
      color: var(--foreground);
      font-size: 0.85em;
      padding: 0.125rem 0.35rem;
    }

    :global(.changelog-body ul) {
      list-style: disc;
      margin-top: 0.75rem;
      padding-left: 1.1rem;
    }

    :global(.changelog-body li + li) {
      margin-top: 0.35rem;
    }

    :global(.changelog-body a) {
      color: var(--foreground);
      font-weight: 500;
      text-decoration: none;
    }

    :global(.changelog-body a:hover) {
      opacity: 0.7;
    }

    :global(.changelog-body video) {
      aspect-ratio: 16 / 9;
      background: var(--muted);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      display: block;
      margin-top: 1rem;
      height: auto;
      object-fit: contain;
      width: 100%;
    }

    :global(.changelog-body img) {
      background: var(--muted);
      border-radius: 0.5rem;
      display: block;
      height: auto;
      margin-top: 1rem;
      max-height: 42rem;
      object-fit: contain;
      outline: 1px solid color-mix(in srgb, var(--foreground) 6%, transparent);
      width: 100%;
    }

    @media (max-width: 640px) {
      :global(.changelog-body video),
      :global(.changelog-body img) {
        border-radius: 0.375rem;
        margin-inline: -0.5rem;
        max-width: calc(100% + 1rem);
        width: calc(100% + 1rem);
      }
    }
  </style>

  <script>
    import { panic } from "better-result";
    import type { ChangelogRelease } from "../lib/changelog";
    import {
      parseChangelogInline,
      parseChangelogMarkdown,
      removeFirstMarkdownHeading,
      safeHttpsUrl,
    } from "../lib/changelog-markdown";
    import {
      CHANGELOG_ENTRIES_PER_PAGE,
      type ChangelogReleaseEntry,
      formatMaintenanceReleaseRange,
      getMaintenanceReleaseTitle,
      isFeatureRelease,
    } from "../lib/changelog-release";

    const GITHUB_RELEASES_URL = "https://github.com/stella/stella/releases";

    const isChangelogRelease = (value: unknown): value is ChangelogRelease => {
      if (typeof value !== "object" || value === null || Array.isArray(value)) {
        return false;
      }
      const body = Reflect.get(value, "body");
      const description = Reflect.get(value, "description");
      const displayName = Reflect.get(value, "displayName");
      const heading = Reflect.get(value, "heading");
      const publishedAt = Reflect.get(value, "publishedAt");
      const slug = Reflect.get(value, "slug");
      const tagName = Reflect.get(value, "tagName");
      return (
        typeof body === "string" &&
        typeof description === "string" &&
        typeof displayName === "string" &&
        (typeof heading === "string" || heading === null) &&
        (typeof publishedAt === "string" || publishedAt === null) &&
        typeof slug === "string" &&
        typeof tagName === "string"
      );
    };

    const isChangelogEntry = (
      value: unknown,
    ): value is ChangelogReleaseEntry<ChangelogRelease> => {
      if (typeof value !== "object" || value === null || Array.isArray(value)) {
        return false;
      }
      const type = Reflect.get(value, "type");
      if (type === "release") {
        return isChangelogRelease(Reflect.get(value, "release"));
      }
      if (type === "maintenance") {
        const releases = Reflect.get(value, "releases");
        return (
          Array.isArray(releases) &&
          releases.length > 0 &&
          releases.every(isChangelogRelease)
        );
      }
      return false;
    };

    const readEntries = (
      element: HTMLElement | null,
    ): ChangelogReleaseEntry<ChangelogRelease>[] => {
      if (!element?.textContent) {
        return [];
      }
      const parsed: unknown = JSON.parse(element.textContent);
      return Array.isArray(parsed) ? parsed.filter(isChangelogEntry) : [];
    };

    const formatDate = (publishedAt: string | null) =>
      publishedAt
        ? new Intl.DateTimeFormat("en", { dateStyle: "medium" }).format(
            new Date(publishedAt),
          )
        : null;

    const appendInlineMarkdown = (target: HTMLElement, text: string) => {
      for (const segment of parseChangelogInline(text)) {
        if (segment.type === "bold") {
          const strong = document.createElement("strong");
          strong.textContent = segment.text;
          target.append(strong);
          continue;
        }
        if (segment.type === "code") {
          const code = document.createElement("code");
          code.textContent = segment.text;
          target.append(code);
          continue;
        }
        if (segment.type === "link") {
          const link = document.createElement("a");
          link.textContent = segment.text;
          link.href = segment.href;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          target.append(link);
          continue;
        }
        target.append(document.createTextNode(segment.text));
      }
    };

    const renderMarkdownFragment = (body: string) => {
      const fragment = document.createDocumentFragment();

      for (const block of parseChangelogMarkdown(body)) {
        if (block.type === "image") {
          const safeSrc = safeHttpsUrl(block.src);
          if (!safeSrc) {
            continue;
          }
          const image = document.createElement("img");
          image.alt = block.alt;
          image.decoding = "async";
          image.loading = "lazy";
          image.src = safeSrc;
          fragment.append(image);
          continue;
        }

        if (block.type === "video") {
          const safeSrc = safeHttpsUrl(block.src);
          if (!safeSrc) {
            continue;
          }
          const video = document.createElement("video");
          video.controls = true;
          video.preload = "metadata";
          video.src = safeSrc;
          fragment.append(video);
          continue;
        }

        if (block.type === "heading") {
          const heading = document.createElement(
            block.level === 1 ? "h2" : "h3",
          );
          heading.textContent = block.text;
          fragment.append(heading);
          continue;
        }

        if (block.type === "list") {
          const list = document.createElement("ul");
          for (const text of block.items) {
            const item = document.createElement("li");
            appendInlineMarkdown(item, text);
            list.append(item);
          }
          fragment.append(list);
          continue;
        }

        const paragraph = document.createElement("p");
        appendInlineMarkdown(paragraph, block.text);
        fragment.append(paragraph);
      }

      return fragment;
    };

    const createReleaseLink = (release: ChangelogRelease) => {
      const releaseLink = document.createElement("a");
      releaseLink.className =
        "inline-flex h-9 shrink-0 items-center justify-center rounded-[0.625rem] px-3 text-sm font-medium transition-opacity hover:opacity-80 whitespace-nowrap";
      releaseLink.href = `${GITHUB_RELEASES_URL}/tag/${release.tagName}`;
      releaseLink.target = "_blank";
      releaseLink.rel = "noopener noreferrer";
      releaseLink.style.background = "var(--background)";
      releaseLink.style.border = "1px solid var(--border)";
      releaseLink.style.color = "var(--foreground)";
      releaseLink.textContent = "View release on GitHub";
      return releaseLink;
    };

    const bindAnchorClick = (link: HTMLAnchorElement, slug: string) => {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }
        const target = document.querySelector(`#${CSS.escape(slug)}`);
        if (!target) {
          return;
        }
        event.preventDefault();
        window.history.pushState(null, "", `#${slug}`);
        target.scrollIntoView({ block: "start", behavior: "smooth" });
      });
    };

    const renderFeatureRelease = (release: ChangelogRelease) => {
      const article = document.createElement("article");
      article.id = release.slug;
      article.className =
        "changelog-entry changelog-feature-release rounded-lg p-6 sm:p-8";

      const meta = document.createElement("div");
      meta.className = "flex flex-wrap items-center gap-3 text-sm font-medium";
      meta.style.color = "var(--muted-foreground)";

      const title = document.createElement("h2");
      const titleLink = document.createElement("a");
      titleLink.href = `/changelog/${release.slug}/`;
      titleLink.dataset["releaseAnchor"] = release.slug;
      titleLink.className =
        "font-display text-3xl font-medium transition-opacity hover:opacity-70 sm:text-4xl";
      titleLink.style.color = "var(--foreground)";
      titleLink.textContent = release.tagName;
      bindAnchorClick(titleLink, release.slug);
      title.append(titleLink);
      meta.append(title);

      const formattedDate = formatDate(release.publishedAt);
      if (formattedDate && release.publishedAt) {
        const time = document.createElement("time");
        time.dateTime = release.publishedAt;
        time.textContent = formattedDate;
        meta.append(time);
      }

      meta.append(createReleaseLink(release));

      const body = document.createElement("div");
      body.className = "changelog-body mt-7 space-y-3";
      body.append(renderMarkdownFragment(release.body));

      article.append(meta, body);
      return article;
    };

    const renderCompactRelease = (release: ChangelogRelease) => {
      const details = document.createElement("details");
      details.id = release.slug;
      details.className = "changelog-entry changelog-patch-release rounded-lg";
      details.open = true;

      const summary = document.createElement("summary");
      summary.className =
        "changelog-patch-summary flex min-h-14 cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3 sm:flex-nowrap sm:px-6";

      const version = document.createElement("span");
      version.className = "shrink-0 tabular-nums text-sm font-medium";
      version.style.color = "var(--muted-foreground)";
      version.textContent = release.tagName;

      const title = document.createElement("h2");
      title.className =
        "min-w-0 flex-1 truncate font-display text-base font-medium sm:text-lg";
      title.style.color = "var(--foreground)";
      title.textContent = release.heading ?? release.displayName;

      summary.append(version, title);

      const formattedDate = formatDate(release.publishedAt);
      if (formattedDate && release.publishedAt) {
        const time = document.createElement("time");
        time.dateTime = release.publishedAt;
        time.className = "shrink-0 text-sm tabular-nums";
        time.style.color = "var(--muted-foreground)";
        time.textContent = formattedDate;
        summary.append(time);
      }

      const marker = document.createElement("span");
      marker.className =
        "changelog-patch-marker inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-lg leading-none";
      marker.setAttribute("aria-hidden", "true");
      marker.style.background = "var(--muted)";
      marker.style.color = "var(--foreground)";
      marker.textContent = "+";
      summary.append(marker);

      const body = document.createElement("div");
      body.className = "changelog-body px-5 pb-5 pt-3 sm:px-6";
      body.style.borderTop = "1px solid var(--border)";
      const notesBody = removeFirstMarkdownHeading(release.body);
      body.append(renderMarkdownFragment(notesBody || release.description));

      const footer = document.createElement("div");
      footer.className = "mt-5 flex flex-wrap items-center gap-3";
      footer.append(createReleaseLink(release));
      body.append(footer);

      details.append(summary, body);
      return details;
    };

    const renderMaintenanceItem = (release: ChangelogRelease) => {
      const details = document.createElement("details");
      details.id = release.slug;
      details.className = "changelog-maintenance-item py-3";

      const summary = document.createElement("summary");
      summary.className =
        "flex cursor-pointer items-center justify-between gap-4 text-sm font-medium";

      const version = document.createElement("span");
      version.className = "tabular-nums";
      version.textContent = release.tagName;
      summary.append(version);

      const formattedDate = formatDate(release.publishedAt);
      if (formattedDate && release.publishedAt) {
        const time = document.createElement("time");
        time.dateTime = release.publishedAt;
        time.className = "shrink-0 tabular-nums";
        time.style.color = "var(--muted-foreground)";
        time.textContent = formattedDate;
        summary.append(time);
      }

      const body = document.createElement("div");
      body.className = "changelog-body pb-2 pt-3";
      const notesBody = removeFirstMarkdownHeading(release.body);
      body.append(renderMarkdownFragment(notesBody || release.description));

      const footer = document.createElement("div");
      footer.className = "mt-4 flex flex-wrap items-center gap-3";
      footer.append(createReleaseLink(release));
      body.append(footer);

      details.append(summary, body);
      return details;
    };

    const renderMaintenanceReleases = (
      releases: [ChangelogRelease, ...ChangelogRelease[]],
    ) => {
      const details = document.createElement("details");
      details.className = "changelog-entry changelog-patch-release rounded-lg";

      const summary = document.createElement("summary");
      summary.className =
        "changelog-patch-summary flex min-h-14 cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3 sm:flex-nowrap sm:px-6";

      const version = document.createElement("span");
      version.className = "shrink-0 tabular-nums text-sm font-medium";
      version.style.color = "var(--muted-foreground)";
      version.textContent = formatMaintenanceReleaseRange(
        releases,
        (release) => release.tagName,
      );

      const title = document.createElement("h2");
      title.className =
        "min-w-0 flex-1 truncate font-display text-base font-medium sm:text-lg";
      title.style.color = "var(--foreground)";
      title.textContent = getMaintenanceReleaseTitle(releases.length);
      summary.append(version, title);

      const newestRelease = releases[0];
      const formattedDate = formatDate(newestRelease.publishedAt);
      if (formattedDate && newestRelease.publishedAt) {
        const time = document.createElement("time");
        time.dateTime = newestRelease.publishedAt;
        time.className = "shrink-0 text-sm tabular-nums";
        time.style.color = "var(--muted-foreground)";
        time.textContent = formattedDate;
        summary.append(time);
      }

      const marker = document.createElement("span");
      marker.className =
        "changelog-patch-marker inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-lg leading-none";
      marker.setAttribute("aria-hidden", "true");
      marker.style.background = "var(--muted)";
      marker.style.color = "var(--foreground)";
      marker.textContent = "+";
      summary.append(marker);

      const body = document.createElement("div");
      body.className = "changelog-maintenance-list px-5 pb-2 sm:px-6";
      body.style.borderTop = "1px solid var(--border)";
      body.append(...releases.map(renderMaintenanceItem));

      details.append(summary, body);
      return details;
    };

    const renderReleaseEntry = (
      entry: ChangelogReleaseEntry<ChangelogRelease>,
    ) => {
      switch (entry.type) {
        case "maintenance":
          return renderMaintenanceReleases(entry.releases);
        case "release":
          return isFeatureRelease(entry.release.heading)
            ? renderFeatureRelease(entry.release)
            : renderCompactRelease(entry.release);
        default: {
          entry satisfies never;
          return panic(`Unhandled changelog entry: ${String(entry)}`);
        }
      }
    };

    const findEntryPageForSlug = (
      entries: readonly ChangelogReleaseEntry<ChangelogRelease>[],
      slug: string,
    ): number | null => {
      const index = entries.findIndex((entry) =>
        entry.type === "maintenance"
          ? entry.releases.some((release) => release.slug === slug)
          : entry.release.slug === slug,
      );
      if (index === -1) {
        return null;
      }
      return Math.floor(index / CHANGELOG_ENTRIES_PER_PAGE) + 1;
    };

    const scrollToCurrentHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      if (!id) {
        return;
      }

      const target = document.querySelector(`#${CSS.escape(id)}`);
      if (!target) {
        return;
      }

      let ancestor: Element | null = target;
      while (ancestor) {
        if (ancestor instanceof HTMLDetailsElement) {
          ancestor.open = true;
        }
        ancestor = ancestor.parentElement;
      }

      target.scrollIntoView({ block: "start" });
    };

    const initializeChangelog = () => {
      const releasesContainer =
        document.querySelector<HTMLElement>("#changelog-releases");
      const paginationContainer = document.querySelector<HTMLElement>(
        "#changelog-pagination",
      );
      const entriesElement =
        document.querySelector<HTMLElement>("#changelog-entries");
      if (!releasesContainer) {
        return;
      }

      const allEntries = readEntries(entriesElement);
      const totalPages = Math.max(
        1,
        Math.ceil(allEntries.length / CHANGELOG_ENTRIES_PER_PAGE),
      );

      for (const anchor of releasesContainer.querySelectorAll<HTMLAnchorElement>(
        "a[data-release-anchor]",
      )) {
        const slug = anchor.dataset["releaseAnchor"];
        if (slug) {
          bindAnchorClick(anchor, slug);
        }
      }

      const readRequestedPage = () => {
        const raw = Number(
          new URLSearchParams(window.location.search).get("page"),
        );
        if (Number.isInteger(raw) && raw >= 1 && raw <= totalPages) {
          return raw;
        }
        const hashSlug = decodeURIComponent(window.location.hash.slice(1));
        if (hashSlug) {
          return findEntryPageForSlug(allEntries, hashSlug) ?? 1;
        }
        return 1;
      };

      let currentPage = readRequestedPage();

      const updatePageUrl = (page: number) => {
        const url = new URL(window.location.href);
        if (page === 1) {
          url.searchParams.delete("page");
        } else {
          url.searchParams.set("page", String(page));
        }
        window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
      };

      const renderPagination = () => {
        if (!paginationContainer) {
          return;
        }
        paginationContainer.replaceChildren();

        if (totalPages <= 1) {
          paginationContainer.classList.add("hidden");
          paginationContainer.classList.remove("flex");
          return;
        }

        const previousButton = document.createElement("button");
        previousButton.type = "button";
        previousButton.className =
          "inline-flex h-10 items-center justify-center rounded-[0.625rem] px-4 text-sm font-medium transition-opacity hover:opacity-80 disabled:cursor-not-allowed disabled:opacity-40";
        previousButton.style.background = "var(--card)";
        previousButton.style.border = "1px solid var(--border)";
        previousButton.style.color = "var(--foreground)";
        previousButton.disabled = currentPage === 1;
        previousButton.textContent = "Previous";
        previousButton.addEventListener("click", () => {
          if (currentPage > 1) {
            goToPage(currentPage - 1, true);
          }
        });

        const pageIndicator = document.createElement("span");
        pageIndicator.className = "text-sm tabular-nums";
        pageIndicator.style.color = "var(--muted-foreground)";
        pageIndicator.textContent = `Page ${currentPage} of ${totalPages}`;

        const nextButton = document.createElement("button");
        nextButton.type = "button";
        nextButton.className =
          "inline-flex h-10 items-center justify-center rounded-[0.625rem] px-4 text-sm font-medium transition-opacity hover:opacity-80 disabled:cursor-not-allowed disabled:opacity-40";
        nextButton.style.background = "var(--card)";
        nextButton.style.border = "1px solid var(--border)";
        nextButton.style.color = "var(--foreground)";
        nextButton.disabled = currentPage >= totalPages;
        nextButton.textContent = "Next";
        nextButton.addEventListener("click", () => {
          if (currentPage < totalPages) {
            goToPage(currentPage + 1, true);
          }
        });

        paginationContainer.append(previousButton, pageIndicator, nextButton);
        paginationContainer.classList.remove("hidden");
        paginationContainer.classList.add("flex");
      };

      const goToPage = (page: number, scrollTop: boolean) => {
        currentPage = page;
        const start = (page - 1) * CHANGELOG_ENTRIES_PER_PAGE;
        const pageEntries = allEntries.slice(
          start,
          start + CHANGELOG_ENTRIES_PER_PAGE,
        );
        releasesContainer.replaceChildren(
          ...pageEntries.map(renderReleaseEntry),
        );
        updatePageUrl(page);
        renderPagination();
        if (scrollTop) {
          releasesContainer.scrollIntoView({
            block: "start",
            behavior: "smooth",
          });
        } else {
          scrollToCurrentHash();
        }
      };

      // Page 1 is already server-rendered with identical markup; only replace
      // the DOM when navigating to another page.
      if (currentPage !== 1) {
        goToPage(currentPage, false);
      } else {
        renderPagination();
        scrollToCurrentHash();
      }
    };

    document.addEventListener("astro:page-load", initializeChangelog);
  </script>
</Base>
