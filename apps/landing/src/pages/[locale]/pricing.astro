---
import PricingPage from "../../components/PricingPage.astro";
import { defaultLocale, localeCodes, locales } from "../../i18n/config";

// The pricing page for every non-default locale at its path prefix
// (/cs/pricing/). PricingPage reads Astro.currentLocale for its translations.
export function getStaticPaths() {
  return localeCodes
    .filter((code) => code !== defaultLocale)
    .map((code) => ({ params: { locale: locales[code].path } }));
}
---

<PricingPage />
