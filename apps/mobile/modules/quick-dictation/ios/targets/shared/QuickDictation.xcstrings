            "value": "Diktovat do aplikace stella"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In stella diktieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate to stella"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictar a stella"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteeri rakendusse stella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicter dans stella"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktálás a stella alkalmazásba"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktuoti į stella"
          }
        },
        "lv": {
          "stringUnit": {
