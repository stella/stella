    "intent.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرة لبدء التسجيل ومرة أخرى لإنهائه. يُفتح النص في stella لحفظه في ملف قانوني أو إرساله إلى stella AI أو نسخه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním stiskem začnete nahrávat, dalším skončíte. Text se otevře v aplikaci stella: uložte ho do spisu, pošlete stella AI nebo zkopírujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal drücken zum Aufnehmen, noch einmal zum Beenden. Der Text öffnet sich in stella: in einer Akte speichern, an stella AI senden oder kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press once to record and again to finish. The text opens in stella, to save to a matter, send to stella AI or copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una vez para grabar y otra para terminar. El texto se abre en stella para guardarlo en un asunto, enviarlo a stella AI o copiarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta korra salvestamiseks ja uuesti lõpetamiseks. Tekst avaneb rakenduses stella: salvesta see toimikusse, saada stella AI-le või kopeeri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez une fois pour enregistrer, puis à nouveau pour terminer. Le texte s’ouvre dans stella pour l’enregistrer dans un dossier, l’envoyer à stella AI ou le copier."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomd meg egyszer a felvételhez, majd újra a befejezéshez. A szöveg a stella alkalmazásban nyílik meg: mentsd egy ügyhöz, küldd a stella AI-nak vagy másold ki."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paspauskite kartą, kad pradėtumėte įrašyti, ir dar kartą, kad baigtumėte. Tekstas atsidarys stella: išsaugokite jį byloje, nusiųskite stella AI arba nukopijuokite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nospiediet vienreiz, lai ierakstītu, un vēlreiz, lai pabeigtu. Teksts atveras stella: saglabājiet to lietā, nosūtiet stella AI vai nokopējiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij raz, aby nagrywać, i ponownie, aby zakończyć. Tekst otworzy się w aplikacji stella: zapisz go w sprawie, wyślij do stella AI lub skopiuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque uma vez para gravar e outra para concluir. O texto abre no stella para salvar em um caso, enviar ao stella AI ou copiar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedným stlačením začnete nahrávať, ďalším skončíte. Text sa otvorí v aplikácii stella: uložte ho do spisu, pošlite stella AI alebo skopírujte."
          }
        }
      }
    },
    "intent.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء التسجيل. حاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání se nepodařilo spustit. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht starten. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording could not start. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la grabación. Inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestamist ei õnnestunud alustada. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement n’a pas pu démarrer. Réessayez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvételt nem sikerült elindítani. Próbáld újra."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įrašymo nepavyko pradėti. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ierakstu neizdevās sākt. Mēģiniet vēlreiz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się rozpocząć nagrywania. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a gravação. Tente de novo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávanie sa nepodarilo spustiť. Skúste to znova."
          }
        }
      }
    },
    "intent.microphone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج الإملاء إلى الميكروفون. اسمح به لتطبيق stella في الإعدادات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování potřebuje mikrofon. Povolte ho pro aplikaci stella v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Diktieren braucht stella das Mikrofon. Erlaube es in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation needs the microphone. Allow it for stella in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado necesita el micrófono. Permítelo para stella en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimiseks on vaja mikrofoni. Luba see rakendusele stella seadetes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée a besoin du micro. Autorisez-le pour stella dans Réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktáláshoz mikrofon kell. Engedélyezd a stella számára a Beállításokban."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktavimui reikia mikrofono. Leiskite jį stella programai nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktēšanai vajag mikrofonu. Atļaujiet to stella iestatījumos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie wymaga mikrofonu. Zezwól na nie dla stella w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado precisa do microfone. Permita para o stella em Ajustes."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie potrebuje mikrofón. Povoľte ho pre aplikáciu stella v Nastaveniach."
          }
        }
      }
    },
    "intent.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح stella وسجّل الدخول لتتمكن من الإملاء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro diktování otevřete aplikaci stella a přihlaste se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne stella und melde dich an, um zu diktieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open stella and sign in to dictate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre stella e inicia sesión para dictar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimiseks ava rakendus stella ja logi sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez stella et connectez-vous pour dicter."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktáláshoz nyisd meg a stella alkalmazást, és jelentkezz be."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami diktuoti, atidarykite stella ir prisijunkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai diktētu, atveriet stella un piesakieties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dyktować, otwórz aplikację stella i zaloguj się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o stella e entre para ditar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na diktovanie otvorte aplikáciu stella a prihláste sa."
          }
        }
      }
    },
