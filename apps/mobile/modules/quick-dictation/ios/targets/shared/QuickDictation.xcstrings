            "value": "Diktēt uz stella"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktuj do aplikacji stella"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditar para o stella"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovať do aplikácie stella"
          }
        }
      }
    },
    "control.label": {
      "extractionState": "manual",
      "localizations": {
