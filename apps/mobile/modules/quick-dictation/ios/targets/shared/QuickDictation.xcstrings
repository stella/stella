{
  "sourceLanguage": "en",
  "strings": {
    "control.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل حتى تضغط مرة أخرى، ثم يفتح النص في stella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrává, dokud znovu nestisknete, a pak otevře text v aplikaci stella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt auf, bis du erneut drückst, und öffnet dann den Text in stella."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records until you press again, then opens the text in stella."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba hasta que vuelvas a pulsar y luego abre el texto en stella."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestab, kuni vajutad uuesti, ja avab siis teksti rakenduses stella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre jusqu’à ce que vous appuyiez à nouveau, puis ouvre le texte dans stella."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Addig rögzít, amíg újra meg nem nyomod, majd megnyitja a szöveget a stella alkalmazásban."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įrašo, kol paspausite dar kartą, tada atidaro tekstą stella."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieraksta, līdz nospiežat vēlreiz, tad atver tekstu stella."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywa, dopóki nie naciśniesz ponownie, a potem otwiera tekst w aplikacji stella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava até você tocar de novo e depois abre o texto no stella."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahráva, kým znova nestlačíte, a potom otvorí text v aplikácii stella."
          }
        }
      }
    },
    "control.displayName": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإملاء إلى stella"
          }
