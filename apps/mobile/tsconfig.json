{
  "extends": ["@stll/typescript-config/base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/api/*": ["../api/src/*"],
      "@stll/infosoud": ["../../packages/infosoud/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
