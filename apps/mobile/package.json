{
  "name": "@stll/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform all",
    "clean": "git clean -xdf .cache .expo .turbo dist node_modules",
    "dev": "expo start",
    "doctor": "bun scripts/expo-doctor.ts .",
    "ios": "expo start --ios",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check apps/mobile",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix apps/mobile",
    "start": "expo start",
    "test": "bun test",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json && bun check --no-pretty --all --project=tsconfig.scripts.json",
    "web": "expo start --web"
  },
  "dependencies": {
    "@stll/api-contract": "workspace:*",
    "@stll/locales": "workspace:*",
    "better-result": "catalog:",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "~0.21.4",
    "temporal-polyfill": "catalog:",
    "use-intl": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@stll/property-testing": "workspace:*",
    "@stll/scripts": "workspace:*",
    "@stll/sha256": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@types/react": "catalog:react19",
    "bun-types": "catalog:",
    "expo-doctor": "1.21.5",
    "fast-check": "catalog:"
  },
  "crawlPosture": "unserved",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-safe-area-context"
      ]
    }
  }
}
