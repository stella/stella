{
  "name": "@stll/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform all",
    "clean": "git clean -xdf .cache .expo .turbo dist node_modules",
    "dev": "expo start",
    "doctor": "EXPO_OFFLINE=1 expo-doctor .",
    "format": "oxfmt -c ../../.oxfmtrc.json .",
    "ios": "expo start --ios",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware apps/mobile",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix apps/mobile",
    "start": "expo start",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@noble/hashes": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@stll/api": "workspace:*",
    "@stll/api-client": "workspace:*",
    "@stll/api-contract": "workspace:*",
    "@stll/ui": "workspace:*",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "catalog:",
    "better-result": "catalog:",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "1.24.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@stll/typescript-config": "workspace:*",
    "@types/react": "catalog:react19",
    "expo-doctor": "1.20.1"
  },
  "crawlPosture": "unserved"
}
