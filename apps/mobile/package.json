{
  "name": "@stll/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform all",
    "build:widgets": "node scripts/build-widget-bundle.mjs",
    "clean": "git clean -xdf .cache .expo .turbo dist node_modules",
    "dev": "expo start",
    "doctor": "bun scripts/expo-doctor.ts .",
    "native-fingerprint": "bun scripts/fingerprint.ts",
    "native-client": "bun scripts/native-client.ts",
    "sim": "bun scripts/sim.ts",
    "ios": "expo run:ios",
    "lint": "cd ../.. && bun scripts/lint.ts apps/mobile",
    "lint:fix": "cd ../.. && bun scripts/lint.ts --fix apps/mobile",
    "start": "expo start",
    "test": "bun test",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json && bun check --no-pretty --all --project=tsconfig.scripts.json",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@expo/ui": "58.0.27",
    "@expo/vector-icons": "15.1.1",
    "@formatjs/intl-pluralrules": "7.0.4",
    "@stll/agent-input": "workspace:*",
    "@stll/api-contract": "workspace:*",
    "@stll/brand": "workspace:*",
    "@stll/chat-limits": "workspace:*",
    "@stll/concurrency": "workspace:*",
    "@stll/docx-core": "catalog:",
    "@stll/folio-fonts": "catalog:",
    "@stll/folio-react": "catalog:",
    "@stll/locales": "workspace:*",
    "@stll/permissions": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "@stll/ui": "workspace:*",
    "better-result": "catalog:",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.19",
    "expo-audio": "58.0.11",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "58.0.27",
    "lucide-react-native": "catalog:",
    "lucide-static": "catalog:",
    "pdfjs-dist": "^6.5.438",
    "prosemirror-commands": "catalog:",
    "prosemirror-dropcursor": "catalog:",
    "prosemirror-gapcursor": "catalog:",
    "prosemirror-history": "catalog:",
    "prosemirror-inputrules": "catalog:",
    "prosemirror-keymap": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-state": "catalog:",
    "prosemirror-tables": "catalog:",
    "prosemirror-transform": "catalog:",
    "prosemirror-view": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "~0.21.4",
    "temporal-polyfill": "catalog:",
    "uniwind": "1.13.2",
    "use-intl": "catalog:",
    "valibot": "catalog:",
    "y-prosemirror": "catalog:",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@expo/fingerprint": "~0.21.8",
    "@stll/property-testing": "workspace:*",
    "@stll/scripts": "workspace:*",
    "@stll/sha256": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@types/react": "catalog:react19",
    "agent-device": "0.21.36",
    "bun-types": "catalog:",
    "expo-doctor": "1.21.6",
    "fast-check": "catalog:",
    "tailwindcss": "catalog:",
    "whatwg-fetch": "3.6.20"
  },
  "crawlPosture": "unserved",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-widgets"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-safe-area-context"
      ]
    }
  }
}
