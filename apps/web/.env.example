# Generated by `bun run env:generate`; edit the Valibot schemas or env catalog.
# Required entries are active. Optional entries are commented out unless
# stella's local development stack intentionally enables them.

# --- Analytics ---------------------------------------------------------
# [public] Optional. Public PostHog project key. The placeholder "phc_"
# disables local capture.
VITE_POSTHOG_KEY="phc_"

# [public] Optional. Posthog host.
# VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# [public] Optional with a default. Allow browser PostHog capture from
# localhost when using a real key.
# VITE_POSTHOG_LOCAL_DEBUG="false"

# --- URLs --------------------------------------------------------------
# [public] Required. API base URL used by the SPA for Eden treaty requests.
VITE_API_URL="http://localhost:3001"

# [public] Optional with a default. Public web origin used for canonical URLs,
# Open Graph metadata, and sitemaps.
VITE_PUBLIC_APP_URL="http://localhost:3000"

# [public] Optional. WebSocket URL for collaborative editing. Unset keeps the
# single-user editing path.
# VITE_COLLAB_URL="ws://localhost:3002"

# [public] Optional with a default. Absolute or root-relative Terms of Service
# link.
# VITE_TERMS_URL="/terms"

# [public] Optional. Public URL for the Matters onboarding video. Unset uses
# only the bundled poster.
# VITE_EMPTY_STATE_MATTERS_VIDEO_URL="https://assets.stll.app/empty-states/matters-intro.mp4"

# [public] Optional with a default. Desktop releases base url.
# VITE_DESKTOP_RELEASES_BASE_URL="https://github.com/stella/stella/releases/latest/download"

# --- Runtime -----------------------------------------------------------
# [public] Optional with a default. Desktop bridge port.
# VITE_DESKTOP_BRIDGE_PORT="45901"

# [public] Optional with a default. Show Google login only when the API has
# matching OAuth credentials.
# VITE_AUTH_GOOGLE="false"

# [public] Optional with a default. Show Microsoft login only when the API has
# matching OAuth credentials.
# VITE_AUTH_MICROSOFT="false"

# [public] Optional with a default. Enable the release-update notice for
# self-hosted operators.
# VITE_SELFHOST="false"

# [public] Optional. Recipient for the in-app feedback button. Unset hides the
# button.
# VITE_FEEDBACK_EMAIL_TO="ops@example.com"

# --- Feature flags -----------------------------------------------------
# [public] Optional with a default. Feature chat.
# VITE_FEATURE_CHAT="false"

# [public] Optional with a default. Feature usage.
# VITE_FEATURE_USAGE="false"

# [public] Optional with a default. Feature knowledge templates.
# VITE_FEATURE_KNOWLEDGE_TEMPLATES="false"

# [public] Optional with a default. Feature case law.
# VITE_FEATURE_CASE_LAW="false"

# [public] Optional with a default. Public law enabled.
# VITE_PUBLIC_LAW_ENABLED="false"

# [public] Optional with a default. Public law indexing enabled.
# VITE_PUBLIC_LAW_INDEXING_ENABLED="false"

# [public] Optional with a default. Allow search engines to index this
# deployment.
# VITE_SEO_INDEXABLE="false"

# [public] Optional with a default. Playbooks enabled.
# VITE_PLAYBOOKS_ENABLED="false"

# [public] Optional with a default. Workflows enabled.
# VITE_WORKFLOWS_ENABLED="false"

# [public] Optional with a default. In-app guides enabled.
# VITE_GUIDES_ENABLED="false"

# [public] Optional with a default. Feature contacts.
# VITE_FEATURE_CONTACTS="false"

# [public] Optional with a default. Feature calendar.
# VITE_FEATURE_CALENDAR="false"

# [public] Optional with a default. Feature todos.
# VITE_FEATURE_TODOS="false"

# [public] Optional with a default. Feature mcp.
# VITE_FEATURE_MCP="false"

# [public] Optional with a default. Feature desktop editing.
# VITE_FEATURE_DESKTOP_EDITING="false"

# [public] Optional with a default. Feature time billing.
# VITE_FEATURE_TIME_BILLING="false"

# [public] Optional with a default. Feature folio collab.
# VITE_FEATURE_FOLIO_COLLAB="false"
