{
  "name": "@stll/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun build --target=bun --outfile=dist/runtime.js src/runtime.ts && bun scripts/assert-start-runtime-build.ts",
    "build:analyze": "vite build --mode analyze",
    "clean": "git clean -xdf .cache .turbo node_modules",
    "typegen": "bun ../../packages/scripts/src/i18n-typegen.ts src/i18n/langs && bun scripts/sync-prepaint-locales.ts",
    "glossary": "bun ../../packages/scripts/src/glossary-gen.ts src/i18n",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit && bun ../../packages/scripts/src/tsc-native.ts --noEmit -p e2e/tsconfig.json && bun ../../packages/scripts/src/tsc-native.ts --noEmit -p e2e/unit/tsconfig.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware apps/web",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix apps/web",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "i18n:check": "bun ../../packages/scripts/src/i18n-typegen.ts src/i18n/langs --check && bun ../../packages/scripts/src/i18n-check.ts src/i18n/langs && bun ../../packages/scripts/src/glossary-gen.ts src/i18n --check && bun ../../packages/scripts/src/i18n-lint.ts src/i18n/langs && bun scripts/sync-prepaint-locales.ts --check",
    "i18n:sync": "bun ../../packages/scripts/src/i18n-check.ts src/i18n/langs --sync && bun ../../packages/scripts/src/i18n-typegen.ts src/i18n/langs && bun ../../packages/scripts/src/glossary-gen.ts src/i18n && bun scripts/sync-prepaint-locales.ts",
    "test": "bun test --path-ignore-patterns='e2e/**' && bun test --parallel=2 e2e/unit",
    "test:timings": "mkdir -p .cache && bun test --parallel=2 --timings=.cache/e2e-unit-timings.json --update-timings e2e/unit",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlF 'fc.assert' src --include='*.test.ts' --include='*.test.tsx')",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:stack-redaction": "playwright test --config e2e/playwright.stack-redaction.config.ts",
    "test:e2e:collab": "playwright test --config e2e/playwright.collab.config.ts",
    "test:e2e:ui-playground": "playwright test --config e2e/playwright.ui-playground.config.ts",
    "test:e2e:ui-playground:update": "playwright test --config e2e/playwright.ui-playground.config.ts --update-snapshots=all",
    "test:e2e:marketing": "playwright test --config e2e/playwright.marketing.config.ts --project app",
    "test:e2e:marketing:update": "playwright test --config e2e/playwright.marketing.config.ts --project app --update-snapshots=all",
    "test:e2e:landing": "playwright test --config e2e/playwright.marketing.config.ts --project landing",
    "capture:product-story": "bun e2e/marketing/record-product-story.ts",
    "test:e2e:staging": "playwright test --config e2e/playwright.staging.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui"
  },
