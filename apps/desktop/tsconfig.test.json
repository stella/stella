{
  "extends": "@stll/typescript-config/react-library.json",
  "compilerOptions": {
    "types": ["bun-types"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.test.json"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["dist", "node_modules", "src-tauri"]
}
