{
  "extends": "@stll/typescript-config/react-library.json",
  "compilerOptions": {
    "types": ["bun-types", "vite/client"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.test.json"
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src-tauri/src/*.test.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
