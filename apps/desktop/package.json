{
  "name": "@stll/desktop",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "activity-data-map:check": "cargo test --manifest-path src-tauri/Cargo.toml --locked activity_data_map::generated_activity_data_map_is_current -- --exact",
    "activity-data-map:generate": "cargo test --manifest-path src-tauri/Cargo.toml --locked activity_data_map::generate_activity_data_map -- --ignored --exact",
    "build": "bun --bun tauri build --config src-tauri/tauri.sidecar.conf.json",
    "build:sidecar": "bun run --cwd ../../packages/agent-engine build:sidecar",
    "build:pkcs11-helper": "bun scripts/build-pkcs11-helper.ts",
    "build:view": "bun --bun vite build",
    "clean": "git clean -xdf .cache .turbo dist node_modules src-tauri/target",
    "dev": "bun --bun tauri dev",
    "dev:view": "bun --bun vite --host 127.0.0.1 --strictPort",
    "lint": "cd ../.. && bun scripts/lint.ts apps/desktop",
    "lint:fix": "cd ../.. && bun scripts/lint.ts --fix apps/desktop",
    "rpc:check": "cargo test --manifest-path src-tauri/Cargo.toml --locked types::rpc_codegen_tests::generated_desktop_rpc_bindings_are_current -- --exact",
    "rpc:generate": "cargo test --manifest-path src-tauri/Cargo.toml --locked types::rpc_codegen_tests::generate_desktop_rpc_bindings -- --ignored --exact",
    "test": "bun test --isolate --path-ignore-patterns '**/*.playwright.spec.ts'",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src tests --include='*.test.ts' --include='*.test.tsx')",
    "test:browser": "bun --bun playwright test --config playwright.config.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --test panel_lifecycle --locked",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json && bun check --no-pretty --all --project=tsconfig.test.json",
    "i18n:accept": "bun ../../packages/scripts/src/i18n-check.ts src/i18n/langs --accept",
    "i18n:brief": "bun ../../packages/scripts/src/i18n-brief.ts src/i18n/langs --glossary=../web/src/i18n/glossary.json --usage-in=src --memory=../web/src/i18n/langs",
    "i18n:check": "bun ../../packages/scripts/src/i18n-check.ts src/i18n/langs && bun ../../packages/scripts/src/i18n-lint.ts src/i18n/langs --glossary=../web/src/i18n/glossary.json",
    "i18n:sync": "bun ../../packages/scripts/src/i18n-check.ts src/i18n/langs --sync"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@stll/api-contract": "workspace:*",
    "@stll/business-registries": "workspace:*",
    "@stll/concurrency": "workspace:*",
    "@stll/docx-authoring": "workspace:*",
    "@stll/locales": "workspace:*",
    "@stll/markdown-editor": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "@stll/time": "0.4.3",
    "@stll/transcript": "workspace:*",
    "@stll/ui": "workspace:*",
    "@tauri-apps/api": "^2.12.5",
    "better-result": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "^1.65.1",
    "@stll/agent-engine": "workspace:*",
    "@stll/property-testing": "workspace:*",
    "@stll/scripts": "workspace:*",
    "@stll/sha256": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "bun-types": "catalog:",
    "fast-check": "catalog:",
    "oxc-transform-react": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "crawlPosture": "unserved"
}
