{
  "name": "@stll/desktop",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "build:view": "vite build",
    "clean": "git clean -xdf .cache .turbo dist node_modules src-tauri/target",
    "dev": "tauri dev",
    "dev:view": "vite --host 127.0.0.1 --strictPort",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check apps/desktop",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix apps/desktop",
    "rpc:check": "cargo test --manifest-path src-tauri/Cargo.toml --locked types::rpc_codegen_tests::generated_desktop_rpc_bindings_are_current -- --exact",
    "rpc:generate": "cargo test --manifest-path src-tauri/Cargo.toml --locked types::rpc_codegen_tests::generate_desktop_rpc_bindings -- --ignored --exact",
    "test": "bun test --isolate --path-ignore-patterns '**/*.playwright.spec.ts'",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src tests --include='*.test.ts' --include='*.test.tsx')",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --test panel_lifecycle --locked",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json && bun check --no-pretty --all --project=tsconfig.test.json"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@stll/api-contract": "workspace:*",
    "@stll/business-registries": "workspace:*",
    "@stll/concurrency": "workspace:*",
    "@stll/locales": "workspace:*",
    "@stll/text-normalize": "workspace:*",
    "@stll/time": "0.4.1",
    "@stll/ui": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "better-result": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "^1.64.1",
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "bun-types": "catalog:",
    "fast-check": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "crawlPosture": "unserved"
}
