{
  "identifier": "default",
  "description": "Default capabilities for stella desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-update-notification-preferences",
    "allow-copy-diagnostics",
    "allow-email-support",
    "allow-reveal-support-root",
    "allow-is-autostart-enabled",
    "allow-set-autostart",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "deep-link:default",
    "updater:default",
    "process:default"
  ]
}
