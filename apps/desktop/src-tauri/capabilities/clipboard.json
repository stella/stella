{
  "identifier": "clipboard",
  "description": "Clipboard timeline commands and history event subscriptions",
  "windows": ["clipboard"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-is-autostart-enabled",
    "allow-set-autostart",
    "allow-clipboard-get-snapshot",
    "allow-clipboard-get-image-preview",
    "allow-clipboard-complete-welcome",
    "allow-clipboard-set-capture-status",
    "allow-clipboard-set-retention",
    "allow-clipboard-set-screen-capture",
    "allow-clipboard-delete-item",
    "allow-clipboard-duplicate-item",
    "allow-clipboard-clear-history",
    "allow-clipboard-create-group",
    "allow-clipboard-delete-group",
    "allow-clipboard-update-group",
    "allow-clipboard-set-item-name",
    "allow-clipboard-set-item-group",
    "allow-clipboard-open-editor",
    "allow-clipboard-copy-item",
    "allow-clipboard-hide",
    "allow-clipboard-open-stella",
    "allow-desktop-report-error",
    "allow-desktop-report-timing"
  ]
}
