{
  "identifier": "activity",
  "description": "Local activity timeline through restricted native commands",
  "windows": ["activity"],
  "permissions": [
    "allow-account-record-use",
    "allow-get-desktop-language",
    "allow-set-desktop-language",
    "allow-desktop-report-error",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-activity-get-day",
    "allow-activity-open-settings",
    "allow-activity-set-capture-details",
    "allow-activity-set-browser-title-capture",
    "allow-activity-open-accessibility-settings",
    "allow-time-entry-search-matters",
    "allow-activity-set-recording-status",
    "allow-activity-copy-text",
    "allow-time-entry-candidates",
    "allow-time-entry-submit-batch-confirmed",
    "allow-activity-assign-ranges",
    "allow-billing-draft-get-settings",
    "allow-billing-draft-grant-consent",
    "allow-billing-draft-withdraw-consent",
    "allow-billing-draft-create-confirmed"
  ]
}
