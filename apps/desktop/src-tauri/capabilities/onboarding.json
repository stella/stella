{
  "identifier": "onboarding",
  "description": "First-run setup window",
  "windows": ["onboarding"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-desktop-language",
    "allow-set-desktop-language",
    "allow-account-record-use",
    "allow-account-get-state",
    "allow-open-stella-account",
    "allow-desktop-report-error",
    "allow-set-autostart",
    "allow-onboarding-get-snapshot",
    "allow-onboarding-advance",
    "allow-onboarding-complete",
    "allow-onboarding-later",
    "allow-onboarding-open-settings",
    "allow-permissions-get-snapshot",
    "allow-permissions-request",
    "allow-permissions-open-settings",
    "allow-shortcut-get-snapshot",
    "allow-shortcut-check",
    "allow-shortcut-pause",
    "allow-shortcut-resume",
    "allow-onboarding-dismiss",
    "allow-onboarding-open-activity",
    "allow-shortcut-set",
    "allow-dictation-get-snapshot",
    "allow-dictation-set-enabled",
    "allow-dictation-set-cleanup",
    "allow-dictation-set-share-window-title",
    "allow-dictation-set-share-text-before-cursor",
    "allow-dictation-set-custom-words",
    "allow-dictation-set-destination",
    "allow-dictation-get-cloud-models",
    "allow-dictation-set-cloud-model",
    "allow-dictation-download-model",
    "allow-dictation-get-microphones",
    "allow-dictation-set-microphone",
    "allow-dictation-test-microphone-start",
    "allow-dictation-test-microphone-stop",
    "allow-dictation-notice-get-state",
    "allow-dictation-notice-respond",
    "core:window:allow-start-dragging"
  ]
}
