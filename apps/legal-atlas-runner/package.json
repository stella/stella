{
  "name": "@stll/legal-atlas-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Bun CLI and Docker runtime for Legal Atlas corpus jobs",
  "keywords": [
    "case-law",
    "corpus",
    "legal",
    "legislation",
    "parser"
  ],
  "homepage": "https://github.com/stella/stella/tree/main/apps/legal-atlas-runner",
  "bugs": {
    "url": "https://github.com/stella/stella/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/stella.git",
    "directory": "apps/legal-atlas-runner"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build --target=bun --define 'process.env.NODE_ENV=\"production\"' --define __STELLA_RELEASE__=true --sourcemap=inline --outfile dist/index.js src/index.ts && bun build --target=bun --define 'process.env.NODE_ENV=\"production\"' --define __STELLA_RELEASE__=true --sourcemap=inline --outfile dist/eu-ecj-refetch.js ../api/src/scripts/eu-ecj-refetch.ts",
    "clean": "git clean -xdf dist .cache .turbo node_modules",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "smoke": "bun src/index.ts smoke",
    "test": "bun test src --pass-with-no-tests",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --type-aware --type-check apps/legal-atlas-runner",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix apps/legal-atlas-runner",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "test:property": "bun test --preload @stll/property-testing/preload $(grep -rlE 'fc\\.assert|assertProperty' src --include='*.test.ts')"
  },
  "dependencies": {
    "@stll/api": "workspace:*",
    "@stll/legal-ast": "workspace:*",
    "@stll/legal-atlas": "workspace:*",
    "@stll/scripts": "workspace:*",
    "@stll/time": "workspace:*",
    "better-result": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:"
  },
  "crawlPosture": "unserved"
}
