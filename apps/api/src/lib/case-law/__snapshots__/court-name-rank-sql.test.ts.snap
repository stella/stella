      WHEN citing_d.court ~* 'sąd rejonowy' THEN 2
      WHEN citing_d.court ~* '^správny súd' THEN 3
      WHEN citing_d.court ~* 'okresný súd|mestský súd' THEN 2
      WHEN citing_d.court ~* 'špecializovaný trestný súd|špeciálny súd' THEN 3
      ELSE 1 END"
`;
