      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["api-key"],
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["value"],
      "type": "object"
    },
    "AssistantMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            },
            {
              "items": {
                "$ref": "#/$defs/ContentChunk"
              },
              "type": "array"
            }
          ]
        },
        "prefix": {
          "type": "boolean"
        },
        "role": {
          "const": "assistant",
          "type": "string"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "AudioChunk": {
      "additionalProperties": false,
      "properties": {
        "input_audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "format": "binary",
              "type": "string"
            }
          ]
        },
        "type": {
          "const": "input_audio",
          "type": "string"
        }
      },
      "required": ["input_audio"],
      "type": "object"
    },
