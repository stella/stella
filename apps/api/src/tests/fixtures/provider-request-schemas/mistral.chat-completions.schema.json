          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Tool"
                  },
                  {
                    "$ref": "#/$defs/WebSearchTool"
                  },
                  {
                    "$ref": "#/$defs/WebSearchPremiumTool"
                  },
                  {
                    "$ref": "#/$defs/CodeInterpreterTool"
                  },
                  {
                    "$ref": "#/$defs/ImageGenerationTool"
                  },
                  {
                    "$ref": "#/$defs/DocumentLibraryTool"
                  },
                  {
                    "$ref": "#/$defs/CustomConnector"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
