        "presence_penalty": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": -2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt_cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
