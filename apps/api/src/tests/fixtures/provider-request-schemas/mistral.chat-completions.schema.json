          "anyOf": [
            {
              "maximum": 2,
              "minimum": -2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "guardrails": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GuardrailConfig"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/SystemMessage"
              },
              {
                "$ref": "#/$defs/UserMessage"
              },
              {
                "$ref": "#/$defs/AssistantMessage"
              },
              {
                "$ref": "#/$defs/ToolMessage"
              }
            ]
          },
          "type": "array"
