        "model": {
          "type": "string"
        },
        "n": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "parallel_tool_calls": {
          "type": "boolean"
        },
        "prediction": {
          "$ref": "#/$defs/Prediction"
