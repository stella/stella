{
  "format": 1,
  "provider": "openai",
  "scenario": "server-error",
  "source": "synthetic",
  "basis": "OpenAI Responses API streaming reference: typed response.* server-sent events, strict function tools; error object shape",
  "model": "gpt-6-sol",
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/responses",
        "shape": {
          "headers": {
            "accept": "application/json",
            "content-type": "application/json"
          },
          "body": {
            "include": ["reasoning.encrypted_content"],
            "store": false,
            "max_output_tokens": 128000,
            "service_tier": "default",
            "model": "gpt-6-sol",
            "input": [
              {
                "type": "message",
                "role": "user",
                "content": [
                  {
                    "type": "input_text",
                    "text": "[prompt]"
                  }
                ]
              }
            ],
            "tools": [
              {
                "type": "function",
                "name": "mcp__external__delete",
                "description": "Delete a draft by name.",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "note": {
                      "type": ["string", "null"],
                      "minLength": 1
                    }
                  },
                  "required": ["name", "note"],
                  "additionalProperties": false
                },
                "strict": true
              }
            ],
            "stream": true
          }
        }
      },
      "response": {
        "status": 500,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "encoding": "text",
          "text": "{\"error\":{\"message\":\"The server had an error while processing your request. Sorry about that!\",\"type\":\"server_error\",\"param\":null,\"code\":null}}"
        }
      },
      "repeat": true
    }
  ],
  "expect": {
    "outcome": "error",
    "errorKind": "provider_unavailable"
  }
}
