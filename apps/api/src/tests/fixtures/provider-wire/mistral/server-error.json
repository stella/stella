{
  "format": 1,
  "provider": "mistral",
  "scenario": "server-error",
  "source": "synthetic",
  "basis": "A gateway's plain-text 503 in front of the API: no JSON error body",
  "model": "mistral-medium-latest",
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "shape": {
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "model": "mistral-medium-latest",
            "temperature": 0,
            "tools": [
              {
                "type": "function",
                "function": {
                  "name": "mcp__external__delete",
                  "description": "Delete a draft by name.",
                  "parameters": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "note": {
                        "type": ["string", "null"],
                        "minLength": 1
                      }
                    },
                    "required": ["name", "note"],
                    "additionalProperties": false
                  },
                  "strict": true
                }
              }
            ],
            "messages": [
              {
                "role": "user",
                "content": "[prompt]"
              }
            ],
            "stream": true,
            "stream_options": {
              "include_usage": true
            },
            "max_tokens": 262144
          }
        }
      },
      "response": {
        "status": 503,
        "headers": {
          "content-type": "text/plain"
        },
        "body": {
          "encoding": "text",
          "text": "Service Unavailable"
        }
      },
      "repeat": true
    }
  ],
  "expect": {
    "outcome": "error",
    "errorKind": "provider_unavailable"
  }
}
