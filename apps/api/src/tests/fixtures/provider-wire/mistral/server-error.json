{
  "format": 1,
  "provider": "mistral",
  "scenario": "server-error",
  "source": "synthetic",
  "basis": "A gateway's plain-text 503 in front of the API: no JSON error body",
  "model": "mistral-medium-latest",
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions"
      },
      "response": {
        "status": 503,
        "headers": {
          "content-type": "text/plain"
        },
        "body": {
          "encoding": "text",
          "text": "Service Unavailable"
        }
      },
      "repeat": true
    }
  ],
  "expect": {
    "outcome": "error",
    "errorKind": "provider_unavailable"
  }
}
