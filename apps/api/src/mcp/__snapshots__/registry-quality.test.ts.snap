            "organization"
          ],
          "type": "string",
          "description": "Contact kind"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Opaque cursor from the previous page"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum contacts to return"
        }
      }
    }
  },
  {
    "name": "save_contact",
