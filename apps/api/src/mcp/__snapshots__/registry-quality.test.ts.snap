  {
    "name": "save_matter",
    "scope": "stella:matters_write",
    "access": "write",
    "description": "Create, update, archive, or unarchive a matter. Omit matter_id to create a new matter (name required; pass client_id to attach a client contact). Pass matter_id to update an existing matter: set name, reference, or billing_reference, and/or set status to 'archived' or 'active' to archive or unarchive it. Returns the matter ID.",
    "annotations": {
      "title": "Save matter",
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "inputSchema": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "matter_id": {
          "type": "string",
          "format": "uuid",
          "description": "Matter ID to update; omit to create a new matter"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Matter name; required when creating"
        },
        "client_id": {
          "type": "string",
          "format": "uuid",
          "description": "Contact ID to attach in the client role. Only valid when creating a matter."
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Matter reference (file number). Only valid when updating."
        },
        "billing_reference": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ],
          "description": "Billing reference; pass null to clear. Only valid when updating."
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ],
          "type": "string",
          "description": "Set 'archived' to archive the matter or 'active' to unarchive it. Only valid when updating."
        }
      }
    }
  },
  {
    "name": "delete_matter",
    "scope": "stella:matters_write",
    "access": "write",
    "description": "Permanently delete a matter and all its documents, tasks, fields, and chat history. This is irreversible.",
    "annotations": {
