  {
    "name": "list_time_entries",
    "scope": "stella:read",
    "access": "read",
    "feature": "FEATURE_TIME_BILLING",
    "description": "List time entries in a matter, or read one entry in detail. Pass time_entry_id to get a single entry. Otherwise pass matter_id to list the matter's entries, optionally filtered by entity_id (the item the time was logged against), user_id, a date-worked range (date_from/date_to, ISO YYYY-MM-DD), and status. Returns each entry's id, entity, user, date, minutes, rate (minor currency units), currency, narrative, and status. The response includes visibility: all_entries for billing reviewers, or own_entries when the caller can see only their own time; own_entries is not a matter total.",
    "annotations": {
      "title": "List time entries",
      "destructiveHint": false,
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "matter_id": {
          "type": "string",
          "format": "uuid",
          "description": "Matter ID to list time entries in; required unless time_entry_id is given."
        },
        "time_entry_id": {
          "type": "string",
          "format": "uuid",
          "description": "Time entry ID to read in detail"
        },
        "entity_id": {
          "type": "string",
          "format": "uuid",
          "description": "List only entries logged against this entity (document, folder, or task the time is billed to)"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "description": "List only entries recorded by this user"
        },
        "date_from": {
          "type": "string",
          "format": "date",
          "maxLength": 10,
          "description": "List only entries worked on or after this ISO date (YYYY-MM-DD)"
        },
        "date_to": {
          "type": "string",
          "format": "date",
          "maxLength": 10,
          "description": "List only entries worked on or before this ISO date (YYYY-MM-DD)"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "billed",
            "written_off"
          ],
          "type": "string",
          "description": "List only entries with this status"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Max entries to return"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Opaque cursor from a previous list_time_entries call to fetch the next page"
        }
      }
    }
  },
  {
    "name": "save_time_entry",
    "scope": "stella:billing_write",
    "access": "write",
    "feature": "FEATURE_TIME_BILLING",
    "description": "Create or update a time entry. Omit time_entry_id to create (matter_id, date_worked, timezone_id, duration_minutes, and narrative required; entity_id is optional context). Pass time_entry_id to update: set date_worked (with timezone_id), duration_minutes, narrative, invoice_narrative, billable, no_charge, entity_id (move the entry), task_code, and/or activity_code. The timekeeper's effective rate is resolved server-side. Durations are whole minutes. Returns the time entry ID.",
    "annotations": {
      "title": "Save time entry",
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "inputSchema": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "time_entry_id": {
          "type": "string",
          "format": "uuid",
          "description": "Time entry ID to update; omit to create"
        },
        "matter_id": {
          "type": "string",
          "format": "uuid",
          "description": "Matter ID to create the entry in; required when creating."
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional work item context (document, folder, or task). When updating, moves the entry to a different entity in the same matter; pass null to clear."
        },
        "date_worked": {
          "type": "string",
          "format": "date",
          "maxLength": 10,
          "description": "Date the work was done (ISO YYYY-MM-DD); required when creating"
        },
        "timezone_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone the date_worked is interpreted in (e.g. Europe/Prague); required when creating or changing date_worked"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "description": "Minutes worked (whole minutes); required when creating"
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "Description of the work; required when creating"
        },
        "invoice_narrative": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ],
          "description": "Client-facing narrative shown on the invoice; pass null to clear. Only valid when updating."
        },
        "billable": {
          "type": "boolean",
          "description": "Whether the entry is billable to the client"
        },
        "no_charge": {
          "type": "boolean",
          "description": "Whether the entry is recorded but not charged. Only valid when updating."
        },
        "task_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ],
          "description": "UTBMS/LEDES task code; pass null to clear"
        },
        "activity_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ],
          "description": "UTBMS/LEDES activity code; pass null to clear"
        }
      }
    }
  },
  {
    "name": "delete_time_entry",
    "scope": "stella:billing_write",
    "access": "write",
    "feature": "FEATURE_TIME_BILLING",
