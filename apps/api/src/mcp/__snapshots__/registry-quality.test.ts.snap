                },
                "value": {
                  "type": "integer",
                  "description": "The value: string for text, string or null for single-select, array of strings for multi-select, ISO YYYY-MM-DD or null for date, integer for int. Null or empty clears the cell."
                },
                "currency": {
                  "anyOf": [
