# Generated by `bun run env:generate`; edit the Valibot schemas or env catalog.
# Required entries are active. Optional entries are commented out unless
# stella's local development stack intentionally enables them.

# --- Runtime -----------------------------------------------------------
# [internal] Optional. Stella version.
# STELLA_VERSION=""

# [internal] Optional. Stella commit sha.
# STELLA_COMMIT_SHA=""

# [internal] Optional. Stella ocr pdf font path.
# STELLA_OCR_PDF_FONT_PATH=""

# [secret] Optional. Local-development-only read-only Postgres URL for the
# shared public-law corpus. Unset uses DATABASE_URL.
# PUBLIC_LAW_DATABASE_URL=""

# [internal] Optional with a default. Maximum connections in the optional
# local read-only public-law pool.
# PUBLIC_LAW_DATABASE_POOL_MAX="2"

# [secret] Optional. Logs otlp url.
# LOGS_OTLP_URL=""

# [secret] Optional. Logs otlp token.
# LOGS_OTLP_TOKEN=""

# [internal] Optional with a default. Morphological expansion of case-law
# search terms: "off" builds today's query, "shadow" runs the unexpanded query
# and records leaf counts comparing it with the expanded one (never the query
# text). "on" runs the expanded query and is currently refused at startup,
# pending cursors that carry the dictionary version.
# QUERY_EXPANSION_MODE="off"

# [secret] Required. Valkey or Redis URL used for cross-instance broadcasts
# and rate limits. Treated as secret because it may contain credentials.
REDIS_URL="redis://localhost:6379"

# [internal] Optional with a default. Whether a rediss:// connection verifies
# the server certificate chain. Leave on unless the endpoint presents a
# certificate no trust anchor can validate and the private network is the
# boundary instead.
# REDIS_TLS_REJECT_UNAUTHORIZED="true"

# [internal] Optional. Port.
# PORT=""

# [internal] Optional. Stella api port.
# STELLA_API_PORT=""

# [secret] Optional. Github token.
# GITHUB_TOKEN=""

# [internal] Optional with a default. E2e disable auth rate limit.
# E2E_DISABLE_AUTH_RATE_LIMIT="false"

# [secret] Optional. Smoke session secret.
# SMOKE_SESSION_SECRET=""

# [secret] Optional. Bearer token for registration metrics. Unset disables the
# endpoint; use a long random value.
# OPERATOR_METRICS_TOKEN=""

# [secret] Optional. Bearer credential used by the collaboration service for
# snapshot load and store requests.
STELLA_COLLAB_SERVICE_TOKEN="local-collab-service-token-at-least-32-chars"

# [secret] Optional. Demo account email.
# DEMO_ACCOUNT_EMAIL=""

# [secret] Optional. Demo account otp.
# DEMO_ACCOUNT_OTP=""

# [internal] Optional with a default. Enable explicit agent-mode chat requests
# for this deployment.
# AGENT_SANDBOX_RUNS_ENABLED="false"

# [internal] Optional. Directory holding the template-pack content. Set by the
# container image; unset in a source tree.
# TEMPLATE_PACKS_CONTENT_DIR=""

# [internal] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Container image used for isolated agent runs.
# AGENT_SANDBOX_IMAGE=""

# [internal] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Model identifier used by the isolated agent harness.
# AGENT_SANDBOX_HARNESS_MODEL=""

# [secret] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Model-provider credential delegated only to the isolated agent harness.
# AGENT_SANDBOX_HARNESS_API_KEY=""

# [internal] Optional. OpenAI-compatible endpoint used by the isolated agent
# harness.
# AGENT_SANDBOX_HARNESS_BASE_URL=""

# [internal] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Container-reachable MCP endpoint used by isolated agent runs.
# AGENT_SANDBOX_MCP_URL=""

# [internal] Optional. Docker daemon socket used to create agent sandboxes.
# Defaults to the platform Docker socket.
# AGENT_SANDBOX_DOCKER_SOCKET=""

# [internal] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Locked-down Docker network used by agent sandboxes. It must deny arbitrary
# egress.
# AGENT_SANDBOX_DOCKER_NETWORK=""

# [internal] Optional. Absolute directory of extra report specs (one
# <key>/spec.json per subdirectory). A key here overrides the bundled spec of
# the same name.
# REPORT_SPECS_DIR=""

# [internal] Optional. s3://bucket/prefix/ of extra report specs in the
# REPORT_SPECS_DIR layout, read once at boot. Exclusive with REPORT_SPECS_DIR.
# REPORT_SPECS_S3_PREFIX=""

# --- Database ----------------------------------------------------------
# [internal] Optional. Stella worker dir.
# STELLA_WORKER_DIR=""

# [internal] Optional. Skip migration check.
# SKIP_MIGRATION_CHECK=""

# [secret] Required. Postgres owner URL used by Drizzle. Requests downgrade to
# the stella role so row-level security applies.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/stella"

# [internal] Optional with a default. Maximum root pool size. Keep its sum
# with DATABASE_RLS_POOL_MAX within the process connection budget.
DATABASE_ROOT_POOL_MAX="5"

# [internal] Optional with a default. Maximum RLS pool size. Keep its sum with
# DATABASE_ROOT_POOL_MAX within the process connection budget.
DATABASE_RLS_POOL_MAX="5"

# [internal] Optional with a default. Maximum database connection lifetime in
# seconds; zero disables retirement.
# DATABASE_POOL_MAX_LIFETIME_S="0"

# [internal] Optional with a default. Idle database connection lifetime in
# seconds; zero disables retirement.
# DATABASE_POOL_IDLE_TIMEOUT_S="0"

# [internal] Optional. Postgres hostname used with the component settings when
# DATABASE_URL is unset.
# DB_HOST="localhost"

# [internal] Optional. Postgres port used with the component settings when
# DATABASE_URL is unset.
# DB_PORT="5432"

# [internal] Optional. Postgres user used with the component settings when
# DATABASE_URL is unset.
# DB_USER="postgres"

# [secret] Optional. Postgres password used with the component settings when
# DATABASE_URL is unset.
# DB_PASSWORD=""

# [internal] Optional. Postgres database name used with the component settings
# when DATABASE_URL is unset.
# DB_NAME="stella"

# [internal] Optional. TLS mode for component database settings: require,
# verify-ca, or verify-full.
# DB_SSLMODE="require"

# --- External data -----------------------------------------------------
# [secret] Optional. Ingestion user agent.
# INGESTION_USER_AGENT=""

# [internal] Optional. Web search provider.
# WEB_SEARCH_PROVIDER=""

# [secret] Optional. Tavily api key.
# TAVILY_API_KEY=""

# [internal] Optional. Web fetch provider.
# WEB_FETCH_PROVIDER=""

# [secret] Optional. Jina api key.
# JINA_API_KEY=""

# [secret] Optional. Identifying SEC EDGAR contact string. Unset disables the
# adapter because the SEC requires one.
# EDGAR_USER_AGENT="stella admin@example.com"

# [secret] Optional. UK Companies House API key. Unset disables the adapter.
# COMPANIES_HOUSE_API_KEY=""

# [secret] Optional. Inegi denue api token.
# INEGI_DENUE_API_TOKEN=""

# --- Document processing -----------------------------------------------
# [internal] Optional with a default. Interval for releasing queued OCR
# requests, in minutes.
DOCUMENT_OCR_BATCH_INTERVAL_MINUTES="1440"

# [internal] Optional. Directory holding the local OCR models; populate it
# with `bun run ocr:fetch-models`.
# DOCUMENT_OCR_MODEL_DIR=""

# [internal] Optional. Batch mode: the document-processing worker exits once
# its queue has stayed empty this many minutes. Unset keeps it long-running.
# DOCUMENT_PROCESSING_IDLE_EXIT_MINUTES=""

# [secret] Conditionally required when NODE_ENV is production or staging.
# 64-character hex AES key for extracted file text at rest. Local development
# may omit it.
# CONTENT_ENCRYPTION_KEY=""

# --- Storage and legal search ------------------------------------------
# [internal] Required. S3 or S3-compatible object-storage endpoint.
S3_ENDPOINT="http://localhost:9000"

# [internal] Required. S3 bucket for uploaded files.
S3_BUCKET="stella"

# [internal] Optional with a default. Credential source: "auto", "env",
# "aws-runtime", or "none".
S3_CREDENTIALS_PROVIDER="auto"

# [secret] Conditionally required when S3_CREDENTIALS_PROVIDER is "env". S3
# access-key ID. Required with S3_CREDENTIALS_PROVIDER="env"; otherwise omit
# it with the secret to use the selected provider.
S3_ACCESS_KEY_ID="stella-rustfs-dev"

# [secret] Conditionally required when S3_CREDENTIALS_PROVIDER is "env". S3
# secret access key. Required with S3_CREDENTIALS_PROVIDER="env"; otherwise
# omit it with the access-key ID.
S3_SECRET_ACCESS_KEY="stella-rustfs-dev-secret"

# [internal] Required. S3 region for uploaded files and request signing.
S3_REGION="us-east-1"

# [internal] Optional. IAM role used to issue presigned URLs scoped to an
# organization or workspace prefix.
S3_SCOPED_SIGNING_ROLE_ARN=""

# [internal] Optional with a default. Legal search provider.
# LEGAL_SEARCH_PROVIDER="pg-fts"

# [internal] Optional with a default. Legal search index generation.
# LEGAL_SEARCH_INDEX_GENERATION="case_law_v1"

# [internal] Conditionally required when LEGAL_SEARCH_PROVIDER is corpus-index
# and CORPUS_INDEX_ENDPOINT is unset. Local-development-only search endpoint
# for a shared corpus index. Unset uses CORPUS_INDEX_ENDPOINT; this endpoint
# is never used for index mutations.
# CORPUS_INDEX_SEARCH_ENDPOINT=""

# [internal] Optional. Corpus index endpoint.
# CORPUS_INDEX_ENDPOINT=""

# [internal] Optional. Local-development-only read endpoint for Quickwit 0.9.
# Unset uses CORPUS_INDEX_Q09_ENDPOINT; never used for mutations.
# CORPUS_INDEX_Q09_SEARCH_ENDPOINT=""

# [internal] Conditionally required when CORPUS_INDEXING_ENABLED is true and
# LEGAL_SEARCH_INDEX_GENERATION is case_law_v5. Isolated Quickwit 0.9 mutation
# endpoint. Final generations registered on q09 use this endpoint; it never
# falls back to the legacy cluster.
# CORPUS_INDEX_Q09_ENDPOINT=""

# [internal] Optional. Corpus index s3 bucket.
# CORPUS_INDEX_S3_BUCKET=""

# [internal] Conditionally required when corpus storage is enabled in a
# deployed environment. Legal corpus s3 bucket.
# LEGAL_CORPUS_S3_BUCKET=""

# [internal] Optional. Corpus storage mode.
# CORPUS_STORAGE_MODE=""

# [internal] Optional with a default. Corpus storage enabled.
# CORPUS_STORAGE_ENABLED="false"

# [internal] Optional with a default. Corpus indexing enabled.
# CORPUS_INDEXING_ENABLED="false"

# [internal] Optional with a default. Corpus index batch size.
# CORPUS_INDEX_BATCH_SIZE="50"

# [internal] Optional with a default. Corpus index interval ms.
# CORPUS_INDEX_INTERVAL_MS="15000"

# [internal] Optional with a default. Corpus index read concurrency.
# CORPUS_INDEX_READ_CONCURRENCY="4"

# [internal] Optional. CloudWatch metric name the corpus-index build loop
# samples to pace itself. Unset disables pacing.
# CORPUS_INDEX_BACKPRESSURE_METRIC=""

# [internal] Optional. CloudWatch namespace of the pacing metric.
# CORPUS_INDEX_BACKPRESSURE_NAMESPACE=""

# [internal] Optional. Name=Value[,Name=Value...] dimensions of the pacing
# metric.
# CORPUS_INDEX_BACKPRESSURE_DIMENSIONS=""

# [internal] Optional with a default. Metric value below which the
# corpus-index build loop pauses.
# CORPUS_INDEX_BACKPRESSURE_LOW_WATERMARK="30"

# [internal] Optional with a default. Metric value above which a paused
# corpus-index build resumes.
# CORPUS_INDEX_BACKPRESSURE_HIGH_WATERMARK="50"

# [internal] Optional with a default. Minimum interval between pacing-metric
# samples.
# CORPUS_INDEX_BACKPRESSURE_SAMPLE_INTERVAL_MS="60000"

# --- Observability -----------------------------------------------------
# [internal] Optional. PostHog project key. The placeholder "phc_" disables
# capture for local development.
POSTHOG_KEY="phc_"

# [internal] Optional. Posthog host.
# POSTHOG_HOST="https://eu.i.posthog.com"

# [internal] Optional with a default. Allow PostHog capture from localhost
# when using a real project key.
# POSTHOG_LOCAL_DEBUG="false"

# [internal] Optional with a default. Debug unredacted errors.
# DEBUG_UNREDACTED_ERRORS="false"

# --- AI providers ------------------------------------------------------
# [internal] Optional. Ai provider.
# AI_PROVIDER=""

# [internal] Optional. Ai provider base url.
# AI_PROVIDER_BASE_URL=""

# [secret] Optional. Huggingface api key.
# HUGGINGFACE_API_KEY=""

# [internal] Optional. Huggingface base url.
# HUGGINGFACE_BASE_URL=""

# [internal] Optional. Ai model fast.
# AI_MODEL_FAST=""

# [internal] Optional. Ai model chat.
# AI_MODEL_CHAT=""

# [internal] Optional. Ai model reasoning.
# AI_MODEL_REASONING=""

# [internal] Optional. Ai model pdf.
# AI_MODEL_PDF=""

# [secret] Optional. Google generative ai api key.
GOOGLE_GENERATIVE_AI_API_KEY="key-test"

# [secret] Optional. Openrouter api key.
# OPENROUTER_API_KEY=""

# [secret] Optional. Openai api key.
# OPENAI_API_KEY=""

# [secret] Optional. Azure api key.
# AZURE_API_KEY=""

# [internal] Optional. Azure resource name.
# AZURE_RESOURCE_NAME=""

# [internal] Optional. Azure base url.
# AZURE_BASE_URL=""

# [internal] Optional. Azure api version.
# AZURE_API_VERSION=""

# [secret] Optional. Anthropic api key.
# ANTHROPIC_API_KEY=""

# [secret] Optional. Bedrock api key.
# BEDROCK_API_KEY=""

# [secret] Optional. Mistral api key.
# MISTRAL_API_KEY=""

# [secret] Optional. Google ai api key eu.
# GOOGLE_AI_API_KEY_EU=""

# [secret] Optional. Google ai api key ch.
# GOOGLE_AI_API_KEY_CH=""

# [internal] Optional with a default. Require personal ai key.
# REQUIRE_PERSONAL_AI_KEY="false"

# [internal] Optional with a default. Return canned AI responses in local
# development and tests. Deployed runtimes reject this setting.
USE_MOCK_AI="true"

# [secret] Optional. Openai apps challenge token.
# OPENAI_APPS_CHALLENGE_TOKEN=""

# --- Authentication ----------------------------------------------------
# [secret] Required. HMAC secret used to sign Better Auth sessions. Use at
# least 32 characters; rotation logs everyone out.
BETTER_AUTH_SECRET="your-secret-at-least-32-chars-long"

# [internal] Required. Issuer URL Better Auth uses to mint and verify session
# tokens.
BETTER_AUTH_URL="http://localhost:3001"

# [internal] Optional. Better auth cookie prefix.
# BETTER_AUTH_COOKIE_PREFIX=""

# [secret] Optional. SHA-256 digest of a decoy machine API key. Keep its
# plaintext outside this environment.
# SECURITY_CANARY_API_KEY_SHA256=""

# [internal] Optional with a default. Enable email/password auth for
# self-hosting. Initial signup also requires a bootstrap token.
# SELFHOST_LOCAL_PASSWORD_AUTH="false"

# [secret] Optional. One-time token required for the first local-password
# account.
# SELFHOST_BOOTSTRAP_TOKEN=""

# [internal] Optional. Google OAuth client ID; required when the matching web
# login flag is enabled.
# GOOGLE_AUTH_CLIENT_ID=""

# [secret] Optional. Google OAuth client secret; required when the matching
# web login flag is enabled.
# GOOGLE_AUTH_CLIENT_SECRET=""

# [internal] Optional. Microsoft OAuth client ID; required when the matching
# web login flag is enabled.
# MICROSOFT_AUTH_CLIENT_ID=""

# [secret] Optional. Microsoft OAuth client secret; required when the matching
# web login flag is enabled.
# MICROSOFT_AUTH_CLIENT_SECRET=""

# [internal] Conditionally required when Microsoft OAuth credentials are
# configured. Microsoft OAuth tenant selector accepted by the configured
# application registration.
# MICROSOFT_AUTH_TENANT_ID="00000000-0000-0000-0000-000000000000"

# --- Email and feedback ------------------------------------------------
# [internal] Optional. Transactional email transport: "ses" or "smtp". Leave
# unset when email is not configured.
EMAIL_PROVIDER="smtp"

# [internal] Conditionally required when EMAIL_PROVIDER is ses. AWS region
# used for SES transactional email delivery.
# SES_REGION=""

# [secret] Optional. Ses access key id.
# SES_ACCESS_KEY_ID=""

# [secret] Optional. Ses secret access key.
# SES_SECRET_ACCESS_KEY=""

# [internal] Optional. Ses configuration set.
# SES_CONFIGURATION_SET=""

# [internal] Conditionally required when EMAIL_PROVIDER is smtp. SMTP relay
# hostname.
SMTP_HOST="localhost"

# [internal] Conditionally required when EMAIL_PROVIDER is smtp. SMTP relay
# port.
SMTP_PORT="1025"

# [secret] Optional. SMTP username. Set together with SMTP_PASSWORD, or leave
# both empty for an unauthenticated relay.
SMTP_USERNAME=""

# [secret] Optional. SMTP password. Set together with SMTP_USERNAME, or leave
# both empty for an unauthenticated relay.
SMTP_PASSWORD=""

# [secret] Conditionally required when EMAIL_PROVIDER is ses or smtp. Verified
# sender address used for every transactional email.
TRANSACTIONAL_EMAIL_FROM="noreply@example.com"

# [secret] Optional. Destination for MCP and public-intake feedback email.
# Unset disables local email delivery.
# FEEDBACK_EMAIL_TO="maintainer@example.com"

# [internal] Optional with a default. Endpoint for approved, sanitized
# feedback forwarded through the stella channel.
# FEEDBACK_INTAKE_URL="https://api.stll.app/public/feedback"

# --- URLs --------------------------------------------------------------
# [internal] Required. Web app origin used for absolute transactional-email
# links and trusted redirects.
FRONTEND_URL="http://localhost:3000"

# [internal] Optional. Public API origin for verification links and OAuth
# callbacks. Defaults to BETTER_AUTH_URL.
# PUBLIC_URL="http://localhost:3001"

# [internal] Required. Gotenberg document-conversion URL. A deployed
# environment requires HTTPS, a loopback sidecar, or a private deployment
# network.
GOTENBERG_URL="http://localhost:3003"

# [secret] Required. Username for the Gotenberg sidecar's HTTP basic
# authentication.
GOTENBERG_USERNAME="gotenberg"

# [secret] Required. Password for the Gotenberg sidecar's HTTP basic
# authentication.
GOTENBERG_PASSWORD="gotenberg"

# [internal] Optional. Extension origin.
# EXTENSION_ORIGIN=""

# --- Network -----------------------------------------------------------
# [internal] Optional. Comma-separated CIDRs for proxies directly in front of
# the API. Never trust public client ranges.
# STELLA_TRUSTED_PROXY_CIDRS="10.0.0.0/8"

# [internal] Optional with a default. Client-IP source for signup limits. Use
# "direct" without a proxy and "trusted_proxy" behind configured proxies.
STELLA_SIGNUP_RATE_LIMIT_IP_SOURCE="direct"

# --- Feature flags -----------------------------------------------------
# [internal] Optional with a default. Feature chat.
# FEATURE_CHAT="false"

# [internal] Optional with a default. Feature usage.
# FEATURE_USAGE="false"

# [internal] Optional with a default. Feature knowledge templates.
# FEATURE_KNOWLEDGE_TEMPLATES="false"

# [internal] Optional with a default. Feature case law.
# FEATURE_CASE_LAW="false"

# [internal] Optional with a default. Feature public law.
# FEATURE_PUBLIC_LAW="false"

# [internal] Optional with a default. Feature contacts.
# FEATURE_CONTACTS="false"

# [internal] Optional with a default. Feature calendar.
# FEATURE_CALENDAR="false"

# [internal] Optional with a default. Feature todos.
# FEATURE_TODOS="false"

# [internal] Optional with a default. Feature mcp.
# FEATURE_MCP="false"

# [internal] Optional with a default. Feature desktop editing.
# FEATURE_DESKTOP_EDITING="false"

# [internal] Optional with a default. Feature time billing.
# FEATURE_TIME_BILLING="false"

# [internal] Optional with a default. Enable tenant-scoped AI memory APIs,
# prompt retrieval, tools, and workers.
# FEATURE_AI_MEMORY="false"

# [internal] Optional with a default. Enable first-class legal lists across
# REST, agents, and task UI.
# FEATURE_LEGAL_LISTS="false"

# [internal] Optional with a default. Enable governed work obligations, My
# Work, and task workflow semantics.
# FEATURE_GOVERNED_WORKFLOW="false"

# [internal] Optional with a default. Enable GitHub-sourced public skills in
# the authenticated catalogue.
# FEATURE_PUBLIC_TOOLS="false"

# [internal] Optional with a default. Offer the bundled template-pack
# catalogue. Off until a deployment opts in; its routes do not exist while
# off.
# FEATURE_TEMPLATE_PACKS="false"

# [internal] Optional with a default. Feature web search.
# FEATURE_WEB_SEARCH="false"

# [internal] Optional with a default. Feature sharepoint.
# FEATURE_SHAREPOINT="false"

# [internal] Optional with a default. Feature agent id jag.
# FEATURE_AGENT_ID_JAG="false"

# --- Usage -------------------------------------------------------------
# [secret] Optional. Hosted usage webhook secret.
# HOSTED_USAGE_WEBHOOK_SECRET=""

# [secret] Optional. Hosted usage webhook secret previous.
# HOSTED_USAGE_WEBHOOK_SECRET_PREVIOUS=""

# [secret] Optional. Hosted usage provider api key.
# HOSTED_USAGE_PROVIDER_API_KEY=""

# [internal] Optional. Hosted usage provider base url.
# HOSTED_USAGE_PROVIDER_BASE_URL=""

# [internal] Optional with a default. Hosted usage provider.
# HOSTED_USAGE_PROVIDER="neutral"

# [internal] Optional with a default. Usage enforcement enabled.
# USAGE_ENFORCEMENT_ENABLED="false"

# [internal] Optional with a default. Stella usage policy seeds.
# STELLA_USAGE_POLICY_SEEDS="[]"
