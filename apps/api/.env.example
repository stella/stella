# Generated by `bun run env:generate`; edit the Valibot schemas or env catalog.
# Required entries are active. Optional entries are commented out unless
# stella's local development stack intentionally enables them.

# --- Runtime -----------------------------------------------------------
# [internal] Optional with a default. Enable bounded EU case-law completion.
# Defaults to false.
# CASE_LAW_EU_COMPLETION_ENABLED="false"

# [internal] Optional with a default. Stop EU case-law completion before the
# next publisher or database effect.
# CASE_LAW_EU_COMPLETION_KILL_SWITCH="false"

# [internal] Optional with a default. Completion mode: dry-run by default;
# apply requires durable supervised approval.
# CASE_LAW_EU_COMPLETION_MODE="dry-run"

# [internal] Optional with a default. Maximum completion documents per
# invocation, from 1 to 100. Defaults to 25.
# CASE_LAW_EU_COMPLETION_MAX_ROWS="25"

# [internal] Optional with a default. Enable bounded background case-law
# replay. Defaults to false.
# CASE_LAW_REPLAY_ENABLED="false"

# [internal] Optional with a default. Stop background case-law replay at the
# next batch boundary. Defaults to false.
# CASE_LAW_REPLAY_KILL_SWITCH="false"

# [internal] Optional with a default. Comma-separated adapter keys excluded
# from background case-law replay.
# CASE_LAW_REPLAY_DISABLED_SOURCES=""

# [internal] Optional. Stella version.
# STELLA_VERSION=""

# [internal] Optional. Stella commit sha.
# STELLA_COMMIT_SHA=""

# [internal] Optional. Stella ocr pdf font path.
# STELLA_OCR_PDF_FONT_PATH=""

# [internal] Optional. Stella yara rules dir.
# STELLA_YARA_RULES_DIR=""

# [secret] Optional. Sanctions eu xml url.
# SANCTIONS_EU_XML_URL=""

# [secret] Optional. Local-development-only read-only Postgres URL for the
# shared public-law corpus. Unset uses DATABASE_URL.
# PUBLIC_LAW_DATABASE_URL=""

# [internal] Optional with a default. Maximum connections in the optional
# local read-only public-law pool.
# PUBLIC_LAW_DATABASE_POOL_MAX="2"

# [internal] Optional. Public corpus concurrent-work reservation when using
# the root pool. Unset reserves max(1, floor(DATABASE_ROOT_POOL_MAX / 4));
# values are capped at the root pool size. A dedicated PUBLIC_LAW_DATABASE_URL
# uses its own pool limits.
# PUBLIC_CORPUS_RESERVED_CONNECTIONS=""

# [internal] Optional with a default. Public corpus assumed replicas.
# PUBLIC_CORPUS_ASSUMED_REPLICAS="2"

# [internal] Optional with a default. Public corpus search p95 seconds.
# PUBLIC_CORPUS_SEARCH_P95_SECONDS="1"

# [internal] Optional with a default. Public corpus aggregate p95 seconds.
# PUBLIC_CORPUS_AGGREGATE_P95_SECONDS="2"

# [internal] Optional with a default. Public corpus sitemap p95 seconds.
# PUBLIC_CORPUS_SITEMAP_P95_SECONDS="30"

# [internal] Optional with a default. Statute and case-law full-text search
# requests per minute shared by one client address, capped at half the search
# global budget.
# PUBLIC_CORPUS_SEARCH_ADDRESS_MAX="30"

# [internal] Optional. Public corpus search global max.
# PUBLIC_CORPUS_SEARCH_GLOBAL_MAX=""

# [internal] Optional. Public corpus aggregate global max.
# PUBLIC_CORPUS_AGGREGATE_GLOBAL_MAX=""

# [internal] Optional. Public corpus sitemap global max.
# PUBLIC_CORPUS_SITEMAP_GLOBAL_MAX=""

# [secret] Optional. Logs otlp url.
# LOGS_OTLP_URL=""

# [secret] Optional. Logs otlp token.
# LOGS_OTLP_TOKEN=""

# [internal] Optional with a default. Query guidance in the search_case_law
# tool: "off" keeps today's description, "v1" explains how phrasings are
# matched and how the limit is shared, names apex courts per admitted country,
# and warns when a long phrasing fills fewer slots than it was given.
# MCP_CASE_LAW_SEARCH_GUIDANCE="off"

# [internal] Optional with a default. Morphological expansion of case-law
# search terms: "off" builds today's query, "shadow" runs the unexpanded query
# and records leaf counts comparing it with the expanded one (never the query
# text). "on" runs the expanded query; a search cursor names the dictionary
# its page used, so a continuation built against another one is rejected as
# invalid.
# QUERY_EXPANSION_MODE="off"

# [secret] Conditionally required when the API server or the
# document-processing worker runs. Valkey or Redis URL used for cross-instance
# broadcasts and rate limits. Set maxmemory-policy noeviction on the server
# for durable coordination, including queues, locks, reservations, and fences.
# Treated as secret because it may contain credentials.
REDIS_URL="redis://localhost:6379"

# [secret] Optional with a default. Redis connection enforced.
# REDIS_CONNECTION_ENFORCED="false"

# [secret] Optional. Redis username.
# REDIS_USERNAME=""

# [secret] Optional. Redis password.
# REDIS_PASSWORD=""

# [secret] Optional. Redis tls ca pem.
# REDIS_TLS_CA_PEM=""

# [secret] Optional. Redis tls server name.
# REDIS_TLS_SERVER_NAME=""

# [internal] Optional with a default. Whether a rediss:// connection verifies
# the server certificate chain. Leave on unless the endpoint presents a
# certificate no trust anchor can validate and the private network is the
# boundary instead.
# REDIS_TLS_REJECT_UNAUTHORIZED="true"

# [internal] Optional with a default. Maximum queued and running document
# verifications per organization (1–100; default 2).
# LIST_VERIFICATION_ACTIVE_RUNS_MAX="2"

# [internal] Optional with a default. Maximum document verification starts per
# organization per Europe/Prague day (1–1000; default 20).
# LIST_VERIFICATION_DAILY_STARTS_MAX="20"

# [internal] Optional. Port.
# PORT=""

# [internal] Optional. Stella api port.
# STELLA_API_PORT=""

# [secret] Optional. Github token.
# GITHUB_TOKEN=""

# [internal] Optional. Regional catalog refresh interval in milliseconds.
# Required when FEATURE_MANAGED_PROVIDER_CHECKS is enabled; must exceed the
# check timeout.
# MANAGED_PROVIDER_CHECK_INTERVAL_MS=""

# [internal] Optional. Regional catalog check deadline in milliseconds, at
# most 30000. Required when FEATURE_MANAGED_PROVIDER_CHECKS is enabled.
# MANAGED_PROVIDER_CHECK_TIMEOUT_MS=""

# [secret] Optional. Instance decision model key (TypeSafe System One). An
# organization may set its own in AI settings; unset and without one, typed
# decisions fall back to the generative model.
# TYPESAFE_API_KEY=""

# [internal] Optional. System One model id sent to TypeSafe. Defaults to
# "jev-latest"; pin a versioned id to hold calibrated thresholds.
# TYPESAFE_MODEL=""

# [internal] Optional with a default. E2e disable auth rate limit.
# E2E_DISABLE_AUTH_RATE_LIMIT="false"

# [internal] Optional. Local-development-only executable the Dev menu runs to
# reach the corpus that PUBLIC_LAW_DATABASE_URL and
# CORPUS_INDEX_Q09_SEARCH_ENDPOINT name, for example by opening local tunnels.
# Unset disables the action.
# DEV_PUBLIC_LAW_CONNECT_COMMAND=""

# [secret] Optional. Smoke session secret.
# SMOKE_SESSION_SECRET=""

# [secret] Optional. Bearer credential used by the collaboration service for
# snapshot load and store requests.
STELLA_COLLAB_SERVICE_TOKEN="local-collab-service-token-at-least-32-chars"

# [secret] Optional. Deployment-owned bearer credential for operator HTTP
# access. Unset disables access; use at least 32 characters.
OPERATOR_API_TOKEN=""

# [internal] Optional. RFC 3161 timestamp authorities for PDF signing in
# preference order, comma separated; the next one is tried when one fails.
# Unset signs at PAdES B-B.
# PDF_SIGNING_TSA_URLS=""

# [internal] Optional. Single RFC 3161 timestamp authority for PDF signing,
# appended to PDF_SIGNING_TSA_URLS.
# PDF_SIGNING_TSA_URL=""

# [internal] Optional. Trust anchors for PDF signing timestamps: PEM text or a
# path to a PEM file (CA certificates, or an authority's own certificate to
# pin it). Unset embeds timestamps without counting them as trusted time.
# PDF_SIGNING_TSA_TRUST_PEM=""

# [secret] Optional. Demo account email.
# DEMO_ACCOUNT_EMAIL=""

# [secret] Optional. Demo account otp.
# DEMO_ACCOUNT_OTP=""

# [secret] Optional. Demo account organization id.
# DEMO_ACCOUNT_ORGANIZATION_ID=""

# [internal] Optional. Header the edge sets to the viewer address (e.g.
# cloudfront-viewer-address; see STELLA_CLIENT_ADDRESS_FORMAT). Read only from
# STELLA_TRUSTED_PROXY_CIDRS peers; set only when every route to the API adds
# it.
# STELLA_CLIENT_ADDRESS_HEADER="cloudfront-viewer-address"

# [internal] Optional with a default. How STELLA_CLIENT_ADDRESS_HEADER spells
# the address: with-port (default, e.g. cloudfront-viewer-address) or bare.
# STELLA_CLIENT_ADDRESS_FORMAT="with-port"

# [secret] Optional. Comma-separated values the edge sends in
# x-stella-origin-verify (current, then next during a rotation). When set, the
# client address header is read only from requests carrying one of them.
# STELLA_ORIGIN_VERIFY_SECRET=""

# [internal] Optional. Comma-separated user IDs allowed to publish in-app
# announcements. Unset disables the endpoint for everyone.
# STELLA_ANNOUNCEMENT_OPERATOR_USER_IDS=""

# [secret] Optional with a default. Microsoft require verified email claim.
# MICROSOFT_REQUIRE_VERIFIED_EMAIL_CLAIM="false"

# [internal] Optional. Record chat stream chunks for measurement. Defaults on
# in local development/test and off in production.
# CHAT_RUN_LOG_SHADOW=""

# [internal] Optional. Mcp read window ms.
# MCP_READ_WINDOW_MS=""

# [internal] Optional. Mcp read tenant org bytes.
# MCP_READ_TENANT_ORG_BYTES=""

# [internal] Optional. Mcp read tenant user bytes.
# MCP_READ_TENANT_USER_BYTES=""

# [internal] Optional. Mcp read public org bytes.
# MCP_READ_PUBLIC_ORG_BYTES=""

# [internal] Optional. Mcp read public user bytes.
# MCP_READ_PUBLIC_USER_BYTES=""

# [internal] Optional. Mcp read window max entries.
# MCP_READ_WINDOW_MAX_ENTRIES=""

# [public] Optional. Public http(s) contact link shown when an action is
# paused or not enabled.
# ACTION_LIMIT_CONTACT_URL=""

# [secret] Optional. Action cost estimates.
# ACTION_COST_ESTIMATES=""

# [secret] Optional. Action cost call rates.
# ACTION_COST_CALL_RATES=""

# [internal] Optional with a default. Age in days before unused client
# registrations expire (1–365; default 30).
# UNUSED_CLIENT_RETENTION_DAYS="30"

# [internal] Optional with a default. Maximum agent registrations per UTC day
# (1–1000000; default 10000).
# AGENT_REGISTRATION_DAILY_LIMIT="10000"

# [internal] Optional with a default. Maximum open client registrations per
# UTC day (1–1000000; default 10000).
# OPEN_CLIENT_REGISTRATION_DAILY_LIMIT="10000"

# [secret] Optional. Action cost retention days.
# ACTION_COST_RETENTION_DAYS=""

# [internal] Optional. Action request max bytes.
# ACTION_REQUEST_MAX_BYTES=""

# [internal] Optional. Action response max bytes.
# ACTION_RESPONSE_MAX_BYTES=""

# [internal] Optional. Action page size max.
# ACTION_PAGE_SIZE_MAX=""

# [secret] Optional. Payment retry window ms.
# PAYMENT_RETRY_WINDOW_MS=""

# [secret] Optional. Service actions evaluation period actions.
# SERVICE_ACTIONS_EVALUATION_PERIOD_ACTIONS=""

# [secret] Optional. Service actions self managed actions.
# SERVICE_ACTIONS_SELF_MANAGED_ACTIONS=""

# [internal] Optional. Action admission org concurrency.
# ACTION_ADMISSION_ORG_CONCURRENCY=""

# [internal] Optional. Action admission user concurrency.
# ACTION_ADMISSION_USER_CONCURRENCY=""

# [internal] Optional. Action admission background org concurrency.
# ACTION_ADMISSION_BACKGROUND_ORG_CONCURRENCY=""

# [internal] Optional. Action admission background user concurrency.
# ACTION_ADMISSION_BACKGROUND_USER_CONCURRENCY=""

# [internal] Optional. Action admission lease ms.
# ACTION_ADMISSION_LEASE_MS=""

# [secret] Optional. Action admission period ms.
# ACTION_ADMISSION_PERIOD_MS=""

# [secret] Optional. Action admission period actions.
# ACTION_ADMISSION_PERIOD_ACTIONS=""

# [secret] Optional with a default. Operator-owned JSON object keyed by
# registered feature id. Member grants specify type, organizationId, and
# email; organization grants specify type and organizationId. Both require
# current membership and verified email. Unknown feature ids reject startup;
# empty grants hide invitation features.
# API_FEATURE_ACCESS_GRANTS="{}"

# [internal] Conditionally required when FEATURE_ORG_ACCESS_STATE is true.
# Length in days of the evaluation period a new organization starts.
# ORG_EVALUATION_PERIOD_DAYS=""

# [internal] Optional with a default. Enable the shared agent client storage
# format.
# AGENT_CLIENT_STORAGE_V1_ENABLED="false"

# [internal] Optional with a default. Enable explicit agent-mode chat requests
# for this deployment.
# AGENT_SANDBOX_RUNS_ENABLED="false"

# [internal] Optional. Directory holding the template-pack content. Set by the
# container image; unset in a source tree.
# TEMPLATE_PACKS_CONTENT_DIR=""

# [internal] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Container image used for isolated agent runs.
# AGENT_SANDBOX_IMAGE=""

# [internal] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Model identifier used by the isolated agent harness.
# AGENT_SANDBOX_HARNESS_MODEL=""

# [secret] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Model-provider credential delegated only to the isolated agent harness.
# AGENT_SANDBOX_HARNESS_API_KEY=""

# [internal] Optional. OpenAI-compatible endpoint used by the isolated agent
# harness.
# AGENT_SANDBOX_HARNESS_BASE_URL=""

# [internal] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Container-reachable MCP endpoint used by isolated agent runs.
# AGENT_SANDBOX_MCP_URL=""

# [internal] Optional. Docker daemon socket used to create agent sandboxes.
# Defaults to the platform Docker socket.
# AGENT_SANDBOX_DOCKER_SOCKET=""

# [internal] Conditionally required when AGENT_SANDBOX_RUNS_ENABLED is true.
# Locked-down Docker network used by agent sandboxes. It must deny arbitrary
# egress.
# AGENT_SANDBOX_DOCKER_NETWORK=""

# [internal] Optional. Absolute directory of extra report specs (one
# <key>/spec.json per subdirectory). A key here overrides the bundled spec of
# the same name.
# REPORT_SPECS_DIR=""

# [internal] Optional. s3://bucket/prefix/ of extra report specs in the
# REPORT_SPECS_DIR layout, read once at boot. Exclusive with REPORT_SPECS_DIR.
# REPORT_SPECS_S3_PREFIX=""

# --- Database ----------------------------------------------------------
# [internal] Optional. Stella worker dir.
# STELLA_WORKER_DIR=""

# [internal] Optional. Skip migration check.
# SKIP_MIGRATION_CHECK=""

# [secret] Required. Postgres owner URL used by Drizzle. Requests downgrade to
# the stella role so row-level security applies.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/stella"

# [internal] Conditionally required when the database is RDS and
# DB_LOAD_GATE_EBS_SIGNAL is unset. RDS instance whose EBS balances gate heavy
# maintenance and online index builds. Region and credentials use the AWS SDK
# provider chain. A set identifier enables EBS reads and takes precedence over
# DB_LOAD_GATE_EBS_SIGNAL. Missing or failed metrics defer maintenance.
# DB_LOAD_GATE_RDS_INSTANCE_IDENTIFIER=""

# [internal] Conditionally required when DB_LOAD_GATE_RDS_INSTANCE_IDENTIFIER
# is unset. Non-RDS, self-hosted and local databases must set
# `DB_LOAD_GATE_EBS_SIGNAL=disabled` to explicitly disable the EBS signal. The
# logged not_configured signal allows other health gates to govern
# maintenance. If neither setting is supplied, migrate fails before
# connecting, and background maintenance holds with an error event naming the
# missing configuration.
DB_LOAD_GATE_EBS_SIGNAL="disabled"

# [internal] Optional with a default. Maximum root pool size. Keep its sum
# with DATABASE_RLS_POOL_MAX, plus one connection for the periodic login check
# outside local development, within the process connection budget.
DATABASE_ROOT_POOL_MAX="5"

# [internal] Optional with a default. Maximum RLS pool size. Keep its sum with
# DATABASE_ROOT_POOL_MAX, plus one connection for the periodic login check
# outside local development, within the process connection budget.
DATABASE_RLS_POOL_MAX="5"

# [internal] Optional with a default. Maximum database connection lifetime in
# seconds; zero disables retirement.
# DATABASE_POOL_MAX_LIFETIME_S="0"

# [internal] Optional with a default. Idle database connection lifetime in
# seconds; zero disables retirement.
# DATABASE_POOL_IDLE_TIMEOUT_S="0"

# [internal] Optional with a default. Statement timeout in milliseconds set on
# each root and RLS pool connection; zero keeps the server default.
# DATABASE_STATEMENT_TIMEOUT_MS="0"

# [internal] Optional. Postgres hostname used with the component settings when
# DATABASE_URL is unset.
# DB_HOST="localhost"

# [internal] Optional. Postgres port used with the component settings when
# DATABASE_URL is unset.
# DB_PORT="5432"

# [internal] Optional. Postgres user used with the component settings when
# DATABASE_URL is unset.
# DB_USER="postgres"

# [secret] Optional. Postgres password used with the component settings when
# DATABASE_URL is unset.
# DB_PASSWORD=""

# [internal] Optional. Postgres database name used with the component settings
# when DATABASE_URL is unset.
# DB_NAME="stella"

# [internal] Optional. TLS mode for component database settings: require,
# verify-ca, or verify-full.
# DB_SSLMODE="require"

# [internal] Optional with a default. EBS balance percentage required to start
# an online index build.
# DB_LOAD_GATE_START_FLOOR="70"

# [internal] Optional with a default. EBS balance percentage below which a
# running online index build is cancelled and retried later.
# DB_LOAD_GATE_HARD_FLOOR="40"

# [internal] Optional with a default. Maximum age of a health reading before
# it counts as unknown and holds the build.
# DB_LOAD_GATE_MAX_STALENESS_MS="900000"

# [internal] Optional with a default. Timeout for each health probe, including
# the online index observer's connection and statements.
# DB_LOAD_GATE_READ_TIMEOUT_MS="5000"

# [internal] Optional with a default. How long an online index build may stay
# held before a held-too-long event is logged.
# DB_LOAD_GATE_MAX_HELD_MS="21600000"

# [internal] Optional with a default. Oldest open transaction age that still
# allows an online index build to start.
# DB_LOAD_GATE_LONG_TX_MAX_AGE_MS="300000"

# [internal] Optional with a default. JSON array of local busy windows, such
# as `[{"start":"06:30","end":"08:00","timeZone":"Europe/Prague"}]`, during
# which online index builds wait. `[]` disables them.
DB_LOAD_GATE_BUSY_WINDOWS="[]"

# [internal] Optional with a default. Interval between health checks while an
# online index build runs.
# ONLINE_INDEX_POLL_MS="30000"

# [internal] Optional with a default. client_connection_check_interval for the
# index build session, so a lost migrator stops its build.
# ONLINE_INDEX_CLIENT_CHECK_MS="1000"

# [internal] Optional with a default. Delay before the migrator retries a
# deferred online index build.
# ONLINE_INDEX_RETRY_MS="30000"

# [internal] Optional with a default. Maximum time an online index build may
# stay in one waiting phase, such as waiting for older transactions, before it
# is cancelled and retried.
# ONLINE_INDEX_MAX_SNAPSHOT_WAIT_MS="600000"

# [internal] Optional with a default. max_parallel_maintenance_workers for
# online index builds (0 or 1).
# ONLINE_INDEX_PARALLEL_WORKERS="1"

# [internal] Optional with a default. maintenance_work_mem, in megabytes, for
# online index builds.
# ONLINE_INDEX_MAINTENANCE_WORK_MEM_MB="64"

# --- External data -----------------------------------------------------
# [secret] Optional. User-Agent sent to court publishers. Defaults to a stella
# product identifier with the build version and a contact URL; set it so a
# fork does not identify as the upstream project. Browser-like values are
# refused by publishers that gate bots.
# INGESTION_USER_AGENT="acme-ingestion/1.0 (+https://example.com/contact)"

# [internal] Optional. Web search provider.
# WEB_SEARCH_PROVIDER=""

# [secret] Optional. Tavily api key.
# TAVILY_API_KEY=""

# [internal] Optional. Web fetch provider.
# WEB_FETCH_PROVIDER=""

# [secret] Optional. Jina api key.
# JINA_API_KEY=""

# [secret] Optional. Identifying SEC EDGAR contact string. Unset disables the
# adapter because the SEC requires one.
# EDGAR_USER_AGENT="stella admin@example.com"

# [secret] Optional. UK Companies House API key. Unset disables the adapter.
# COMPANIES_HOUSE_API_KEY=""

# [secret] Optional. Inegi denue api token.
# INEGI_DENUE_API_TOKEN=""

# --- Document processing -----------------------------------------------
# [internal] Optional with a default. Interval for releasing queued OCR
# requests, in minutes.
DOCUMENT_OCR_BATCH_INTERVAL_MINUTES="1440"

# [internal] Optional. Directory holding the local OCR models; populate it
# with `bun run ocr:fetch-models`.
# DOCUMENT_OCR_MODEL_DIR=""

# [internal] Optional. Batch mode: the document-processing worker exits once
# its queue has stayed empty this many minutes. Unset keeps it long-running.
# DOCUMENT_PROCESSING_IDLE_EXIT_MINUTES=""

# [secret] Conditionally required when the process runs without local
# development access. 64-character hex AES key for extracted file text at
# rest. Local development may omit it.
# CONTENT_ENCRYPTION_KEY=""

# --- Storage and legal search ------------------------------------------
# [internal] Required. S3 or S3-compatible object-storage endpoint.
S3_ENDPOINT="http://localhost:9000"

# [internal] Required. S3 bucket for uploaded files.
S3_BUCKET="stella"

# [internal] Optional with a default. Credential source: "auto", "env",
# "aws-runtime", or "none".
S3_CREDENTIALS_PROVIDER="auto"

# [secret] Conditionally required when S3_CREDENTIALS_PROVIDER is "env". S3
# access-key ID. Required with S3_CREDENTIALS_PROVIDER="env"; otherwise omit
# it with the secret to use the selected provider.
S3_ACCESS_KEY_ID="stella-rustfs-dev"

# [secret] Conditionally required when S3_CREDENTIALS_PROVIDER is "env". S3
# secret access key. Required with S3_CREDENTIALS_PROVIDER="env"; otherwise
# omit it with the access-key ID.
S3_SECRET_ACCESS_KEY="stella-rustfs-dev-secret"

# [internal] Required. S3 region for uploaded files and request signing.
S3_REGION="us-east-1"

# [internal] Optional. IAM role used to issue presigned URLs scoped to an
# organization or workspace prefix.
S3_SCOPED_SIGNING_ROLE_ARN=""

# [internal] Optional with a default. Legal search provider.
# LEGAL_SEARCH_PROVIDER="pg-fts"

# [internal] Optional with a default. Corpus index ranking mode.
# CORPUS_INDEX_RANKING_MODE="off"

# [internal] Optional with a default. Corpus index query variant.
# CORPUS_INDEX_QUERY_VARIANT="off"

# [internal] Optional. Corpus index read endpoint, accepted on a private
# corpus-index-v09 service host and otherwise only in local development. Unset
# uses CORPUS_INDEX_Q09_ENDPOINT; never used for mutations.
# CORPUS_INDEX_Q09_SEARCH_ENDPOINT=""

# [internal] Conditionally required when LEGAL_SEARCH_PROVIDER is corpus-index
# and CORPUS_INDEX_Q09_SEARCH_ENDPOINT is unset. Corpus index mutation
# endpoint.
# CORPUS_INDEX_Q09_ENDPOINT=""

# [internal] Optional. Corpus index s3 bucket.
# CORPUS_INDEX_S3_BUCKET=""

# [internal] Conditionally required when corpus storage is enabled in a
# deployed environment. Legal corpus s3 bucket.
# LEGAL_CORPUS_S3_BUCKET=""

# [internal] Optional. Corpus storage mode.
# CORPUS_STORAGE_MODE=""

# [internal] Optional. Corpus member layout.
# CORPUS_MEMBER_LAYOUT=""

# [internal] Optional with a default. Corpus storage enabled.
# CORPUS_STORAGE_ENABLED="false"

# [internal] Conditionally required when CORPUS_STORAGE_MODE is canonical.
# Corpus projection owner.
# CORPUS_PROJECTION_OWNER=""

# --- Observability -----------------------------------------------------
# [internal] Optional. PostHog project key. The placeholder "phc_" disables
# capture for local development.
POSTHOG_KEY="phc_"

# [internal] Optional. Posthog host.
# POSTHOG_HOST="https://eu.i.posthog.com"

# [internal] Optional with a default. Allow PostHog capture from localhost
# when using a real project key.
# POSTHOG_LOCAL_DEBUG="false"

# [internal] Optional with a default. Debug unredacted errors.
# DEBUG_UNREDACTED_ERRORS="false"

# --- Feature flags -----------------------------------------------------
# [internal] Optional with a default. Enable model-backed inbox producers that
# read processed documents and review runs.
# FEATURE_INBOX_DOCUMENT_SCOUTS="false"

# [internal] Optional with a default. Enforce organization file byte
# reservations at storage writes.
# FEATURE_FILE_USAGE_LIMITS="false"

# [internal] Optional with a default. Check regional model availability before
# managed requests. Requires AI_PROVIDER=openrouter, a static key or complete
# workload-identity configuration, and explicit check interval/timeout
# settings.
# FEATURE_MANAGED_PROVIDER_CHECKS="false"

# [internal] Optional with a default. Feature usage.
# FEATURE_USAGE="false"

# [internal] Optional with a default. Feature public law.
# FEATURE_PUBLIC_LAW="false"

# [internal] Optional with a default. Feature action admission.
# FEATURE_ACTION_ADMISSION="false"

# [internal] Optional with a default. Feature mcp read fence.
# FEATURE_MCP_READ_FENCE="false"

# [secret] Optional with a default. Feature action cost records.
# FEATURE_ACTION_COST_RECORDS="false"

# [internal] Optional with a default. Feature org service budgets.
# FEATURE_ORG_SERVICE_BUDGETS="false"

# [secret] Optional with a default. Feature configured access.
# FEATURE_CONFIGURED_ACCESS="false"

# [internal] Optional with a default. Feature time billing.
# FEATURE_TIME_BILLING="false"

# [internal] Optional with a default. Enable tenant-scoped AI memory APIs,
# prompt retrieval, tools, and workers.
# FEATURE_AI_MEMORY="false"

# [internal] Optional with a default. Enable first-class legal lists across
# REST, agents, and task UI.
# FEATURE_LEGAL_LISTS="false"

# [internal] Optional with a default. Enable governed work obligations and
# task workflow semantics.
# FEATURE_GOVERNED_WORKFLOW="false"

# [internal] Optional with a default. Enable GitHub-sourced public skills in
# the authenticated catalogue.
# FEATURE_PUBLIC_TOOLS="false"

# [internal] Optional with a default. Offer the bundled template-pack
# catalogue. Off until a deployment opts in; its routes do not exist while
# off.
# FEATURE_TEMPLATE_PACKS="false"

# [internal] Optional with a default. Enable unauthenticated read-only
# endpoints for opted-in bundled knowledge content. Off by default.
# FEATURE_PUBLIC_KNOWLEDGE="false"

# [internal] Optional with a default. Feature web search.
# FEATURE_WEB_SEARCH="false"

# [internal] Optional with a default. Feature sharepoint.
# FEATURE_SHAREPOINT="false"

# [internal] Optional with a default. Feature agent id jag.
# FEATURE_AGENT_ID_JAG="false"

# [internal] Optional with a default. Enforce the per-organization access
# state before a model call falls back to the instance provider.
# FEATURE_ORG_ACCESS_STATE="false"

# --- AI providers ------------------------------------------------------
# [internal] Optional. Ai provider.
# AI_PROVIDER=""

# [internal] Optional. Ai provider base url.
# AI_PROVIDER_BASE_URL=""

# [secret] Optional. Huggingface api key.
# HUGGINGFACE_API_KEY=""

# [internal] Optional. Huggingface base url.
# HUGGINGFACE_BASE_URL=""

# [internal] Optional. Ai model fast.
# AI_MODEL_FAST=""

# [internal] Optional. Ai model chat.
# AI_MODEL_CHAT=""

# [internal] Optional. Ai model reasoning.
# AI_MODEL_REASONING=""

# [internal] Optional. Ai model pdf.
# AI_MODEL_PDF=""

# [secret] Optional. Google generative ai api key.
GOOGLE_GENERATIVE_AI_API_KEY="key-test"

# [secret] Optional. Openrouter api key.
# OPENROUTER_API_KEY=""

# [internal] Optional. Workload-identity federation policy. Configure with
# audience and regional STS endpoint; a static key takes precedence.
# OPENROUTER_WIF_POLICY_ID=""

# [internal] Optional. Audience for the workload-identity token. Required with
# the federation policy and STS region.
# OPENROUTER_WIF_AUDIENCE=""

# [internal] Optional. AWS region for workload-identity token minting.
# Required with the federation policy and audience.
# OPENROUTER_WIF_STS_REGION=""

# [secret] Optional. Openai api key.
# OPENAI_API_KEY=""

# [secret] Optional. Azure api key.
# AZURE_API_KEY=""

# [internal] Optional. Azure resource name.
# AZURE_RESOURCE_NAME=""

# [internal] Optional. Azure base url.
# AZURE_BASE_URL=""

# [internal] Optional. Azure api version.
# AZURE_API_VERSION=""

# [secret] Optional. Anthropic api key.
# ANTHROPIC_API_KEY=""

# [secret] Optional. Bedrock api key.
# BEDROCK_API_KEY=""

# [secret] Optional. Mistral api key.
# MISTRAL_API_KEY=""

# [secret] Optional. Google ai api key eu.
# GOOGLE_AI_API_KEY_EU=""

# [secret] Optional. Google ai api key ch.
# GOOGLE_AI_API_KEY_CH=""

# [internal] Optional with a default. Require personal ai key.
# REQUIRE_PERSONAL_AI_KEY="false"

# [internal] Optional with a default. Return canned AI responses in local
# development and tests. An organization's own AI key still answers for real;
# "force" mocks those requests too. Deployed runtimes reject this setting.
USE_MOCK_AI="true"

# [secret] Optional. Openai apps challenge token.
# OPENAI_APPS_CHALLENGE_TOKEN=""

# --- Authentication ----------------------------------------------------
# [secret] Required. HMAC secret used to sign Better Auth sessions. Use at
# least 32 characters; rotation logs everyone out.
BETTER_AUTH_SECRET="your-secret-at-least-32-chars-long"

# [internal] Required. Issuer URL Better Auth uses to mint and verify session
# tokens.
BETTER_AUTH_URL="http://localhost:3001"

# [internal] Optional. Better auth cookie prefix.
# BETTER_AUTH_COOKIE_PREFIX=""

# [internal] Optional with a default. Rotate browser session credentials on
# refresh. Defaults off; enable after every API instance supports prior
# credentials.
# SESSION_TOKEN_ROTATION_ENABLED="false"

# [internal] Optional with a default. Apply the ninety-day session cap at
# startup after one idle hour. Defaults off; enable after activity tracking is
# established.
# SESSION_LIFETIME_CAP_ENABLED="false"

# [secret] Optional. SHA-256 digest of a decoy machine API key. Keep its
# plaintext outside this environment.
# SECURITY_CANARY_API_KEY_SHA256=""

# [internal] Optional with a default. Enable email/password auth for
# self-hosting. Initial signup also requires a bootstrap token.
# SELFHOST_LOCAL_PASSWORD_AUTH="false"

# [secret] Optional. One-time token required for the first local-password
# account.
# SELFHOST_BOOTSTRAP_TOKEN=""

# [internal] Optional. Google OAuth client ID; required when the matching web
# login flag is enabled.
# GOOGLE_AUTH_CLIENT_ID=""

# [secret] Optional. Google OAuth client secret; required when the matching
# web login flag is enabled.
# GOOGLE_AUTH_CLIENT_SECRET=""

# [internal] Optional. Microsoft OAuth client ID; required when the matching
# web login flag is enabled.
# MICROSOFT_AUTH_CLIENT_ID=""

# [secret] Optional. Microsoft OAuth client secret; required when the matching
# web login flag is enabled.
# MICROSOFT_AUTH_CLIENT_SECRET=""

# [internal] Conditionally required when Microsoft OAuth credentials are
# configured. Microsoft OAuth tenant selector accepted by the configured
# application registration.
# MICROSOFT_AUTH_TENANT_ID="00000000-0000-0000-0000-000000000000"

# --- Email and feedback ------------------------------------------------
# [internal] Optional. Transactional email transport: "ses" or "smtp". Leave
# unset when email is not configured.
EMAIL_PROVIDER="smtp"

# [internal] Conditionally required when an INBOUND_MAIL_* transport key is
# set. Dedicated catch-all domain for matter inbound addresses. Unset disables
# address creation.
# INBOUND_MAIL_DOMAIN="inbound.example.com"

# [internal] Conditionally required when another INBOUND_MAIL_* transport key
# is set. SQS queue subscribed to the SES receipt topic. Set with the other
# INBOUND_MAIL_* transport keys to file inbound mail; unset disables
# receiving.
# INBOUND_MAIL_QUEUE_URL="https://sqs.eu-west-1.amazonaws.com/123456789012/inbound-mail"

# [internal] Conditionally required when another INBOUND_MAIL_* transport key
# is set. SNS topic the SES receipt rule publishes to. Queue messages from any
# other topic are left for the dead-letter queue.
# INBOUND_MAIL_TOPIC_ARN="arn:aws:sns:eu-west-1:123456789012:inbound-mail"

# [internal] Conditionally required when another INBOUND_MAIL_* transport key
# is set. S3 bucket the SES receipt rule stores raw messages in, in S3_REGION.
# INBOUND_MAIL_BUCKET="inbound-mail"

# [internal] Conditionally required when another INBOUND_MAIL_* transport key
# is set. Object key prefix of the SES receipt rule's S3 action, for example
# mail/.
# INBOUND_MAIL_KEY_PREFIX="mail/"

# [internal] Conditionally required when EMAIL_PROVIDER is ses. AWS region
# used for SES transactional email delivery.
# SES_REGION=""

# [secret] Optional. Ses access key id.
# SES_ACCESS_KEY_ID=""

# [secret] Optional. Ses secret access key.
# SES_SECRET_ACCESS_KEY=""

# [internal] Optional. Ses configuration set.
# SES_CONFIGURATION_SET=""

# [internal] Conditionally required when EMAIL_PROVIDER is smtp. SMTP relay
# hostname.
SMTP_HOST="localhost"

# [internal] Conditionally required when EMAIL_PROVIDER is smtp. SMTP relay
# port.
SMTP_PORT="1025"

# [secret] Optional. SMTP username. Set together with SMTP_PASSWORD, or leave
# both empty for an unauthenticated relay.
SMTP_USERNAME=""

# [secret] Optional. SMTP password. Set together with SMTP_USERNAME, or leave
# both empty for an unauthenticated relay.
SMTP_PASSWORD=""

# [secret] Conditionally required when EMAIL_PROVIDER is ses or smtp. Verified
# sender address used for every transactional email.
TRANSACTIONAL_EMAIL_FROM="noreply@example.com"

# [secret] Optional. Destination for maintainer feedback email. Unset disables
# email delivery.
# FEEDBACK_EMAIL_TO="maintainer@example.com"

# [secret] Optional. Token used to file feedback issues in
# FEEDBACK_GITHUB_REPO. Needs issue-write scope only; unset disables GitHub
# delivery.
# FEEDBACK_GITHUB_TOKEN=""

# [secret] Optional. owner/repo that filed feedback is posted to as an issue.
# Requires FEEDBACK_GITHUB_TOKEN; unset disables GitHub delivery.
# FEEDBACK_GITHUB_REPO="owner/repo"

# --- URLs --------------------------------------------------------------
# [internal] Required. Web app origin used for absolute transactional-email
# links, document verification links, and trusted redirects.
FRONTEND_URL="http://localhost:3000"

# [internal] Optional. Public API origin for OAuth callbacks. Defaults to
# BETTER_AUTH_URL.
# PUBLIC_URL="http://localhost:3001"

# [internal] Required. Gotenberg document-conversion URL. A deployed
# environment requires HTTPS, a loopback sidecar, or a private deployment
# network.
GOTENBERG_URL="http://localhost:3003"

# [secret] Required. Username for the Gotenberg sidecar's HTTP basic
# authentication.
GOTENBERG_USERNAME="gotenberg"

# [secret] Required. Password for the Gotenberg sidecar's HTTP basic
# authentication.
GOTENBERG_PASSWORD="gotenberg"

# [internal] Optional. Extension origin.
# EXTENSION_ORIGIN=""

# --- Network -----------------------------------------------------------
# [internal] Optional. Comma-separated CIDRs for proxies directly in front of
# the API. Never trust public client ranges.
# STELLA_TRUSTED_PROXY_CIDRS="10.0.0.0/8"

# [internal] Optional with a default. Client-IP source for signup limits. Use
# "direct" without a proxy and "trusted_proxy" behind configured proxies.
STELLA_SIGNUP_RATE_LIMIT_IP_SOURCE="direct"

# --- Usage -------------------------------------------------------------
# [secret] Optional. Retention in days for completed provider event details;
# unset disables redaction.
# HOSTED_USAGE_WEBHOOK_RETENTION_DAYS=""

# [secret] Optional. Hosted usage webhook secret.
# HOSTED_USAGE_WEBHOOK_SECRET=""

# [secret] Optional. Hosted usage webhook secret previous.
# HOSTED_USAGE_WEBHOOK_SECRET_PREVIOUS=""

# [internal] Optional with a default. Hosted usage provider api version.
# HOSTED_USAGE_PROVIDER_API_VERSION="2026-04"

# [secret] Optional. Hosted usage provider api key.
# HOSTED_USAGE_PROVIDER_API_KEY=""

# [internal] Optional. Hosted usage provider base url.
# HOSTED_USAGE_PROVIDER_BASE_URL=""

# [internal] Optional with a default. Hosted usage provider.
# HOSTED_USAGE_PROVIDER="neutral"

# [internal] Optional with a default. Usage enforcement enabled.
# USAGE_ENFORCEMENT_ENABLED="false"

# [internal] Optional with a default. Stella usage policy seeds.
# STELLA_USAGE_POLICY_SEEDS="[]"
