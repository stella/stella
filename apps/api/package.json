    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:*",
    "@types/nodemailer": "^8.0.1",
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "expect-type": "^1.4.0",
    "fast-check": "catalog:"
  },
  "ciGateTestRunners": {
    "test:postgres": {
      "gate": "STELLA_RUN_POSTGRES_TESTS",
      "gateValue": "true",
      "runner": "scripts/run-postgres-tests.ts",
      "testFileGlob": "src/**/*.test.{ts,tsx}"
    }
  },
  "crawlPosture": "unserved"
