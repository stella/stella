{
  "name": "@stll/api",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "module": "src/server.ts",
  "imports": {
    "#quickjs-release-asyncify.wasm": "@jitl/quickjs-wasmfile-release-asyncify/wasm"
  },
  "exports": {
    "./eden-contract": "./src/eden-contract.ts"
  },
  "scripts": {
    "build": "bun run build:mcp-apps",
    "build:mcp-apps": "bun scripts/build-mcp-apps.ts",
    "build:analyze": "bun build --target bun --outdir .cache/server-build --entry-naming=server.js --metafile-md=.cache/server-metafile.md src/server.ts",
    "test": "bun scripts/run-tests.ts",
    "test:postgres": "bun scripts/run-postgres-tests.ts",
    "test:property": "bun scripts/run-tests.ts --property --preload @stll/property-testing/preload",
    "dev": "bun run docker:dev && NODE_ENV=development bun --port 3001 --preload ./src/dev/register-mock-ai.ts --watch src/server.ts",
    "docker:dev": "docker compose --profile dev up -d",
    "docker:reset-dev": "docker compose --profile dev down -v && docker compose --profile dev up -d",
    "docker:stop-dev": "docker compose --profile dev down",
    "clean": "git clean -xdf .cache .turbo node_modules",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit && bun ../../packages/scripts/src/tsc-native.ts --noEmit -p tsconfig.contracts.json && bun ../../packages/scripts/src/tsc-native.ts --noEmit -p tsconfig.scripts.json && bun ../../packages/scripts/src/tsc-native.ts --noEmit -p tsconfig.mcp-apps.json",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware apps/api",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix apps/api",
    "format": "bun ../../scripts/run-oxfmt.ts .",
    "ocr:fetch-models": "bun src/scripts/fetch-ocr-models.ts",
    "canary:ai-provider": "bun --env-file=.env.example scripts/ai-provider-canary.ts",
    "canary:mcp": "bun --env-file=.env.example src/scripts/mcp-canary.ts",
    "bench:chat-read-surface": "NODE_ENV=development bun scripts/benchmark-chat-read-surface.ts",
    "eval:create-document": "NODE_ENV=development bun --env-file=.env evals/create-document-drafting.ts",
    "eval:suggest-changes": "NODE_ENV=development bun --env-file=.env evals/suggest-changes-precision.ts",
    "eval:template-fill": "NODE_ENV=development bun --env-file=.env evals/template-fill.ts",
    "eval:template-authoring": "NODE_ENV=development bun --env-file=.env evals/template-authoring.ts",
    "eval:extraction": "NODE_ENV=development bun --env-file=.env evals/extraction.ts",
    "eval:agent-orientation": "NODE_ENV=development bun --env-file=.env evals/agent-orientation.ts",
    "db:migrate": "bun run --env-file=.env src/db/migrate.ts",
    "db:audit-better-auth": "bun run --env-file=.env src/scripts/better-auth-migration-audit.ts",
    "db:derive-better-auth-microsoft-identities": "bun run --env-file=.env src/scripts/better-auth-microsoft-identity-map.ts",
    "db:backfill-better-auth-17": "bun run --env-file=.env src/scripts/better-auth-17-backfill.ts",
    "db:push": "bun run db:migrate && bun run --env-file=.env drizzle-kit push",
    "db:seed-test-user": "bun scripts/seed-test-user.ts",
    "db:seed-dev": "bun scripts/seed-dev.ts",
    "db:seed-email-demo": "bun scripts/seed-email-viewer-demo.ts",
    "db:seed-firm-knowledge": "bun scripts/seed-firm-knowledge.ts",
    "db:seed-matter-activity": "bun scripts/seed-matter-activity.ts",
    "db:seed-case-law": "bun scripts/seed-case-law.ts",
    "db:seed-templates": "bun scripts/seed-templates.ts",
    "db:backfill-chat-search": "bun scripts/backfill-chat-search.ts",
    "db:backfill-search-previews": "bun scripts/backfill-search-previews.ts",
    "db:backfill-decision-identifiers": "bun run --env-file=.env src/scripts/backfill-decision-identifiers.ts --apply",
    "db:verify-decision-identifiers": "bun run --env-file=.env src/scripts/backfill-decision-identifiers.ts --verify",
    "document-processing-worker": "bun src/scripts/document-processing-worker.ts",
    "dev:errors": "tail -F .dev-logs/errors.jsonl"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1124.0",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/client-sesv2": "^3.1124.0",
    "@aws-sdk/client-sts": "^3.1124.0",
