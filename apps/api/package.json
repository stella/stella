  "ciGateTestRunners": {
    "test:corpus": {
      "gate": "STELLA_RUN_CORPUS_ENGINE_TESTS",
      "gateValue": "true",
      "runner": "scripts/run-corpus-engine-suites.ts",
      "testFileGlob": "src/**/*.test.ts"
    },
    "test:postgres": {
      "gate": "STELLA_RUN_POSTGRES_TESTS",
      "gateValue": "true",
      "runner": "scripts/run-postgres-tests.ts",
      "testFileGlob": "{src,evals,scripts}/**/*.test.{ts,tsx}"
    },
    "test:valkey": {
      "gate": "STELLA_RUN_VALKEY_TESTS",
      "gateValue": "true",
      "runner": "scripts/run-valkey-tests.ts",
      "testFileGlob": "src/**/*.test.{ts,tsx}"
    },
    "test:perf": {
      "gate": "STELLA_RUN_QUERY_PERF_TESTS",
      "gateValue": "true",
      "runner": "scripts/run-perf-tests.ts",
      "testFileGlob": "src/tests/query-perf/**/*.test.ts"
    }
