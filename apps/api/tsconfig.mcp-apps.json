{
  "extends": "@stll/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": { "@/api/*": ["./src/*"] },
    "target": "ES2024",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.mcp-apps.json"
  },
  "include": ["src/mcp/apps/**/*.ts", "src/mcp/apps/**/*.tsx", "../../types"]
}
