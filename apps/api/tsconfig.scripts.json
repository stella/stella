{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "disableSourceOfProjectReferenceRedirect": true,
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.scripts.json"
  },
  // API imports resolve to declaration output; shared ambient asset declarations
  // remain rooted in this program.
  "include": ["scripts", "evals", "../../types"],
  "exclude": [],
  "references": [{ "path": "./tsconfig.declarations.json" }]
}
