# Generated by `bun run env:generate`; edit the Valibot schemas or env catalog.
# Required entries are active. Optional entries are commented out unless
# stella's local development stack intentionally enables them.

# --- Runtime -----------------------------------------------------------
# [internal] Required. API origin used by collaboration to validate room
# tokens and persist Yjs snapshots.
STELLA_API_URL="http://localhost:3001"

# [internal] Optional with a default. Collaboration topology: "redis" for
# cross-replica broadcast or "single-process" for local development only.
# STELLA_COLLAB_MODE="single-process"

# [internal] Optional with a default. Port for the Hocuspocus collaboration
# server.
# STELLA_COLLAB_PORT="3002"

# [secret] Optional. Redis URL used for cross-replica Yjs and awareness
# broadcast. Treated as secret because it may contain credentials.
# STELLA_COLLAB_REDIS_URL="redis://localhost:6379"

# [secret] Required. Bearer credential used by the collaboration service for
# snapshot load and store requests.
STELLA_COLLAB_SERVICE_TOKEN="local-collab-service-token-at-least-32-chars"
