{
  "name": "@stll/collab",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "bun build --target=bun --packages=external --outfile dist/index.js src/index.ts",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "bun ../../packages/scripts/src/tsc-native.ts --noEmit",
    "lint": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware apps/collab",
    "lint:fix": "cd ../.. && bun --bun oxlint -c oxlint.config.ts --type-aware --fix apps/collab",
    "format": "oxfmt .",
    "test": "bun test"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@stll/api-contract": "workspace:*",
    "@stll/errors": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "better-result": "catalog:",
    "crossws": "^0.4.12",
    "ioredis": "~6.0.0",
    "valibot": "catalog:",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.6.0",
    "@stll/typescript-config": "workspace:*",
    "bun-types": "catalog:"
  },
  "crawlPosture": "unserved"
}
