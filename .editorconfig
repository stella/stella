root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# Captured fixtures hold the bytes a source served, verbatim. Trimming
# trailing whitespace or inserting a final newline rewrites the input the
# parser suite is tested against — that is how a dropped-whitespace bug
# hides behind a green suite — and breaks the sha256 in the fixture's
# .provenance.json sidecar. Sidecars themselves are ordinary generated
# JSON and keep the defaults.
[**/__fixtures__/**]
trim_trailing_whitespace = false
insert_final_newline = false

[**/__fixtures__/**.provenance.json]
trim_trailing_whitespace = true
insert_final_newline = true
