{
  "name": "stella",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "changeset:version": "bun scripts/sync-lockfile-workspace-versions.ts --check-entries && changeset version && bun scripts/sync-lockfile-workspace-versions.ts && bun --cwd packages/cli codegen:version",
    "dev": "bun --no-orphans packages/scripts/src/dev-runner.ts dev",
    "dev:all": "turbo dev",
    "dev:api": "bun --no-orphans packages/scripts/src/dev-runner.ts dev:api",
    "dev:collab": "bun --cwd apps/collab dev",
    "dev:desktop": "bun --no-orphans packages/scripts/src/dev-runner.ts dev:desktop",
    "dev:web": "bun --no-orphans packages/scripts/src/dev-runner.ts dev:web",
    "typegen": "turbo run typegen",
    "typecheck": "turbo run typecheck",
    "typecheck:repo": "bun packages/scripts/src/tsc-native.ts --noEmit -p tsconfig.scripts.json && bun packages/scripts/src/tsc-native.ts --noEmit -p tsconfig.tooling.json && bun packages/scripts/src/tsc-native.ts --noEmit -p tsconfig.oxlint-plugins.json",
    "code-check": "bun run env:check && bun run assets:check && bun scripts/check-oxlint-plugin-registry.ts && bash scripts/lint-oxlint-fixtures.sh && bash scripts/lint-root-scripts.sh && bun --cwd apps/landing typecheck && bun apps/landing/scripts/check-logical-properties.ts && bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware --type-check apps packages && bun run typecheck:repo",
    "code-check:affected": "bun scripts/code-check-affected.ts",
    "secrets:check:staged": "bash scripts/check-staged-secrets.sh",
    "dependencies:dedupe": "bun --no-env-file dedupe",
    "dependencies:dedupe:check": "bun --no-env-file dedupe --check",
    "dependencies:diff": "bun --no-env-file scripts/dependency-diff.ts",
    "dependencies:licenses": "bun --no-env-file pm licenses --prod --json",
    "dependencies:trusted:check": "bun --no-env-file scripts/check-trusted-dependencies.ts",
    "security:audit": "bun scripts/dependency-audit.ts --check",
    "security:audit:fix:preview": "bun --no-env-file audit fix --dry-run",
    "security:audit:report": "bun scripts/dependency-audit.ts",
    "security:audit:write-baseline": "bun scripts/dependency-audit.ts --write-baseline",
    "env:generate": "bun --no-env-file scripts/env-tool.ts generate",
    "env:check": "bun --no-env-file scripts/env-tool.ts check",
    "env:audit": "bun --no-env-file scripts/env-tool.ts audit",
    "env:doctor": "bun --no-env-file scripts/env-tool.ts doctor",
    "selfhost:generate": "bun --no-env-file scripts/selfhost-tool.ts generate",
    "selfhost:check": "bun --no-env-file scripts/selfhost-tool.ts check",
    "selfhost:doctor": "bun --no-env-file scripts/selfhost-tool.ts doctor",
    "policies:check": "bun test scripts/check-policy-evidence.test.ts && bun scripts/check-policy-evidence.ts",
    "marketing:check": "bun scripts/product-media.ts check && bun scripts/check-marketing-content.ts",
    "marketing:media:check": "bun scripts/product-media.ts check",
    "marketing:media:manifest": "bun scripts/product-media.ts write-manifest",
    "marketing:media:publish": "bun scripts/product-media.ts publish",
    "marketing:media:sync": "bun scripts/product-media.ts sync",
    "marketing:stale": "bun scripts/check-marketing-recordings.ts",
    "marketing:verify-current": "bun scripts/verify-marketing-recordings.ts",
    "marketing:reshoot": "bun scripts/marketing-reshoot.ts",
    "release:maintenance": "bun scripts/prepare-maintenance-release.ts",
    "sync-ai": "bash .ai/shared/scripts/sync-ai-skills.sh .",
    "sync-ai:check": "bash .ai/shared/scripts/sync-ai-skills.sh --check .",
    "link-codex": "bash scripts/link-codex-skills.sh",
    "format": "bun run format:guard && turbo run format",
    "format:check": "bun run format:guard && turbo run format -- --check",
    "format:guard": "bun scripts/check-format-environment.ts",
    "lint": "bun run assets:check && bash scripts/lint-oxlint-fixtures.sh && turbo run lint",
    "lint:changed": "bun scripts/lint-changed.ts",
    "lint:fix": "turbo run lint:fix",
    "lint:profile:web": "bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware --debug timings --format=default apps/web",
    "assets:check": "bun test scripts/check-duplicate-raster-assets.test.ts && bun scripts/check-duplicate-raster-assets.ts",
    "lint:ws": "sherif -r unsync-similar-dependencies -i '@babel/core@^7.29.0' && bun packages/scripts/src/workspace-hygiene.ts",
    "new-package": "bun scripts/new-package.ts",
    "i18n:check": "turbo run i18n:check --",
    "i18n:sync": "turbo run i18n:sync --",
    "check:model-catalog": "bun packages/scripts/src/model-catalog-upstream.ts && bun packages/scripts/src/model-catalog-capabilities-gen.ts --check",
    "canary:ai-provider": "bun --cwd apps/api canary:ai-provider",
    "canary:mcp": "bun --filter @stll/api canary:mcp",
    "check:auth-md-spec": "bun packages/scripts/src/auth-md-spec-drift.ts",
    "check:resolutions": "bun scripts/check-resolution-ranges.ts",
    "check:dead-columns": "bun scripts/check-dead-columns.ts",
    "check:projection-totality": "bun scripts/check-projection-totality.ts",
    "check:result-boundary-enrolment": "bun scripts/check-result-boundary-enrolment.ts",
    "check:knip-exports": "bun scripts/knip-exports-ratchet.ts --check",
    "check:module-ownership": "bun scripts/ownership.ts --check",
    "check:published-package-lists": "bun scripts/check-published-package-lists.ts --check",
    "check:result-consumption": "bun packages/scripts/src/result-consumption.ts",
    "check:docs-sources": "bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings .claude/mcp/doc-sources.ts",
    "check:railway-template-draft": "bun scripts/check-railway-template-draft.ts",
    "check:railway-template": "bun scripts/check-railway-template-shape.ts",
    "check:railway-template-source-runtime": "bun scripts/sync-railway-template-source.ts --check-rendered-credentials",
    "sync:railway-template-source": "bun scripts/sync-railway-template-source.ts",
    "generate:snowball-stemmers": "bun scripts/generate-snowball-stemmers.ts",
    "test": "turbo run test",
    "test:property": "turbo run test:property",
    "verify": "bash scripts/verify.sh",
    "db:push": "bun --filter @stll/api db:push",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "sync:well-known": "cp -r .well-known apps/web/public/",
    "setup:dev": "bun run dev",
    "setup:dev:api": "bun run dev:api",
    "setup:dev:desktop": "bun run dev:desktop",
    "setup:dev:web": "bun run dev:web",
    "setup:mcp": "bun install --cwd .claude/mcp",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "hooks:install": "lefthook install",
    "knip": "knip-bun",
    "hooks:uninstall": "lefthook uninstall",
    "postinstall": "bun run lint:ws"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@oxlint/plugins": "catalog:",
    "@stll/calculations": "workspace:*",
    "@stll/money": "workspace:*",
    "@stll/oxlint-config": "0.7.0",
    "@stll/property-testing": "workspace:*",
    "@stll/typescript-config": "workspace:^0.0.0",
    "@stll/ui": "workspace:*",
    "@stll/workspace-model": "workspace:*",
    "@stll/workspace-ui": "workspace:*",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "better-result": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-drizzle": "catalog:",
    "fast-check": "catalog:",
    "i18n-unused": "^0.20.0",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "oxc-transform-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "1.10.2",
    "oxlint-tsgolint": "7.0.2001",
    "react": "catalog:react19",
    "scslre": "0.3.0",
    "sherif": "catalog:",
    "squawk-cli": "2.63.0",
    "tailwindcss": "catalog:",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:"
  },
  "resolutions": {
    "@atlaskit/pragmatic-drag-and-drop": "3.1.0",
    "@emnapi/core": "1.9.1",
    "@emnapi/runtime": "1.9.1",
    "@expo/cli": "57.0.21",
    "@expo/router-server": "57.0.9",
    "@expo/ui": "57.0.15",
    "@stll/folio-core": "0.33.0",
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
