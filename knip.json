{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    // Include present and future workspace packages; exact entries below
    // retain the entry points their frameworks cannot infer.
    "apps/*": {},
    "packages/*": {},
    ".": {
      // Include compiler-only ambient types from the tooling/test projects.
      "typescript": { "config": ["tsconfig*.json", "package.json"] },
      "entry": ["scripts/*.ts", "oxlint.config.ts", "oxlint.design.config.ts"],
      "ignoreDependencies": [
        // tsc-native.ts constructs this compiler binary path dynamically.
        "tsrs",
        // Git hooks load packages/scripts/src/syntax-tree.ts, which imports it;
        // hook-dependencies.test.ts requires the root to declare it.
        "oxc-parser",
        "@tanstack/eslint-plugin-query",
        "@tanstack/eslint-plugin-router",
        "eslint",
        "oxlint-tsgolint",
        "oxlint",
        "squawk-cli"
      ],
      "ignoreBinaries": ["scripts/dev.sh"]
    },
    "apps/desktop": {
      "typescript": { "config": ["tsconfig*.json"] }
    },
    "apps/mobile": {
      "typescript": { "config": ["tsconfig*.json"] },
      // Metro requires Babel; the doctor script constructs its executable path.
      "ignoreDependencies": ["@babel/core", "expo-doctor"]
    },
    "packages/ai-catalog": {
      // Compile-time provider capability assertions consume the adapter types.
      "entry": ["src/**/*.type-test.ts"]
    },
    "packages/agent-input": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/analytics-config": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/cli": {
      "entry": ["src/**/*.test.ts"]
    },
    "apps/api": {
      "entry": [
        "src/server.ts!",
        // Generated entrypoints and shards remain visible after hydration.
        "src/mcp/generated/**/*.ts!",
        // Read by scripts/generate-web-api-types.ts through the compiler.
        "src/web-contract.ts",
        // Callable receiver boundary for authenticated mail transport hosts.
        "src/lib/email/inbound/runtime.ts",
        "src/lib/files/pdf-worker.ts!",
        "src/lib/files/office-evidence-worker.ts!",
        "src/lib/search/extraction-worker.ts!",
        "src/lib/ocr-local/ocr-local-worker.ts!",
        "src/lib/ocr-searchable-pdf-worker.ts!",
        // Spike renderer process and its memory watchdog thread, started by
        // path from the session.
        "src/handlers/invoices/pdf/typst/worker.ts",
        "src/handlers/invoices/pdf/typst/watchdog.ts",
        "scripts/*.ts",
        // Compiler contract tests are checked by the API typecheck script.
        "contracts/**/*.ts",
        "src/**/*.type-test.ts",
        "src/scripts/*.ts",
        "src/dev/register-mock-ai.ts",
        "src/lib/__fixtures__/*.ts",
        "src/handlers/case-law/seed-court-weights.ts",
        "src/handlers/case-law/ingestion/adapters/health-check.ts",
        "src/tests/case-law/update-adapter-fixtures.ts",
        "src/tests/load/*.ts",
        // Passed to Bun by the API test command builder.
        "src/tests/publisher-gate-preload.ts",
        "drizzle.config.ts",
        "src/**/*.test.ts",
        "scripts/**/*.test.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/client.tsx",
        "src/server.ts!",
        "src/runtime.ts!",
        "vite.config.ts",
        // Derived and gitignored: the TanStack Router plugin skips gitignored
        // files, but configured entries are globbed without .gitignore.
        "src/routeTree.gen.ts!",
        "src/route-templates.gen.ts!",
        // The generated route tree is ignored; this route owns billing dialogs
        // loaded by the router and must remain in Knip's usage graph.
        "src/routes/_protected.workspaces/$workspaceId/timesheets.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "e2e/**/*.spec.ts",
        "e2e/**/*.ts"
      ],
      "ignore": ["public/prepaint-init.js", "src/routeTree.gen.ts"],
      // tailwindcss: imported by the app's Tailwind entry and consumed by
      // @tailwindcss/vite at build time, never at runtime, so the production
      // gate must not read the CSS import as a runtime dependency (the same
      // shape as apps/landing's @tailwindcss/postcss). lucide-react: source
      // imports it through @stll/ui/icons; the app keeps the dependency so
      // vite's `resolve.dedupe` and icon chunking resolve one copy.
      "ignoreDependencies": [
        // The gitignored API contract imports schema interfaces by name to
        // preserve ClientTool generic identity; CI checks that generated output.
        "@standard-schema/spec",
        // Dynamically imported from the inline bootstrap in index.html.
        "react-grab",
        "lucide-react",
        "tailwindcss"
      ]
    },
    // WXT discovers the service worker, content script and popup from
    // src/entrypoints; knip cannot infer that, so they are listed as entries.
    "apps/extension": {
      "entry": [
        "src/entrypoints/**/*.ts",
        "scripts/*.ts",
        "e2e/**/*.ts",
        "src/**/*.test.ts"
      ]
    },
    "apps/landing": {
      "entry": [
        "src/**/*.astro",
        "src/content.config.ts",
        "src/pages/**/*.ts",
        "astro.config.*",
        "e2e/**/*.ts"
      ],
      "ignoreDependencies": [
        // Tailwind scans workspace-ui through the CSS @source directive.
        "@tailwindcss/postcss",
        "@stll/workspace-ui",
        // Folio requires host-owned peers loaded by its editor implementation.
        "prosemirror-commands",
        "prosemirror-dropcursor",
        "prosemirror-gapcursor",
        "prosemirror-inputrules",
        "prosemirror-keymap",
        "prosemirror-transform",
        "y-prosemirror",
        "y-protocols"
      ]
    },
    "apps/playground": {
      // Folio requires host-owned peers loaded by its editor implementation.
      "ignoreDependencies": [
        "prosemirror-commands",
        "prosemirror-dropcursor",
        "prosemirror-gapcursor",
        "prosemirror-inputrules",
        "prosemirror-keymap",
        "prosemirror-transform",
        "y-prosemirror",
        "y-protocols"
      ]
    },
    "apps/legal-atlas-runner": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "ignoreDependencies": ["@stll/api"]
    },
    "packages/clipboard": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/collation": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/concurrency": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/db-load-gate": {
      "entry": [
        "src/health.ts",
        "src/indicators.ts",
        "src/heavy-work-slot.ts",
        "src/**/*.test.ts"
      ]
    },
    "packages/decision-reader": {
      "entry": ["src/**/*.test.{ts,tsx}"]
    },
    "packages/external-contracts": {
      "entry": ["src/registry.ts", "src/guard.ts", "src/**/*.test.ts"]
    },
    "packages/legal-atlas": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/legal-ast": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/mcp-apps": {
      "entry": [
        "src/*/app.tsx",
        "src/**/*.{test,spec}.{ts,tsx}",
        "scripts/**/*.ts"
      ]
    },
    "packages/mcp-kit": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/mojibake": {
      "entry": [
        "src/charsets.ts",
        "src/declared-charset.ts",
        "src/detect.ts",
        "src/**/*.test.ts",
        "scripts/*.ts"
      ]
    },
    "packages/permissions": {
      "entry": ["src/index.ts"]
    },
    "packages/portable-path": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/playwright-tools": {
      "entry": ["src/marketing-config.ts"]
    },
    "packages/redis-config": {
      "entry": ["src/connection.ts", "src/**/*.test.ts"]
    },
    "packages/runtime-mode": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/sanctions": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "scripts/evaluate.ts"]
    },
    "packages/scan-engine": {
      "entry": ["src/scan-engine.ts", "src/**/*.test.ts"],
      "ignore": ["generated/**"]
    },
    "packages/scripts": {
      // The Postgres lifecycle owner is invoked by scripts/configure-test-postgres.sh.
      "entry": [
        "src/i18n-check.ts",
        "src/i18n-typegen.ts",
        "src/dev-postgres.ts",
        // Test fixture processes are spawned by path from the tests.
        "src/test-fixtures/*.ts"
      ]
    },
    // The three `exports` entry points are derived from package.json, so
    // listing them here only earns a redundancy hint. These are the entries
    // knip cannot infer: the manifest generators run from package scripts, and
    // tests count as usage.
    "packages/skills": {
      "entry": ["scripts/*.ts", "src/**/*.test.ts"]
    },
    "packages/stable-stringify": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/template-conditions": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/typescript-config": {
      "entry": ["*.json", "**/*.test.ts"]
    },
    "packages/transactional": {
      "entry": ["emails/*.tsx"],
      "ignoreDependencies": ["react-dom", "@react-email/preview-server"]
    },
    "packages/ui": {
      // Browser fixture CSS imports Tailwind; the Vite plugin consumes its peer.
      "ignoreDependencies": ["tailwindcss"],
      "entry": [
        "src/index.ts",
        "src/components/*.tsx",
        "src/hooks/*.ts",
        "src/inspector/*.{ts,tsx}",
        "src/lib/*.ts",
        "src/styles/theme.css",
        "tsdown.config.ts"
      ]
    },
    "packages/user-agent": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/uuid-codec": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "apps/visual-preview": {
      "entry": ["src/handler.ts", "src/**/*.test.ts", "browser/**/*.test.ts"]
    }
  },
  "ignore": [".oxlint-plugins/**", ".claude/**"],
  "ignoreIssues": {
    "packages/infosoud/src/constants.ts": ["duplicates"]
  },
  "exclude": ["exports", "types"],
  "ignoreBinaries": ["docker", "tsc", "bun", "tail", "fmt"],
  "ignoreDependencies": [
    "@stll/typescript-config",
    // Declared ahead of the text-search engine migration so its PRs share one
    // dependency set. Each migration PR imports these in its workspace; the
    // last one removes these entries (knip then flags any unused declaration).
    "@stll/aho-corasick",
    "@stll/aho-corasick-wasm",
    "@stll/fuzzy-search",
    "@stll/regex-set",
    "@stll/regex-set-wasm"
  ]
}
