{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/anonymize/wasm": {
      "ignoreDependencies": ["@stll/anonymize-data"]
    },
    "packages/corpus": {
      "entry": ["src/run.ts"]
    }
  },
  "rules": {
    "files": "off",
    "dependencies": "error",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "unlisted": "error",
    "unresolved": "error"
  }
}
